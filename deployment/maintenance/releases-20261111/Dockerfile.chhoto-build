FROM utilibre-chhoto-dependencies:7.11.3-candidate AS build
WORKDIR /candidate
ENV CARGO_BUILD_JOBS=2
RUN cargo auditable test --offline --locked --release tests::access && cargo auditable test --offline --locked --release tests::insertion::adding_link && cargo auditable test --offline --locked --release tests::insertion::link_editing && cargo auditable build --offline --locked --release
FROM scratch
COPY --from=build /candidate/target/release/chhoto-url /app/chhoto-url
COPY frontend /app/frontend/base
WORKDIR /app
USER 65534:65534
ENTRYPOINT ["/app/chhoto-url"]
