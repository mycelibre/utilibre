# Retain CairoSVG repair, Python dependencies, app/privacy patches and user.
FROM utilibre-liberaforms:4.11.1-cairosvg-security-20261011
USER root
RUN apt-get -qq update \
 && apt-get -qqy --no-install-recommends --only-upgrade install \
      libpcre2-8-0=10.46-1~deb13u3 \
 && apt-get clean \
 && rm -rf /var/lib/apt/lists/* \
 && python -m pip check
USER 4002:4002
