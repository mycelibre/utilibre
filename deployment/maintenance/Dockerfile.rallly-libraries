FROM node:24.21.0-alpine3.24@sha256:ebfe2f90462722a7a4de65e91990e97fe0d401c70e0e762c5b53302f905ec1c1 AS dependencies
WORKDIR /reviewed
COPY rallly-libraries/package*.json ./
RUN npm ci --ignore-scripts --omit=dev --no-audit --no-fund
FROM utilibre-rallly:debian-security-20261011
USER root
COPY --from=dependencies /reviewed /opt/utilibre-reviewed-libraries
RUN node -e 'const fs=require("fs"),p="/app/node_modules/.pnpm/fast-xml-parser@5.3.4/node_modules/fast-xml-parser",deps="/opt/utilibre-reviewed-libraries/node_modules";if(JSON.parse(fs.readFileSync(p+"/package.json")).version!=="5.3.4")throw Error("Review changed package");fs.rmSync(p,{recursive:true});fs.cpSync(deps+"/fast-xml-parser",p,{recursive:true});fs.symlinkSync(deps,p+"/node_modules");if(JSON.parse(fs.readFileSync(p+"/package.json")).version!=="5.11.2")throw Error("Patch missing")'
USER nextjs
