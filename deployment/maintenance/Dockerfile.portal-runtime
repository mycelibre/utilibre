# Keep the exact live portal build, independent of unrelated worktree edits.
FROM public-utility-portal:0.1.0-maintenance-20261011 AS artifact
FROM node:24.21.0-alpine3.24@sha256:ebfe2f90462722a7a4de65e91990e97fe0d401c70e0e762c5b53302f905ec1c1
ENV NODE_ENV=production PORT=8080
WORKDIR /app
RUN rm -rf /usr/local/lib/node_modules/npm /usr/local/bin/npm /usr/local/bin/npx
COPY --from=artifact --chown=node:node /app /app
USER node
EXPOSE 8080
CMD ["node", "server/server.mjs"]
