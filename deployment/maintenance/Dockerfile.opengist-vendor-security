USER root
RUN apk add --no-cache \
    libcrypto3=3.5.9-r0 libssl3=3.5.9-r0 \
    libexpat=2.8.5-r0 pcre2=10.49-r0
# Compose already runs this UID; keep the image safe if launched independently.
USER 1000:1000
