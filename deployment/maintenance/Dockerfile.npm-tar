ARG BASE
FROM node:24.21.0-alpine3.24@sha256:ebfe2f90462722a7a4de65e91990e97fe0d401c70e0e762c5b53302f905ec1c1 AS dependencies
WORKDIR /reviewed
COPY npm-tar/package*.json ./
RUN npm ci --ignore-scripts --omit=dev --no-audit --no-fund
FROM ${BASE}
USER root
ARG RUN_USER
COPY --from=dependencies /reviewed/node_modules /opt/utilibre-reviewed-npm
RUN node -e 'const fs=require("fs"),p="/usr/local/lib/node_modules/npm/node_modules/tar",deps="/opt/utilibre-reviewed-npm";if(JSON.parse(fs.readFileSync(p+"/package.json")).version!=="7.5.19")throw Error("Changed npm tar; review required");fs.rmSync(p,{recursive:true});fs.cpSync(deps+"/tar",p,{recursive:true});fs.symlinkSync(deps,p+"/node_modules");if(JSON.parse(fs.readFileSync(p+"/package.json")).version!=="7.5.21")throw Error("Patch missing")' && npm --version
USER ${RUN_USER}
