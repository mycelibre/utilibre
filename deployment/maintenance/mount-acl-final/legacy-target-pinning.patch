+++ source/lib/fileutils.c
@@ -12,11 +12,69 @@
 #include <sys/time.h>
 #include <sys/resource.h>
 #include <string.h>
+#include <sys/syscall.h>
+#include <linux/openat2.h>
 
 #include "c.h"
 #include "all-io.h"
 #include "fileutils.h"
 #include "pathnames.h"
+#include "strutils.h"
+
+/* Upstream restricted-mount helpers, adapted to the Bookworm baseline.
+ * Fail closed without openat2; a last-component-only fallback is unsafe. */
+int ul_open_no_symlinks(const char *path, int flags, mode_t mode)
+{
+#ifdef SYS_openat2
+	struct open_how how = {
+		.flags = (__u64) flags,
+		.mode = (__u64) mode,
+		.resolve = RESOLVE_NO_SYMLINKS,
+	};
+	return syscall(SYS_openat2, AT_FDCWD, path, &how, sizeof(how));
+#else
+	(void) path; (void) flags; (void) mode;
+	errno = ENOSYS;
+	return -1;
+#endif
+}
+
+char *ul_fd_mkpath(char *buf, size_t bufsz, int fd)
+{
+	int len;
+	if (fd < 0) {
+		errno = EBADF;
+		return NULL;
+	}
+	len = snprintf(buf, bufsz, _PATH_PROC_FDDIR "/%d", fd);
+	if (len < 0 || (size_t) len >= bufsz) {
+		errno = ENAMETOOLONG;
+		return NULL;
+	}
+	return buf;
+}
+
+char *ul_fd_get_path(int fd)
+{
+	ssize_t ssz;
+	char buf[PATH_MAX];
+	char fdpath[UL_FDPATH_BUFSIZ];
+	if (!ul_fd_mkpath(fdpath, sizeof(fdpath), fd))
+		return NULL;
+	ssz = readlink(fdpath, buf, sizeof(buf));
+	if (ssz < 0)
+		return NULL;
+	if ((size_t) ssz >= sizeof(buf)) {
+		errno = ENAMETOOLONG;
+		return NULL;
+	}
+	buf[ssz] = '\0';
+	if (*buf != '/' || endswith(buf, " (deleted)")) {
+		errno = ENOENT;
+		return NULL;
+	}
+	return strdup(buf);
+}
 
