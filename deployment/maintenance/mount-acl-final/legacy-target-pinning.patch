+int mnt_context_get_target_fd(struct libmnt_context *cxt)
+{
+	assert(cxt);
+	if (cxt->fd_target < 0) {
+		const char *target = mnt_fs_get_target(cxt->fs);
+		if (!target || !*target) {
+			errno = EINVAL;
+			return -1;
+		}
+		cxt->fd_target = ul_open_no_symlinks(target, O_PATH | O_CLOEXEC, 0);
+	}
+	return cxt->fd_target;
+}
+
+void mnt_context_close_target_fd(struct libmnt_context *cxt)
+{
+	assert(cxt);
+	if (cxt->fd_target >= 0)
+		close(cxt->fd_target);
+	cxt->fd_target = -1;
+}
+
+static int pin_target(struct libmnt_context *cxt)
+{
+	char *path;
+	int rc, fd = mnt_context_get_target_fd(cxt);
+	if (fd < 0)
+		return -errno;
+	path = ul_fd_get_path(fd);
+	if (!path)
+		return -errno;
+	rc = mnt_fs_set_target(cxt->fs, path);
+	free(path);
+	return rc;
+}
