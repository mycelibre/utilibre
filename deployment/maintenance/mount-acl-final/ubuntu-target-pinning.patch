Description: Complete restricted mount target pinning on Noble's vendor fix
 Preserve the 2.39.3 public ABI and Ubuntu fixes; adapt upstream September
 pre-canonicalization and legacy FD handling. Restricted mounts fail closed
 without openat2/procfs; unrestricted root behavior remains unchanged.
Origin: backport, https://github.com/util-linux/util-linux/commit/2c773f336134acf016e639abb6f12ba7341fe4b8
Author: Utilibre maintainers <admin@utilibre.org>
Last-Update: 2026-10-12

--- a/include/fileutils.h
+++ b/include/fileutils.h
@@ -62,6 +62,9 @@
 }
 
 extern int ul_open_no_symlinks(const char *path, int flags, mode_t mode);
+#define UL_FDPATH_BUFSIZ (sizeof("/proc/self/fd/") + sizeof(stringify_value(INT_MAX)))
+extern char *ul_fd_mkpath(char *buf, size_t bufsz, int fd);
+extern char *ul_fd_get_path(int fd);
 
 extern int dup_fd_cloexec(int oldfd, int lowfd);
 extern unsigned int get_fd_tabsize(void);
--- a/lib/fileutils.c
+++ b/lib/fileutils.c
@@ -24,6 +24,7 @@
 #include "all-io.h"
 #include "fileutils.h"
 #include "pathnames.h"
+#include "strutils.h"
 
 int mkstemp_cloexec(char *template)
 {
@@ -327,11 +328,32 @@
 		.mode = (__u64) mode,
 		.resolve = RESOLVE_NO_SYMLINKS,
 	};
-	int fd = syscall(SYS_openat2, AT_FDCWD, path, &how, sizeof(how));
-
-	/* only fall back to O_NOFOLLOW if the syscall is unavailable */
-	if (fd >= 0 || errno != ENOSYS)
-		return fd;
+	return syscall(SYS_openat2, AT_FDCWD, path, &how, sizeof(how));
+#else
+	(void) path; (void) flags; (void) mode;
+	errno = ENOSYS;
+	return -1;
 #endif
-	return open(path, flags | O_NOFOLLOW, mode);
+}
+
+char *ul_fd_mkpath(char *buf, size_t bufsz, int fd)
+{
+	int len;
+	if (fd < 0) { errno = EBADF; return NULL; }
+	len = snprintf(buf, bufsz, _PATH_PROC_FDDIR "/%d", fd);
+	if (len < 0 || (size_t) len >= bufsz) { errno = ENAMETOOLONG; return NULL; }
+	return buf;
+}
+
+char *ul_fd_get_path(int fd)
+{
+	ssize_t len;
+	char buf[PATH_MAX], path[UL_FDPATH_BUFSIZ];
+	if (!ul_fd_mkpath(path, sizeof(path), fd)) return NULL;
+	len = readlink(path, buf, sizeof(buf));
+	if (len < 0) return NULL;
+	if ((size_t) len >= sizeof(buf)) { errno = ENAMETOOLONG; return NULL; }
+	buf[len] = '\0';
+	if (*buf != '/' || endswith(buf, " (deleted)")) { errno = ENOENT; return NULL; }
+	return strdup(buf);
 }
