From b7f1f5742351741c068020196fd88f196551aad2 Mon Sep 17 00:00:00 2001
From: mdb-ad <198671546+mdb-ad@users.noreply.github.com>
Date: Fri, 25 Sep 2026 15:30:26 -0700
Subject: [PATCH] enforce minimum size of 5 in bson_reserve_buffer

---
 src/libbson/doc/bson_reserve_buffer.rst | 4 ++--
 src/libbson/src/bson/bson.c             | 5 +++++
 src/libbson/tests/test-bson.c           | 6 ++++++
 3 files changed, 13 insertions(+), 2 deletions(-)

diff --git a/src/libbson/doc/bson_reserve_buffer.rst b/src/libbson/doc/bson_reserve_buffer.rst
index 16b31c96d10..9fea5be91e4 100644
--- a/src/libbson/doc/bson_reserve_buffer.rst
+++ b/src/libbson/doc/bson_reserve_buffer.rst
@@ -15,7 +15,7 @@ Parameters
 ----------
 
 * ``bson``: An initialized :symbol:`bson_t`.
-* ``total_size``: The length in bytes of the new buffer.
+* ``total_size``: The length in bytes of the new buffer. Must be at least 5 (the size of an empty BSON document).
 
 Description
 -----------
@@ -32,7 +32,7 @@ The ``bson_t`` document length and buffer size limit are both set to ``total_siz
 Returns
 -------
 
-A pointer to the internal buffer, which is at least ``total_size`` bytes, or NULL if the space could not be allocated.
+A pointer to the internal buffer, which is at least ``total_size`` bytes, or NULL if ``total_size`` is less than 5 or the space could not be allocated.
 
 Example
 -------
diff --git a/src/libbson/src/bson/bson.c b/src/libbson/src/bson/bson.c
index fbbca787846..7962652ac80 100644
--- a/src/libbson/src/bson/bson.c
+++ b/src/libbson/src/bson/bson.c
@@ -2174,6 +2174,11 @@ bson_reserve_buffer (bson_t *bson, uint32_t total_size)
       return NULL;
    }
 
+   /* The smallest valid BSON document is 5 bytes. */
+   if (total_size < 5u) {
+      return NULL;
+   }
+
    if (total_size > bson->len) {
       if ((size_t) total_size > BSON_MAX_SIZE) {
          return NULL;
diff --git a/src/libbson/tests/test-bson.c b/src/libbson/tests/test-bson.c
index 466f430a405..29bbd9fe4b2 100644
--- a/src/libbson/tests/test-bson.c
+++ b/src/libbson/tests/test-bson.c
@@ -1595,6 +1595,12 @@ test_bson_reserve_buffer_errors (void)
    uint8_t data[5] = {0};
    uint32_t len_le;
 
+   /* too small: less than the minimum BSON document size */
+   for (uint32_t i = 0u; i < 5u; i++) {
+      ASSERT (!bson_reserve_buffer (&bson, i));
+      ASSERT_CMPUINT32(bson.len, ==, 5u);
+   }
+
    /* too big */
    ASSERT (!bson_reserve_buffer (&bson, (uint32_t) (BSON_MAX_SIZE + 1u)));
    /* exactly the maximum size */
