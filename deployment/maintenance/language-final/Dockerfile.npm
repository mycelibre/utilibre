ARG BASE
FROM node:24.21.0-alpine3.24@sha256:ebfe2f90462722a7a4de65e91990e97fe0d401c70e0e762c5b53302f905ec1c1 AS installer
ADD --checksum=sha256:783e7c92bf73b442fb800c2d6ef3921e86da8894a700fed45140e37916877482 https://registry.npmjs.org/npm/-/npm-11.21.0.tgz /tmp/npm.tgz
RUN mkdir /reviewed-npm && tar -xzf /tmp/npm.tgz -C /reviewed-npm --strip-components=1 \
 && rm -rf /reviewed-npm/node_modules/brace-expansion /reviewed-npm/node_modules/undici
# Same-major leaf artifacts already integrity-pinned and tested in npm-leaves.
# stage.py verifies this source image's exact ID before the build.
FROM utilibre-actual:leaves-security-20261011 AS fixed-leaves
FROM installer AS patched-installer
COPY --from=fixed-leaves /opt/utilibre-reviewed-leaves/node_modules/brace-expansion /reviewed-npm/node_modules/brace-expansion
COPY --from=fixed-leaves /opt/utilibre-reviewed-leaves/node_modules/undici /reviewed-npm/node_modules/undici
FROM ${BASE}
USER root
ARG APPLICATION
ARG MANIFEST=npm-images.json
COPY --from=patched-installer /reviewed-npm /tmp/utilibre-reviewed-npm
COPY ${MANIFEST} /tmp/utilibre-language/npm-images.json
COPY replace-npm.cjs /tmp/utilibre-language/
RUN node /tmp/utilibre-language/replace-npm.cjs "$APPLICATION" \
 && rm /tmp/utilibre-language/npm-images.json /tmp/utilibre-language/replace-npm.cjs \
 && rmdir /tmp/utilibre-language
ARG RUNTIME_USER
USER ${RUNTIME_USER}
