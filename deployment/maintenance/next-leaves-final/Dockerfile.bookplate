FROM utilibre-bookplate:1.1.0-security-20261011-language-20261011
# Frozen image retains all reviewed OS/npm/privacy settings. /app here is the
# immutable build tree only; runtime uploads/database volumes are never mounted.
USER root
RUN rm -rf /app && mkdir /app && chown node:node /app
ADD --chown=node:node app.tar.gz /app/
USER node
