# Existing complete Authentik release and prior Python security repairs retained.
# OS-only target is independently usable if Python native tests fail.
FROM utilibre-authentik:2026.8.3-python-security-20261011 AS os-only
USER root
# OpenSSL is upstream's deliberately held +ak-fips build. Never replace it with
# ordinary Debian libraries or override its holds as part of this wrapper.
RUN apt-get update \
 && apt-get install -y --no-install-recommends --only-upgrade libpcre2-8-0=10.46-1~deb13u3 \
 && rm -rf /var/lib/apt/lists/*
USER 1000:1000

FROM os-only AS urllib3
USER root
RUN /ak-root/.venv/bin/python -c 'import importlib.metadata as m; assert m.version("urllib3")=="2.7.0"' \
 && pip --python /ak-root/.venv/bin/python install --no-deps --no-cache-dir --disable-pip-version-check \
    'https://files.pythonhosted.org/packages/92/9d/c4e665119135114480843e7ab388fa94d8480650450e6f8e26b70d323a4c/urllib3-2.8.0-py3-none-any.whl#sha256=0cf3cae568d36aa9576b28dfb35f11328f1cb974ca7647d9475ebb86c75ac6e3' \
 && pip --python /ak-root/.venv/bin/python check \
 && /ak-root/.venv/bin/python -c 'import urllib3,importlib.metadata as m; assert urllib3.__version__=="2.8.0"; assert str(m.distribution("urllib3").locate_file("urllib3")).startswith("/ak-root/.venv/")'
USER 1000:1000
