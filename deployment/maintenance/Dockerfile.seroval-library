ARG BASE
FROM node:24.21.0-alpine3.24@sha256:ebfe2f90462722a7a4de65e91990e97fe0d401c70e0e762c5b53302f905ec1c1 AS dependencies
WORKDIR /reviewed
COPY seroval-library/package*.json ./
RUN npm ci --ignore-scripts --omit=dev --no-audit --no-fund
FROM ${BASE}
USER root
ARG APP_ROOT
ARG RUN_USER
COPY --from=dependencies /reviewed/node_modules/seroval /opt/utilibre-reviewed-seroval
# Exec-form RUN also works in the upstream shell-less admin-console image.
RUN ["node", "-e", "const fs=require('fs');const root=process.env.APP_ROOT;if(!['/app','/nitrate/apps/admin-console'].includes(root))throw Error('Unreviewed root');const p=root+'/node_modules/.pnpm/seroval@1.5.6/node_modules/seroval';if(JSON.parse(fs.readFileSync(p+'/package.json')).version!=='1.5.6')throw Error('Changed source');if(JSON.parse(fs.readFileSync('/opt/utilibre-reviewed-seroval/package.json')).version!=='1.6.8')throw Error('Changed replacement');fs.rmSync(p,{recursive:true});fs.cpSync('/opt/utilibre-reviewed-seroval',p,{recursive:true})"]
USER ${RUN_USER}
