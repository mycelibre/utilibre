FROM utilibre-kuma:libraries-security-20261011-p4 AS previous
FROM golang:1.26.9-alpine@sha256:3082400e369fa24d5fc60bca20edab3f6d604e0c5a690ec66b295eff4dd87ade AS healthcheck
COPY --from=previous /app/extra/healthcheck.go /source/healthcheck.go
RUN test "$(sha256sum /source/healthcheck.go | cut -d ' ' -f 1)" = d16fd78404ed92d7e8b61f535790f4f508d807d5d76c2d9fbb275e2cd86f3f9e
RUN --mount=type=tmpfs,target=/root/.cache CGO_ENABLED=0 GOMAXPROCS=2 go build -trimpath -o /healthcheck /source/healthcheck.go
FROM node:22.23.2-bookworm-slim@sha256:48e4b67d85f87bd551df43704e24d252f56cc5f8e9718841aace50f19948f0f9 AS node
FROM previous
USER root
COPY --from=healthcheck --chmod=0555 /healthcheck /app/extra/healthcheck
COPY --from=node /usr/local/bin/node /usr/local/bin/node
RUN node -e 'if(process.version!=="v22.23.2")throw Error("Wrong Node runtime");require("/app/node_modules/@louislam/sqlite3")'
RUN node -e 'const fs=require("fs"),p="/usr/local/lib/node_modules/npm/node_modules/tar",deps="/opt/utilibre-reviewed-libraries/node_modules";if(JSON.parse(fs.readFileSync(p+"/package.json")).version!=="7.5.11")throw Error("Changed npm tar");fs.rmSync(p,{recursive:true});fs.cpSync(deps+"/tar",p,{recursive:true});fs.symlinkSync(deps,p+"/node_modules");if(JSON.parse(fs.readFileSync(p+"/package.json")).version!=="7.5.21")throw Error("Missing replacement")' && npm --version
USER 1000:1000
