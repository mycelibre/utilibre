# October 21 finite refresh. Retains the previously repaired nginx/TIFF/zlib base.
ARG BASE=sha256:b374bb83a3bf4dbc64b4ed35013dc4276afbb5c601acce931ac989794548c68b
FROM ${BASE}
ARG RUNTIME_USER=101
USER root
COPY libexpat-2.9.0-r0.apk /tmp/utilibre-libexpat.apk
COPY libx11-1.8.14-r0.apk /tmp/utilibre-libx11.apk
RUN test "$(cat /etc/alpine-release)" = 3.24.2 \
 && nginx -v 2>&1 | grep -Fx 'nginx version: nginx/1.30.5' \
 && echo '32b127f31e0a919110a18a7f0bb3780d8fb66ba4d8d61b2d301d633f0e319d0e  /tmp/utilibre-libexpat.apk' | sha256sum -c - \
 && echo '016efc189c6d566061ffe206ed0780e32686c1a8c832a3917d35d2c66d61a40f  /tmp/utilibre-libx11.apk' | sha256sum -c - \
 && apk add --no-network /tmp/utilibre-libexpat.apk /tmp/utilibre-libx11.apk \
 && apk info --exists libexpat=2.9.0-r0 libx11=1.8.14-r0 \
 && rm /tmp/utilibre-libexpat.apk /tmp/utilibre-libx11.apk
USER ${RUNTIME_USER}
