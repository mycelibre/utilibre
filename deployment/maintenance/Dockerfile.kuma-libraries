FROM node:24.21.0-alpine3.24@sha256:ebfe2f90462722a7a4de65e91990e97fe0d401c70e0e762c5b53302f905ec1c1 AS dependencies
WORKDIR /reviewed
COPY kuma-libraries/package*.json ./
RUN npm ci --ignore-scripts --omit=dev --no-audit --no-fund
FROM utilibre-kuma:proxyaddr-security-20261011
USER root
COPY --from=dependencies /reviewed /opt/utilibre-reviewed-libraries
RUN node -e 'const fs=require("fs"),deps="/opt/utilibre-reviewed-libraries/node_modules";for(const [name,old] of [["tar","6.2.1"],["protobufjs","7.2.6"],["@grpc/grpc-js","1.8.22"]]){const p="/app/node_modules/"+name;if(require(p+"/package.json").version!==old)throw Error("Review changed package "+name);fs.rmSync(p,{recursive:true});fs.cpSync(deps+"/"+name,p,{recursive:true});fs.symlinkSync(deps,p+"/node_modules")}'
USER 1000:1000
