{
    auto_https off
    admin off
    log {
        output discard
    }
}
http://:18080 {
    root * /app/build/static
    @static {
        file
        path *.css *.mjs *.js *.svg *.png *.ico *.woff *.woff2
    }
    handle @static {
        file_server
    }
    handle {
        reverse_proxy localhost:18000
    }
}
