{:mvn/repos
 {"sonatype"
  {:url "https://oss.sonatype.org/content/repositories/snapshots/"}},
 :deps
 {org.clojure/clojure #:mvn{:version "1.12.5"},
  com.zaxxer/HikariCP #:mvn{:version "7.1.0"},
  io.prometheus/simpleclient #:mvn{:version "0.16.0"},
  io.netty/netty-common #:mvn{:version "4.2.17.Final"},
  io.prometheus/simpleclient_jetty
  {:mvn/version "0.16.0",
   :exclusions
   [org.eclipse.jetty/jetty-server org.eclipse.jetty/jetty-servlet]},
  org.clojars.pntblnk/clj-ldap #:mvn{:version "0.0.17"},
  io.lettuce/lettuce-core #:mvn{:version "7.7.0.RELEASE"},
  software.amazon.awssdk/s3 #:mvn{:version "2.54.5"},
  io.netty/netty-codec-http2 #:mvn{:version "4.2.17.Final"},
  io.netty/netty-codec #:mvn{:version "4.2.17.Final"},
  com.github.luben/zstd-jni #:mvn{:version "1.5.7-12"},
  io.netty/netty-transport-classes-epoll
  #:mvn{:version "4.2.17.Final"},
  org.passay/passay #:mvn{:version "2.0.0"},
  io.netty/netty-buffer #:mvn{:version "4.2.17.Final"},
  io.netty/netty-handler #:mvn{:version "4.2.17.Final"},
  org.postgresql/postgresql #:mvn{:version "42.7.13"},
  org.clojure/tools.namespace #:mvn{:version "1.5.1"},
  pretty-spec/pretty-spec #:mvn{:version "0.1.4"},
  markdown-clj/markdown-clj #:mvn{:version "1.12.9"},
  funcool/yetti
  {:git/tag "v11.11",
   :git/sha "e810f87",
   :git/url "https://github.com/funcool/yetti.git",
   :exclusions [org.slf4j/slf4j-api]},
  buddy/buddy-hashers #:mvn{:version "2.0.167"},
  metosin/reitit-core #:mvn{:version "0.10.1"},
  io.netty/netty-codec-base #:mvn{:version "4.2.17.Final"},
  io.whitfin/siphash #:mvn{:version "3.0.0"},
  io.prometheus/simpleclient_hotspot #:mvn{:version "0.16.0"},
  com.google.guava/guava #:mvn{:version "33.7.1-jre"},
  io.micrometer/micrometer-core #:mvn{:version "1.14.2"},
  dawran6/emoji #:mvn{:version "0.2.0"},
  penpot/common #:local{:root "../common"},
  com.github.seancorfield/next.jdbc #:mvn{:version "1.3.1118"},
  io.netty/netty-transport #:mvn{:version "4.2.17.Final"},
  at.yawk.lz4/lz4-java #:mvn{:version "1.11.4"},
  io.netty/netty-transport-native-unix-common
  #:mvn{:version "4.2.17.Final"},
  io.netty/netty-codec-dns #:mvn{:version "4.2.17.Final"},
  io.prometheus/simpleclient_httpserver #:mvn{:version "0.16.0"},
  io.netty/netty-codec-http #:mvn{:version "4.2.17.Final"},
  java-http-clj/java-http-clj #:mvn{:version "0.4.3"},
  org.jsoup/jsoup #:mvn{:version "1.23.2"},
  io.micrometer/micrometer-observation #:mvn{:version "1.14.2"},
  nrepl/nrepl #:mvn{:version "1.7.0"},
  io.netty/netty-resolver #:mvn{:version "4.2.17.Final"},
  org.xerial/sqlite-jdbc #:mvn{:version "3.53.4.0"},
  buddy/buddy-sign #:mvn{:version "3.6.1-359"},
  io.netty/netty-resolver-dns #:mvn{:version "4.2.17.Final"},
  software.amazon.awssdk/sts #:mvn{:version "2.54.5"},
  com.github.ben-manes.caffeine/caffeine #:mvn{:version "3.2.4"}},
 :paths ["src" "resources" "target/classes"],
 :aliases
 {:dev
  {:jvm-opts
   ["--sun-misc-unsafe-memory-access=allow"
    "--enable-native-access=ALL-UNNAMED"],
   :extra-deps
   {com.bhauman/rebel-readline #:mvn{:version "0.1.11"},
    clojure-humanize/clojure-humanize #:mvn{:version "0.2.2"},
    org.clojure/data.csv #:mvn{:version "1.1.1"},
    com.clojure-goes-fast/clj-async-profiler
    #:mvn{:version "2.0.0-beta1"},
    mockery/mockery #:mvn{:version "0.1.4"}},
   :extra-paths ["test" "dev"]},
  :build
  {:extra-deps
   #:io.github.clojure{tools.build #:mvn{:version "0.10.14"}},
   :ns-default build},
  :test
  {:main-opts ["-m" "kaocha.runner"],
   :jvm-opts ["-Dlog4j2.configurationFile=log4j2-devenv-repl.xml"],
   :extra-deps #:lambdaisland{kaocha #:mvn{:version "1.91.1392"}}},
  :outdated
  {:extra-deps #:com.github.liquidz{antq #:mvn{:version "2.11.1276"}},
   :main-opts ["-m" "antq.core"]},
  :jmx-remote
  {:jvm-opts
   ["-Dcom.sun.management.jmxremote"
    "-Dcom.sun.management.jmxremote.port=9000"
    "-Dcom.sun.management.jmxremote.rmi.port=9000"
    "-Dcom.sun.management.jmxremote.local.only=false"
    "-Dcom.sun.management.jmxremote.authenticate=false"
    "-Dcom.sun.management.jmxremote.ssl=false"
    "-Djava.rmi.server.hostname=localhost"]}},
 :mvn/local-repo "/work/m2"}
