[Unit]
Description=Utilibre public page reader with mandatory restricted egress
After=docker.service network-online.target
Requires=docker.service
PartOf=docker.service
StartLimitIntervalSec=120
StartLimitBurst=5
[Service]
Type=simple
WorkingDirectory=/home/ubuntu/freetools/deployment/13ft
ExecStartPre=/home/ubuntu/freetools/deployment/13ft/start-boundary.sh
ExecStart=/usr/bin/docker compose up --no-recreate --abort-on-container-exit
ExecStop=/usr/bin/docker compose stop --timeout 15
Restart=always
RestartSec=10
TimeoutStopSec=30
[Install]
WantedBy=multi-user.target
