diff --git a/src/config/utilibre.test.tsx b/src/config/utilibre.test.tsx
new file mode 100644
index 0000000..49ed71c
--- /dev/null
+++ b/src/config/utilibre.test.tsx
@@ -0,0 +1,38 @@
+import { renderToStaticMarkup } from 'react-dom/server'
+import { Message } from 'components/Message/Message'
+import { Message as ChatMessage } from 'models/chat'
+
+import { detectIncognito } from './fileMemoryStorage'
+import { rtcConfig } from './rtcConfig'
+import { trackerUrls } from './trackerUrls'
+
+it('uses only the instance tracker and Utilibre STUN', () => {
+  expect(trackerUrls).toHaveLength(1)
+  expect(trackerUrls[0]).toContain('/tracker')
+  expect(rtcConfig.iceServers).toEqual([
+    { urls: 'stun:turn.utilibre.org:3478' },
+  ])
+})
+it('selects memory storage without inspecting private browsing state', async () => {
+  expect(await detectIncognito()).toEqual({
+    isPrivate: true,
+    browserName: 'Unused',
+  })
+})
+it('renders remote media as ordinary links, never embeds', () => {
+  for (const text of [
+    '![fictional](https://example.invalid/private.png)',
+    'https://www.youtube.com/watch?v=fictional123',
+  ]) {
+    const markup = renderToStaticMarkup(
+      <Message
+        message={{ text, timeSent: 1, authorId: 'fictional' } as ChatMessage}
+        showAuthor={false}
+        userId="fictional"
+      />
+    )
+
+    expect(markup).not.toMatch(/<(img|iframe)\b/)
+    expect(markup).toContain('href=')
+  }
+})
