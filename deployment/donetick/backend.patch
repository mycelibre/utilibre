@@ -391,3 +392,78 @@ func TestDeleteUserAccount_WithChores(t *testing.T) {
 		t.Errorf("Expected user to be deleted, but found %d users", userCount)
 	}
 }
+
+// Account deletion must explicitly remove refresh sessions even when SQLite's
+// per-connection foreign-key enforcement is off, as in the installed runtime.
+func TestDeleteUserAccount_RefreshSessionsStayWithinDeletedAccount(t *testing.T) {
+	db := setupTestDeletionDB(t)
+	if err := db.Exec("PRAGMA foreign_keys = OFF").Error; err != nil {
+		t.Fatal(err)
+	}
+	now := time.Now().UTC()
+	for _, u := range []uModel.User{
+		{ID: 1, Username: "fictional-delete", DisplayName: "Fictional delete", Email: "delete@example.invalid", Password: "unused", CreatedAt: now, UpdatedAt: now},
+		{ID: 2, Username: "fictional-preserve", DisplayName: "Fictional preserve", Email: "preserve@example.invalid", Password: "unused", CreatedAt: now, UpdatedAt: now},
+	} {
+		if err := db.Create(&u).Error; err != nil {
+			t.Fatal(err)
+		}
+	}
+	sessions := []uModel.UserSession{
+		{ID: "fictional-delete-active", UserID: 1, TokenHash: "fictional-hash-one", FamilyID: "fictional-family-one", CreatedAt: now, ExpiresAt: now.Add(time.Hour)},
+		{ID: "fictional-delete-revoked", UserID: 1, TokenHash: "fictional-hash-two", FamilyID: "fictional-family-two", CreatedAt: now, ExpiresAt: now.Add(time.Hour), RevokedAt: &now},
+		{ID: "fictional-preserve-active", UserID: 2, TokenHash: "fictional-hash-three", FamilyID: "fictional-family-three", CreatedAt: now, ExpiresAt: now.Add(time.Hour)},
+	}
+	for _, session := range sessions {
+		if err := db.Create(&session).Error; err != nil {
+			t.Fatal(err)
+		}
+	}
+	var preservedBefore uModel.UserSession
+	if err := db.First(&preservedBefore, "id = ?", sessions[2].ID).Error; err != nil {
+		t.Fatal(err)
+	}
+	service := NewMockDeletionService(db, &mockStorage{})
+	preview, err := service.CheckUserAccountDeletion(context.Background(), 1)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if preview.DeletedData["user_sessions"] != 2 {
+		t.Errorf("preview should count the two target sessions, got %d", preview.DeletedData["user_sessions"])
+	}
+	var count int64
+	db.Model(&uModel.UserSession{}).Count(&count)
+	if count != 3 {
+		t.Fatalf("preview changed sessions: %d remain", count)
+	}
+	result, err := service.DeleteUserAccount(context.Background(), 1, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !result.Success || result.DeletedData["user_sessions"] != 2 {
+		t.Errorf("deletion should report the two target sessions: %+v", result.DeletedData)
+	}
+	db.Model(&uModel.UserSession{}).Where("user_id = ?", 1).Count(&count)
+	if count != 0 {
+		t.Errorf("deleted account left %d refresh sessions", count)
+	}
+	var preservedAfter uModel.UserSession
+	if err := db.First(&preservedAfter, "id = ?", sessions[2].ID).Error; err != nil {
+		t.Fatal(err)
+	}
+	if !reflect.DeepEqual(preservedBefore, preservedAfter) {
+		t.Error("another account's active session changed")
+	}
+	db.Model(&uModel.User{}).Where("id = ?", 2).Count(&count)
+	if count != 1 {
+		t.Error("another account changed")
+	}
+	rows, err := db.Raw("PRAGMA foreign_key_check").Rows()
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer rows.Close()
+	if rows.Next() {
+		t.Error("account deletion left a foreign-key violation")
+	}
+}
