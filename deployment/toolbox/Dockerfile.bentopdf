# Built by build-bentopdf.mjs + prepare-bentopdf-airgap.mjs, never at request time.
# App-only overlay over the exact reviewed nginx/Expat/TIFF/zlib/musl runtime.
# Keep this predecessor locally for rebuilds and rollback; do not resolve latest.
FROM sha256:2c135f176fb9abd3a0ae4392cf3c9e846d4e3e3d9c49e8ff52e9c2dc22c46ee9
USER root
RUN rm -rf /usr/share/nginx/html && mkdir -p /usr/share/nginx/html
USER 101
COPY . /usr/share/nginx/html
# Inherit the reviewed entrypoint and all other image configuration unchanged.
