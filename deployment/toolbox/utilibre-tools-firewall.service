[Unit]
Description=Restrict Utilibre tool listeners to the separate Caddy edge
Requires=docker.service
After=docker.service network-online.target
PartOf=docker.service

[Service]
Type=oneshot
ExecStart=/bin/sh /home/ubuntu/freetools/deployment/toolbox/firewall.sh
ExecStart=/bin/sh /home/ubuntu/freetools/deployment/community/rssbridge-firewall.sh
ExecStart=/bin/sh /home/ubuntu/freetools/deployment/expanded/wiki-firewall.sh
ExecStart=/bin/sh /home/ubuntu/freetools/deployment/community/priviblur-firewall.sh
ExecStart=/bin/sh /home/ubuntu/freetools/deployment/community/additions-firewall.sh
ExecStart=/bin/sh /home/ubuntu/freetools/deployment/community/pollaris-firewall.sh
RemainAfterExit=yes

[Install]
WantedBy=docker.service
