FROM node:24-alpine@sha256:ebfe2f90462722a7a4de65e91990e97fe0d401c70e0e762c5b53302f905ec1c1 AS build
ARG APP
WORKDIR /app
ENV NODE_OPTIONS=--max-old-space-size=2048
COPY . .
COPY --from=integration prepare-browser-build.mjs /integration/prepare-browser-build.mjs
RUN node /integration/prepare-browser-build.mjs "$APP"
RUN npm ci --ignore-scripts --no-fund && npm run build
RUN node /integration/prepare-browser-build.mjs "$APP" package
FROM nginxinc/nginx-unprivileged:1.30.5-alpine@sha256:15c994d10d6d78658721c3bcafff14cb281fba2a4bdf9d5ba92c416a472516e3
# Reviewed Alpine vendor fixes; preserve the native unprivileged runtime.
USER root
RUN apk add --no-cache --upgrade tiff=4.7.2-r0 zlib=1.3.2-r1
USER 101
COPY --from=build /app/site /usr/share/nginx/html
ENTRYPOINT ["nginx", "-g", "daemon off;"]
