+// Individually credited, checksum-pinned recordings; see sounds/RECORDING-CREDITS.txt.
+import { BsCloudRain, BsCloudLightningRain, BsFire, BsMoonStars } from 'react-icons/bs';
+import { FaWater, FaWind, FaTree, FaTrain, FaCoffee } from 'react-icons/fa';
+import { PiBirdFill } from 'react-icons/pi';
+import type { Category } from '../types';
+import { getAssetPath } from '@/helpers/path';
+
+const audio = (file: string) => getAssetPath(`/sounds/recordings/${file}.ogg`);
+export const weather: Category = {
+  id: 'rain', title: 'Weather', icon: <BsCloudRain />,
+  sounds: [
+    { id: 'rain', label: 'Rain', icon: <BsCloudRain />, src: audio('rain') },
+    { id: 'storm', label: 'Thunderstorm', icon: <BsCloudLightningRain />, src: audio('storm') },
+  ],
+};
+export const outdoors: Category = {
+  id: 'nature', title: 'Nature', icon: <FaTree />,
+  sounds: [
+    { id: 'birds', label: 'Forest Birds', icon: <PiBirdFill />, src: audio('birds') },
