FROM node:24-alpine@sha256:ebfe2f90462722a7a4de65e91990e97fe0d401c70e0e762c5b53302f905ec1c1 AS build
WORKDIR /app
ENV NODE_OPTIONS=--max-old-space-size=3072
COPY . .
COPY --from=integration harden-creative-deps.mjs /integration/harden-creative-deps.mjs
RUN node /integration/harden-creative-deps.mjs excalidraw && yarn --frozen-lockfile --ignore-scripts --network-timeout 600000 && yarn cache clean
COPY --from=integration prepare-creative-build.mjs /integration/prepare-creative-build.mjs
RUN node /integration/prepare-creative-build.mjs excalidraw
RUN yarn build:app:docker
COPY --from=integration excalidraw-LICENSE.txt /app/LICENSE
RUN node /integration/prepare-creative-build.mjs excalidraw package
FROM nginxinc/nginx-unprivileged:1.28-alpine@sha256:7377697a821c131a924a7105fafbe7414db4e9fcc77a6f08f776f33f141ec3f8
COPY --from=build /app/site /usr/share/nginx/html
ENTRYPOINT ["nginx", "-g", "daemon off;"]
