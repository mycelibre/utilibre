FROM docker.io/iib0011/omni-tools:0.6.0@sha256:ceb5acc317daf387634f7f212cefe4722fd1243ad1cba74203f25254195b6c69 AS upstream
FROM node:24-alpine@sha256:ebfe2f90462722a7a4de65e91990e97fe0d401c70e0e762c5b53302f905ec1c1 AS assets
WORKDIR /app
COPY --from=upstream /usr/share/nginx/html /app
COPY prepare-omnitools-assets.mjs /integration/prepare-omnitools-assets.mjs
RUN node /integration/prepare-omnitools-assets.mjs
COPY prepare-omnitools-local.mjs omnitools-runtime-lock.json /integration/
RUN node /integration/prepare-omnitools-local.mjs
COPY prepare-secure-random.mjs secure-random.mjs /integration/
RUN node /integration/prepare-secure-random.mjs omnitools
COPY prepare-omnitools-semantics.mjs /integration/
RUN node /integration/prepare-omnitools-semantics.mjs
FROM nginxinc/nginx-unprivileged:1.30.5-alpine@sha256:15c994d10d6d78658721c3bcafff14cb281fba2a4bdf9d5ba92c416a472516e3
# Reviewed Alpine vendor fixes; preserve the native unprivileged runtime.
USER root
RUN apk add --no-cache --upgrade tiff=4.7.2-r0 zlib=1.3.2-r1
USER 101
COPY --from=assets /app /usr/share/nginx/html
ENTRYPOINT ["nginx", "-g", "daemon off;"]
