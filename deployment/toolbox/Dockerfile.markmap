FROM node:24-alpine@sha256:ebfe2f90462722a7a4de65e91990e97fe0d401c70e0e762c5b53302f905ec1c1 AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts
COPY . .
COPY --from=branding svg/utilibre-logo-coral.svg public/utilibre-logo-coral.svg
COPY --from=branding README.txt public/BRAND-NOTICE.txt
RUN npm run build
FROM nginxinc/nginx-unprivileged:1.30.6-alpine@sha256:f5116ed4606f3eb015dd4a8e28cb9b351476dc0ad4bc6e9f93b19cec130cdf03
# Reviewed Alpine vendor fixes; preserve the native unprivileged runtime.
USER root
RUN apk add --no-cache --upgrade tiff=4.7.2-r0 zlib=1.3.2-r1
USER 101
COPY --from=build /app/dist /usr/share/nginx/html
ENTRYPOINT ["nginx", "-g", "daemon off;"]
