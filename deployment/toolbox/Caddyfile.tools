# Merge these routes into the Caddy VM's existing configuration. Do not replace
# the whole Caddyfile or duplicate existing pdf/convert/tools site blocks.
# Keep the VM's established TLS issuer/certificate policy for these hostnames.
# App-provided CSP/COOP/COEP headers must pass through unchanged (no global CSP
# or require-corp override). Disable Cloudflare Rocket Loader for these sites.

pdf.utilibre.org {
	encode zstd gzip
	# Replace the old edge require-corp header rather than appending to it.
	header >Cross-Origin-Embedder-Policy credentialless
	header >Cross-Origin-Opener-Policy same-origin
	reverse_proxy 10.10.1.43:3101
}
convert.utilibre.org {
	encode zstd gzip
	reverse_proxy 10.10.1.43:3102
}
tools.utilibre.org {
	encode zstd gzip
	reverse_proxy 10.10.1.43:3103
}
dev.utilibre.org {
	encode zstd gzip
	reverse_proxy 10.10.1.43:3109
}
hat.utilibre.org {
	encode zstd gzip
	reverse_proxy 10.10.1.43:3110
}
draw.utilibre.org {
	encode zstd gzip
	reverse_proxy 10.10.1.43:3111
}
qr.utilibre.org {
	encode zstd gzip
	reverse_proxy 10.10.1.43:3112
}

# October 7 additions: reserved backend destinations. Prepared before deployment;
# a configured edge route alone does not mean the application is ready.
zip.utilibre.org {
	encode zstd gzip
	reverse_proxy 10.10.1.43:3160
}
charts.utilibre.org {
	encode zstd gzip
	reverse_proxy 10.10.1.43:3161
}
audio.utilibre.org {
	encode zstd gzip
	reverse_proxy 10.10.1.43:3162
}
paint.utilibre.org {
    encode zstd gzip
    reverse_proxy 10.10.1.43:3163
}

# Browser-tools second batch. Private app ports; public export/privacy checks
# passed on October 7, including Image Scrubber's local security corrections.
whiteboard.utilibre.org {
    encode zstd gzip
    reverse_proxy 10.10.1.43:3164
}

svg.utilibre.org {
    encode zstd gzip
    reverse_proxy 10.10.1.43:3165
}

cyberchef.utilibre.org {
    encode zstd gzip
    reverse_proxy 10.10.1.43:3166
}

scrub.utilibre.org {
    encode zstd gzip
    reverse_proxy 10.10.1.43:3167
}
# Markmap: hardened local editor; do not add Rocket Loader or injected scripts.
mindmap.utilibre.org {
    encode zstd gzip
    reverse_proxy 10.10.1.43:3168
}
