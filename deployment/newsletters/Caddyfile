# Enable only after verified inbound mail routing and trusted SMTP TLS exist.
newsletters.utilibre.org {
    import utilibre_no_transform
    crowdsec
    encode zstd gzip
    reverse_proxy http://10.10.1.43:3210 {
        import utilibre_proxy_headers
        transport http {
            dial_timeout 5s
            response_header_timeout 60s
        }
    }
}
