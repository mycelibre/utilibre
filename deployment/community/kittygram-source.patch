new file mode 100644
index 0000000..d746c75
--- /dev/null
+++ b/deployment/kittygram-gateway.conf
@@ -0,0 +1,58 @@
+worker_processes 1;
+pid /tmp/nginx.pid;
+error_log /dev/null;
+events { worker_connections 128; }
+http {
+  include /etc/nginx/mime.types;
+  access_log off;
+  server_tokens off;
+  client_body_temp_path /tmp/client;
+  proxy_temp_path /tmp/proxy;
+  fastcgi_temp_path /tmp/fastcgi;
+  uwsgi_temp_path /tmp/uwsgi;
+  scgi_temp_path /tmp/scgi;
+  proxy_cache_path /tmp/media-cache levels=1:2 keys_zone=kitty_cache:2m max_size=96m inactive=10m;
+  set_real_ip_from 10.10.1.3;
+  real_ip_header X-Forwarded-For;
+  real_ip_recursive on;
+  limit_req_zone $binary_remote_addr zone=kitty_pages:2m rate=20r/m;
+  limit_req_zone $binary_remote_addr zone=kitty_media:2m rate=8r/s;
+  limit_conn_zone $binary_remote_addr zone=kitty_connections:1m;
+  limit_req_status 429;
+  limit_conn_status 429;
+  server {
+    listen 8080;
+    client_max_body_size 8k;
+    limit_conn kitty_connections 24;
+    if ($request_method !~ ^(GET|HEAD|POST)$) { return 405; }
+    add_header Referrer-Policy no-referrer always;
+    add_header X-Content-Type-Options nosniff always;
+    add_header X-Frame-Options DENY always;
+    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
+    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; media-src 'self'; connect-src 'self'; frame-ancestors 'none'; form-action 'self'; base-uri 'self'; object-src 'none'" always;
+    proxy_set_header Host gram.utilibre.org;
+    proxy_set_header X-Forwarded-Proto https;
+    proxy_set_header Authorization "";
+    proxy_set_header X-Forwarded-For "";
+    proxy_set_header X-Real-IP "";
+    proxy_max_temp_file_size 0;
+    proxy_read_timeout 45s;
+    location /utilibre-source/ { alias /srv/utilibre-source/; autoindex off; }
+    location /api { return 404; }
+    location ~ ^/(static/|proxy|media) {
+      if ($request_method !~ ^(GET|HEAD)$) { return 405; }
+      limit_req zone=kitty_media burst=80 nodelay;
+      proxy_cache kitty_cache;
+      proxy_cache_key "$scheme$proxy_host$request_uri";
+      proxy_cache_valid 200 5m;
+      proxy_cache_lock on;
+      proxy_ignore_headers Set-Cookie;
+      proxy_hide_header Set-Cookie;
+      proxy_pass http://172.29.91.10:8080;
+    }
+    location / {
+      limit_req zone=kitty_pages burst=12 nodelay;
+      proxy_pass http://172.29.91.10:8080;
+    }
+  }
+}
