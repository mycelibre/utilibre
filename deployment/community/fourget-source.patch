diff --git a/Dockerfile.utilibre b/Dockerfile.utilibre
new file mode 100644
index 0000000..030304c
--- /dev/null
+++ b/Dockerfile.utilibre
@@ -0,0 +1,17 @@
+# Build with the 03ba5d7 source plus fourget-source.patch as the context.
+FROM alpine:3.23@sha256:85fe1e81d6758c208f3e1eed4338a1997e19d4be002d4dd32d3100c9a8c010a0
+RUN apk add --no-cache apache2 php84 php84-apache2 php84-fileinfo php84-openssl \
+  php84-iconv php84-dom php84-sodium php84-curl php84-pecl-apcu \
+  php84-pecl-imagick php84-mbstring ca-certificates font-dejavu \
+  imagemagick-jpeg imagemagick-webp imagemagick-heic
+WORKDIR /var/www/html/4get
+COPY . .
+ENV FOURGET_SERVER_NAME="4get · Utilibre" FOURGET_API_ENABLED=0
+RUN cp docker/apache/http/httpd.conf /etc/apache2/httpd.conf \
+  && cp UTILIBRE-imagemagick-policy.xml /etc/ImageMagick-7/policy.xml \
+  && sed -i -e 's/Listen 80/Listen 8080/' -e 's/ServerTokens OS/ServerTokens Prod/' \
+     -e 's/ServerSignature On/ServerSignature Off/' /etc/apache2/httpd.conf \
+  && php84 docker/gen_config.php
+USER 100:101
+EXPOSE 8080
+CMD ["httpd", "-DFOREGROUND", "-c", "PidFile /tmp/httpd.pid", "-c", "Mutex file:/tmp default"]
diff --git a/UTILIBRE-SOURCE.txt b/UTILIBRE-SOURCE.txt
new file mode 100644
index 0000000..9372aed
--- /dev/null
+++ b/UTILIBRE-SOURCE.txt
@@ -0,0 +1,13 @@
+4get: Utilibre deployment, 2026-10-06.
+Base: https://git.lolcat.ca/lolcat/4get
+Revision: 03ba5d7b5ed3dc91b3e7d8b6278d8f52818a99ae
+License: GNU AGPL-3.0-only; original notices are retained.
+
+Changes: Apache/PHP 8.4 Alpine runtime; URL validation on every redirect;
+validated public IPv4 addresses pinned to connections; no environment proxy;
+8 MiB decompressed response bound; image/audio MIME restrictions; bounded
+ImageMagick resources; local corresponding-source link. API access is disabled.
+
+Build: docker build -f Dockerfile.utilibre -t utilibre-4get:03ba5d7-p2 .
+Gateway and firewall: https://github.com/mycelibre/utilibre/tree/main/deployment/community
+This source archive contains no production secrets or user data.
diff --git a/UTILIBRE-imagemagick-policy.xml b/UTILIBRE-imagemagick-policy.xml
new file mode 100644
index 0000000..80798e2
--- /dev/null
+++ b/UTILIBRE-imagemagick-policy.xml
@@ -0,0 +1,14 @@
+<policymap>
+  <policy domain="resource" name="memory" value="64MiB"/>
+  <policy domain="resource" name="map" value="64MiB"/>
+  <policy domain="resource" name="disk" value="0"/>
+  <policy domain="resource" name="width" value="8192"/>
+  <policy domain="resource" name="height" value="8192"/>
+  <policy domain="resource" name="list-length" value="32"/>
+  <policy domain="resource" name="thread" value="1"/>
+  <policy domain="resource" name="time" value="20"/>
+  <policy domain="delegate" rights="none" pattern="*"/>
+  <policy domain="path" rights="none" pattern="@*"/>
+  <policy domain="coder" rights="none" pattern="*"/>
+  <policy domain="coder" rights="read|write" pattern="{PNG,JPEG,JPG,GIF,WEBP,AVIF,HEIC,ICO}"/>
+</policymap>
