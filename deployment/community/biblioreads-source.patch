diff --git a/pages/api/image.js b/pages/api/image.js
new file mode 100644
index 0000000..b1fe313
--- /dev/null
+++ b/pages/api/image.js
@@ -0,0 +1,59 @@
+import sharp from 'sharp';
+
+sharp.cache({ memory: 16, files: 0, items: 16 });
+sharp.concurrency(1);
+const cache = new Map();
+let cacheBytes = 0;
+let active = 0;
+const waiting = [];
+async function acquire() {
+  if (active < 4) { active++; return true; }
+  if (waiting.length >= 24) return false;
+  return new Promise(resolve => {
+    const entry = { resolve, timer: null };
+    entry.timer = setTimeout(() => {
+      const index = waiting.indexOf(entry);
+      if (index >= 0) waiting.splice(index, 1);
+      resolve(false);
+    }, 15000);
+    waiting.push(entry);
+  });
+}
+function release() {
+  const next = waiting.shift();
+  if (next) { clearTimeout(next.timer); next.resolve(true); }
+  else active--;
+}
+export default async function image(req, res) {
+  if (!['GET', 'HEAD'].includes(req.method)) return res.status(405).end();
+  const value = req.query.url;
+  if (typeof value !== 'string' || value.length > 2048) return res.status(400).end();
+  let url;
+  try {
+    url = new URL(value.startsWith('//') ? `https:${value}` : value);
+    if (url.protocol !== 'https:' || !['i.gr-assets.com', 'images.gr-assets.com', 'm.media-amazon.com'].includes(url.hostname) || url.username || url.password || url.port || url.hash) throw Error('Denied');
+  } catch { return res.status(400).end(); }
+  const key = url.href;
+  let cached = cache.get(key);
+  if (cached && cached.expires < Date.now()) { cacheBytes -= cached.bytes.length; cache.delete(key); cached = null; }
+  if (cached) { res.setHeader('Content-Type', 'image/webp'); res.setHeader('Cache-Control', 'public,max-age=3600'); return res.send(cached.bytes); }
+  if (!await acquire()) return res.status(429).end();
+  try {
+    const upstream = await fetch(url.href);
+    if (!upstream.ok || !/^image\/(jpeg|png|gif|webp|avif)/i.test(upstream.headers.get('content-type') || '')) return res.status(502).end();
+    const bytes = Buffer.from(await upstream.arrayBuffer());
+    const pipeline = sharp(bytes, { limitInputPixels: 20000000, animated: false }).timeout({seconds: 5});
+    const metadata = await pipeline.metadata();
+    if (!['jpeg','png','gif','webp','avif','heif'].includes(metadata.format)) return res.status(415).end();
+    const result = await pipeline.resize({ width: 1200, height: 1600, fit: 'inside', withoutEnlargement: true }).webp({ quality: 80 }).toBuffer();
+    while (cache.size >= 64 || cacheBytes + result.length > 24 * 1024 * 1024) {
+      const oldest = cache.keys().next().value;
+      if (oldest === undefined) break;
+      cacheBytes -= cache.get(oldest).bytes.length; cache.delete(oldest);
+    }
+    cache.set(key, {bytes: result, expires: Date.now() + 3600000}); cacheBytes += result.length;
+    res.setHeader('Content-Type', 'image/webp'); res.setHeader('Cache-Control', 'public,max-age=3600');
+    return res.send(result);
+  } catch { return res.status(502).end(); }
+  finally { release(); }
+}
