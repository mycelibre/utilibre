+const assert = require('node:assert/strict');
+const { checkedURL, publicIP, dispatcher } = require('../utilibre-preload.cjs');
+for (const ip of ['127.0.0.1','10.10.1.3','172.29.88.10','192.168.1.1','169.254.169.254','100.64.1.1','198.18.1.1','203.0.113.1','0.0.0.0','::1','::ffff:127.0.0.1']) assert.equal(publicIP(ip), false, ip);
+assert.equal(publicIP('8.8.8.8'), true);
+for (const url of ['https://www.goodreads.com/book/show/5907', 'https://i.gr-assets.com/image.jpg']) assert.equal(checkedURL(url).href,url);
+assert.equal(checkedURL('http://www.goodreads.com/list/show/1').protocol,'https:');
+for (const url of ['https://127.0.0.1/','http://i.gr-assets.com/x','https://www.goodreads.com.evil.test/','https://x@www.goodreads.com/','file:///etc/passwd','https://www.goodreads.com:8080/','https://www.goodreads.com/#x']) assert.throws(()=>checkedURL(url));
+dispatcher.close();
+console.log('22 fixed-host/private-address tests passed');
diff --git a/utilibre-preload.cjs b/utilibre-preload.cjs
new file mode 100644
index 0000000..25ea87e
--- /dev/null
+++ b/utilibre-preload.cjs
@@ -0,0 +1,66 @@
+'use strict';
+// All application fetches use the same fixed upstream and pinned-DNS policy.
+const { lookup } = require('node:dns');
+const { isIP } = require('node:net');
+const { Agent, fetch: upstreamFetch } = require('undici');
+const hosts = new Set(['www.goodreads.com', 'goodreads.com', 'i.gr-assets.com', 'images.gr-assets.com', 'm.media-amazon.com', 'kxbwmqov6jgg3daaamb744ycu4.appsync-api.us-east-1.amazonaws.com']);
+function publicIP(address) {
+  if (isIP(address) !== 4) return false;
+  const [a,b,c] = address.split('.').map(Number);
+  return !(a === 0 || a === 10 || a === 127 || a >= 224 || (a === 100 && b >= 64 && b <= 127) || (a === 169 && b === 254) || (a === 172 && b >= 16 && b <= 31) || (a === 192 && (b === 168 || b === 0)) || (a === 198 && (b === 18 || b === 19 || (b === 51 && c === 100))) || (a === 203 && b === 0 && c === 113));
+}
+function checkedURL(input) {
+  const url = new URL(typeof input === 'string' || input instanceof URL ? input : input.url);
+  // An upstream legacy list route explicitly uses HTTP. Upgrade only Goodreads.
+  if (url.protocol === 'http:' && ['www.goodreads.com','goodreads.com'].includes(url.hostname) && !url.port) url.protocol = 'https:';
+  if (url.protocol !== 'https:' || !hosts.has(url.hostname) || url.username || url.password || url.hash || (url.port && url.port !== '443')) throw Error('Upstream destination denied');
+  return url;
+}
+const dispatcher = new Agent({ connections: 4, pipelining: 1, headersTimeout: 15000, bodyTimeout: 15000,
+  connect: { timeout: 5000, lookup(hostname, options, callback) {
+    if (!hosts.has(hostname)) return callback(Error('Host denied'));
+    lookup(hostname, { all: true, family: 4 }, (error, addresses) => {
+      if (error) return callback(error);
+      if (!addresses.length || addresses.some(({address}) => !publicIP(address))) return callback(Error('Address denied'));
+      if (options.all) callback(null, addresses);
+      else callback(null, addresses[0].address, 4);
+    });
+  } },
+});
+async function guardedFetch(input, init = {}) {
+  let url = checkedURL(input);
+  const signal = init.signal ? AbortSignal.any([init.signal, AbortSignal.timeout(20000)]) : AbortSignal.timeout(20000);
+  const headers = new Headers(init.headers || (typeof input === 'object' && input.headers) || {});
+  headers.delete('cookie'); headers.delete('authorization'); headers.delete('forwarded'); headers.delete('x-forwarded-for');
+  const options = { ...init, headers, dispatcher, signal, redirect: 'manual' };
+  for (let redirects = 0; redirects <= 3; redirects++) {
+    const response = await upstreamFetch(url, options);
+    if ([301,302,303,307,308].includes(response.status)) {
+      const location = response.headers.get('location');
+      await response.body?.cancel();
+      if (!location || redirects === 3 || (options.method && options.method !== 'GET')) throw Error('Upstream redirect denied');
+      const next = checkedURL(new URL(location, url));
+      if (next.hostname !== url.hostname) options.headers.delete('x-api-key');
+      url = next; continue;
+    }
+    const reader = response.body?.getReader();
+    const chunks = []; let length = 0;
+    if (reader) {
+      try {
+        while (true) {
+          const {done,value} = await reader.read(); if (done) break;
+          length += value.byteLength;
+          if (length > 8 * 1024 * 1024) throw Error('Upstream response too large');
+          chunks.push(Buffer.from(value));
+        }
+      } catch (error) { await reader.cancel(); throw error; }
+      finally { reader.releaseLock(); }
+    }
+    const cleanHeaders = new Headers(response.headers);
+    for (const name of ['content-encoding','content-length','set-cookie']) cleanHeaders.delete(name);
+    return new Response([204,205,304].includes(response.status) ? null : Buffer.concat(chunks), { status: response.status, headers: cleanHeaders });
+  }
+  throw Error('Too many redirects');
+}
+globalThis.fetch = guardedFetch;
+module.exports = { checkedURL, publicIP, guardedFetch, dispatcher };
