# Same PairDrop 1.11.2 and tab guard, supported Alpine 3.21 updates,
# Express 4.x native dependency graph and WebSocket security repairs.
FROM ghcr.io/schlagmichdoch/pairdrop:v1.11.2@sha256:c4b30977264a76e335740089e693a52a0d0d616330dec7f93c7b96beef7b4a02
USER root
COPY pairdrop-security/package.json pairdrop-security/package-lock.json ./
RUN apk upgrade --no-cache \
 && npm ci --ignore-scripts --no-audit --no-fund \
 && npm cache clean --force
COPY pairdrop-storage-guard.cjs /tmp/pairdrop-storage-guard.cjs
RUN node /tmp/pairdrop-storage-guard.cjs --apply && rm /tmp/pairdrop-storage-guard.cjs
USER 1000:1000
