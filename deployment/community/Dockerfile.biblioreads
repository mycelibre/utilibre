FROM node:24-alpine@sha256:ebfe2f90462722a7a4de65e91990e97fe0d401c70e0e762c5b53302f905ec1c1 AS build
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1 NODE_ENV=production
COPY package.json package-lock.json ./
RUN npm ci --include=dev --ignore-scripts
COPY . .
ENV NEXT_PUBLIC_HOST_URL=https://biblioreads.utilibre.org \
    NEXT_PUBLIC_INSTANCE_OPERATOR_NAME=Utilibre \
    NEXT_PUBLIC_INSTANCE_OPERATOR_LINK=https://utilibre.org \
    NEXT_PUBLIC_INSTANCE_PROVIDER=Hetzner \
    NEXT_PUBLIC_INSTANCE_COUNTRY=Germany \
    NEXT_PUBLIC_INSTANCE_CLOUDFLARE=true \
    NEXT_PUBLIC_INSTANCE_CUSTOM_PRIVACY=true \
    NEXT_PUBLIC_INSTANCE_PRIVACY_POLICY_URL=https://utilibre.org/en/privacy \
    NEXT_PUBLIC_INSTANCE_LOG_RETENTION="No application access logs; edge/provider retention is separate" \
    NEXT_PUBLIC_INSTANCE_IP_DATA=true \
    NEXT_PUBLIC_INSTANCE_PAGE_VIEW_DATA=true \
    NEXT_PUBLIC_INSTANCE_DEVICE_TYPE_DATA=false \
    NEXT_PUBLIC_INSTANCE_DIAGNOSTIC_DATA=true \
    NEXT_PUBLIC_INSTANCE_OTHER_DATA="The Cloudflare edge and Goodreads process requests. Library data stays in your browser; export important records." \
    NEXT_PUBLIC_ENABLE_CONTACT_FORM=false
RUN node tests/utilibre.cjs && npm run build

FROM node:24-alpine@sha256:ebfe2f90462722a7a4de65e91990e97fe0d401c70e0e762c5b53302f905ec1c1
WORKDIR /app
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 HOSTNAME=0.0.0.0 PORT=3000
COPY --from=build --chown=node:node /app/.next/standalone ./
COPY --from=build --chown=node:node /app/.next/static ./.next/static
COPY --from=build --chown=node:node /app/public ./public
COPY --from=build /app/utilibre-preload.cjs ./utilibre-preload.cjs
USER node
CMD ["node", "--max-old-space-size=384", "--require", "./utilibre-preload.cjs", "server.js"]
