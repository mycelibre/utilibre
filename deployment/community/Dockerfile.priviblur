FROM python:3.13-slim@sha256:3dd7cc108ec1493442514f5c2a871af6af0ec31d768ff6e378a93340c3b3db5f
RUN apt-get update && apt-get install -y --no-install-recommends git ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /priviblur
COPY --from=upstream / /priviblur/
RUN test "$(git rev-parse HEAD)" = 251a8e67c64d792b3c8c141860ccaa227ce62e4d
COPY priviblur-requirements.txt /priviblur/requirements.txt
RUN pip install --no-cache-dir -r requirements.txt && pip freeze > /priviblur/build-requirements.txt
COPY priviblur-source-notice.patch /tmp/source-notice.patch
RUN git apply /tmp/source-notice.patch && pybabel compile -d locales -D priviblur && git config --system --add safe.directory /priviblur
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
USER 1000:1000
CMD ["python", "-m", "src.server"]
