+<?php
+require __DIR__ . '/../misc/utilibre-http.php';
+$checks = 0;
+function check(bool $condition): void {
+    global $checks;
+    if (!$condition) throw new RuntimeException('Validation regression');
+    $checks++;
+}
+check(utilibre_valid_url('https://i.pinimg.com/a.jpg', ['i.pinimg.com']));
+foreach (['http://i.pinimg.com/a', 'https://i.pinimg.com.evil.test/a',
+          'https://i.pinimg.com@127.0.0.1/a', 'https://user@i.pinimg.com/a',
+          'https://i.pinimg.com:444/a', 'https://i.pinimg.com/a#b',
+          'https://127.0.0.1/a', 'https://[::1]/a', 'file:///etc/passwd'] as $url) {
+    check(!utilibre_valid_url($url, ['i.pinimg.com']));
+}
+foreach (['127.0.0.1', '10.10.1.3', '172.29.85.20', '192.168.1.1',
+          '169.254.169.254', '100.64.0.1', '198.18.0.1', '192.0.0.8',
+          '0.0.0.0', '255.255.255.255', '::1'] as $ip) check(!utilibre_public_ip($ip));
+check(utilibre_public_ip('1.1.1.1'));
+echo "$checks Binternet URL/address checks passed.\n";
