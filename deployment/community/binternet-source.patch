diff --git a/Dockerfile.utilibre b/Dockerfile.utilibre
new file mode 100644
index 0000000..28ae5c3
--- /dev/null
+++ b/Dockerfile.utilibre
@@ -0,0 +1,14 @@
+# Binternet 9bb70ef26c8b79a315e77b79bfd346433d55cbb6 plus binternet-source.patch.
+FROM alpine:3.23@sha256:85fe1e81d6758c208f3e1eed4338a1997e19d4be002d4dd32d3100c9a8c010a0 AS application
+RUN apk add --no-cache php84 php84-fpm php84-dom php84-curl php84-openssl php84-fileinfo ca-certificates
+WORKDIR /app
+COPY . .
+RUN php84 -l search.php && php84 -l image_proxy.php && php84 -l misc/utilibre-http.php \
+    && php84 tests/utilibre-http.php
+USER 65534:65534
+ENTRYPOINT ["php-fpm84", "-F", "-y", "/etc/php84/utilibre-fpm.conf"]
+
+FROM nginxinc/nginx-unprivileged:1.28-alpine@sha256:7377697a821c131a924a7105fafbe7414db4e9fcc77a6f08f776f33f141ec3f8 AS gateway
+COPY --from=application /app /app
+USER 101:101
+ENTRYPOINT ["nginx", "-g", "daemon off;"]
diff --git a/UTILIBRE-SOURCE.txt b/UTILIBRE-SOURCE.txt
new file mode 100644
index 0000000..6240485
--- /dev/null
+++ b/UTILIBRE-SOURCE.txt
@@ -0,0 +1,21 @@
+Binternet on Utilibre — modified build 9bb70ef-p1, 2026-10-06
+Upstream: https://github.com/Ahwxorg/Binternet
+Revision: 9bb70ef26c8b79a315e77b79bfd346433d55cbb6
+License: upstream GPL version 3; see LICENSE.
+
+Changes: fixed-host HTTPS requests with public IPv4 resolution pinning;
+no redirects or environment proxies; TLS verification, 20-second deadlines
+and 8 MiB response caps; image MIME allowlist; escaped upstream author names;
+validated search/pagination parameters and truthful empty/error states;
+accessible search labels and zoom; matching deployed-source link.
+No accounts, shared personal cookies, uploads or database. Anonymous Pinterest
+pagination tokens are passed through the pagination URL. Searches/image requests
+reach Pinterest from the server. Clicking author links leaves for Pinterest.
+
+Dockerfile.utilibre builds application and gateway targets. The accompanying
+deployment/ directory contains the PHP-FPM, nginx, Compose and firewall settings.
+Use the paths documented in the Utilibre repository when deploying those files:
+https://github.com/mycelibre/utilibre/tree/main/deployment/community
+The supplied source archive contains no production secrets or visitor data.
+Native Donate/Legal/Source links keep their upstream meanings. No custom
+Utilibre navigation button was added. The upstream interface is English-only.
