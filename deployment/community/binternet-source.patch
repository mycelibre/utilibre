+    location ~ ^/(index|search|image_proxy|donate)\.php$ {
+      set $php binternet:9000;
+      include /etc/nginx/fastcgi_params;
+      fastcgi_param SCRIPT_FILENAME /app$fastcgi_script_name;
+      fastcgi_param HTTP_HOST binternet.utilibre.org;
+      fastcgi_param HTTPS on;
+      fastcgi_param HTTP_AUTHORIZATION "";
+      fastcgi_param HTTP_COOKIE "";
+      fastcgi_pass $php;
+      fastcgi_read_timeout 30s;
+      fastcgi_max_temp_file_size 0;
+      fastcgi_hide_header X-Powered-By;
+      fastcgi_hide_header Set-Cookie;
+      limit_req zone=binternet_images burst=100 nodelay;
+      limit_rate 1m;
+    }
+    location = /search.php {
+      limit_req zone=binternet_search burst=5 nodelay;
+      limit_req zone=binternet_global burst=3;
+      set $php binternet:9000;
+      include /etc/nginx/fastcgi_params;
+      fastcgi_param SCRIPT_FILENAME /app/search.php;
+      fastcgi_param HTTP_HOST binternet.utilibre.org;
+      fastcgi_param HTTPS on;
+      fastcgi_param HTTP_AUTHORIZATION "";
+      fastcgi_param HTTP_COOKIE "";
+      fastcgi_pass $php;
+      fastcgi_read_timeout 30s;
+      fastcgi_max_temp_file_size 0;
+      fastcgi_hide_header X-Powered-By;
+      fastcgi_hide_header Set-Cookie;
+    }
+    location = / { rewrite ^ /index.php last; }
