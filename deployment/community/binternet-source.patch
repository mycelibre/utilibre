diff --git a/misc/utilibre-http.php b/misc/utilibre-http.php
new file mode 100644
index 0000000..dd4038e
--- /dev/null
+++ b/misc/utilibre-http.php
@@ -0,0 +1,42 @@
+<?php
+// Exact public upstreams, pinned IPv4, no redirects/proxy, bounded bodies.
+function utilibre_valid_url(string $url, array $hosts): bool {
+    $p = parse_url($url);
+    return $p !== false && ($p['scheme'] ?? '') === 'https'
+        && in_array(strtolower($p['host'] ?? ''), $hosts, true)
+        && !isset($p['user']) && !isset($p['pass']) && !isset($p['fragment'])
+        && (!isset($p['port']) || $p['port'] === 443);
+}
+function utilibre_public_ip(string $ip): bool {
+    if (!filter_var($ip, FILTER_VALIDATE_IP, FILTER_FLAG_IPV4 | FILTER_FLAG_NO_PRIV_RANGE | FILTER_FLAG_NO_RES_RANGE)) return false;
+    $n = ip2long($ip);
+    foreach (['100.64.0.0/10', '192.0.0.0/24', '198.18.0.0/15'] as $cidr) {
+        [$base, $bits] = explode('/', $cidr);
+        $mask = -1 << (32 - (int)$bits);
+        if (($n & $mask) === (ip2long($base) & $mask)) return false;
+    }
+    return true;
+}
+function utilibre_curl(string $url, array $hosts, &$body) {
+    if (!utilibre_valid_url($url, $hosts)) throw new RuntimeException('Destination denied');
+    $host = parse_url($url, PHP_URL_HOST);
+    $addresses = gethostbynamel($host);
+    if (!$addresses) throw new RuntimeException('Resolution failed');
+    foreach ($addresses as $ip) if (!utilibre_public_ip($ip)) throw new RuntimeException('Address denied');
+    $body = '';
+    $ch = curl_init($url);
+    curl_setopt_array($ch, [
+        CURLOPT_RETURNTRANSFER => false, CURLOPT_FOLLOWLOCATION => false,
+        CURLOPT_PROTOCOLS => CURLPROTO_HTTPS, CURLOPT_REDIR_PROTOCOLS => CURLPROTO_HTTPS,
+        CURLOPT_PROXY => '', CURLOPT_IPRESOLVE => CURL_IPRESOLVE_V4,
+        CURLOPT_RESOLVE => ["$host:443:" . $addresses[0]],
+        CURLOPT_CONNECTTIMEOUT => 5, CURLOPT_TIMEOUT => 20, CURLOPT_ENCODING => '',
+        CURLOPT_SSL_VERIFYPEER => true, CURLOPT_SSL_VERIFYHOST => 2,
+        CURLOPT_WRITEFUNCTION => static function ($ch, string $chunk) use (&$body): int {
+            if (strlen($body) + strlen($chunk) > 8 * 1024 * 1024) return 0;
+            $body .= $chunk;
+            return strlen($chunk);
+        },
+    ]);
+    return $ch;
+}
