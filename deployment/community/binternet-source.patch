+  real_ip_recursive on;
+  resolver 127.0.0.11 valid=10s ipv6=off;
+  limit_req_zone $binary_remote_addr zone=binternet_search:1m rate=10r/m;
+  limit_req_zone $server_name zone=binternet_global:1m rate=1r/s;
+  limit_req_zone $binary_remote_addr zone=binternet_images:2m rate=12r/s;
