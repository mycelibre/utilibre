@@ -0,0 +1,36 @@
+{
+  "back": "Back to FMD",
+  "title": "Privacy on Utilibre",
+  "language": "Language",
+  "scope": "These notes describe this Utilibre deployment. Other FMD controls may remain in English. Use FMD only for your own devices or with their owner’s permission.",
+  "stored": {
+    "title": "What is stored",
+    "body": "FMD stores your device account identifier, password verifier, protected key material, push URL, last-connection time and operational message metadata. Location and picture payloads are encrypted by the client before upload. The server and its operators can access account metadata and stored ciphertext; encryption does not hide every record. This instance keeps up to 300 locations and 5 pictures per account."
+  },
+  "connections": {
+    "title": "Connections and providers",
+    "body": "Public HTTPS passes through Cloudflare and the Caddy edge to Utilibre on Hetzner infrastructure in Germany. Ordinary HTTP content and connection metadata are visible at TLS termination; client-encrypted payloads remain ciphertext in the normal flow. Map views request OpenStreetMap tiles from your browser and disclose your network address and viewed region to that provider. Tile requests also identify this site's origin (https://fmd.utilibre.org/), without the page path, query parameters or fragment. Your chosen push provider also receives delivery requests. No advertising analytics or cross-service profiling is added."
+  },
+  "retention": {
+    "title": "Retention and backups",
+    "body": "Account records remain until deleted; older locations and pictures are removed as the configured count limits are reached. Operational error and security logs may include network addresses and failed-login metadata. Container logs rotate by size; edge, system and provider retention has not been fully verified. Utilibre’s community backups are on the same VM and have no automatic expiry policy. Live deletion does not immediately erase older backups, downloaded exports or copies held elsewhere."
+  },
+  "export": {
+    "title": "Exporting an independent copy",
+    "body": "After signing in, open Settings and choose Export data. The browser downloads and decrypts the retained data into a ZIP containing info.json (account identifier and push URL), locations.csv and pictures when present. This is a readable export, not a complete account backup: it does not include account credentials, all settings, deleted records or an automatically restorable account. Protect the ZIP; its push URL can be sensitive. On 9 October 2026, native browser decryption, ZIP download and local reopening passed with fictional records. A physical Android workflow, push delivery and account import from this ZIP have not been tested; the inspected client has no native ZIP account import."
+  },
+  "delete": {
+    "title": "Deleting data",
+    "body": "Settings provides Delete locations, Delete photos and Delete account. Check which action you selected before confirming it. Removing browser site data alone does not delete the server account. Account deletion stops access to its live records; keep any exports you need first and revoke device or push-provider credentials separately where relevant. Neither deletion nor unsharing recalls copies already downloaded by another person."
+  },
+  "security": {
+    "title": "Keys and reporting",
+    "body": "Keep your password and recovery material private. Normal decryption requires the appropriate client keys; encryption does not protect against compromised client software or malicious application code delivered by a compromised server. For security or abuse reports, use admin@utilibre.org or the contact methods in the linked security policy. Do not send passwords, API keys, decryption keys or private location records in a public issue."
+  },
+  "links": "Utilibre information",
+  "moreTools": "More tools from Utilibre",
+  "guide": "Export and deletion guide",
+  "privacy": "Privacy notes",
+  "contact": "Security and contact",
+  "source": "Source for this deployment"
+}
