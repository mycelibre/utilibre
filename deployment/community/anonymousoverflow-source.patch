diff --git a/src/scraper/api_transport.go b/src/scraper/api_transport.go
new file mode 100644
index 0000000..5157d86
--- /dev/null
+++ b/src/scraper/api_transport.go
@@ -0,0 +1,84 @@
+package scraper
+
+// Respect Stack Exchange's documented backoff and duplicate-request limits.
+// Cache public API JSON before rendering fresh short-lived image tokens.
+import (
+	"anonymousoverflow/src/utils"
+	"bytes"
+	"encoding/json"
+	"errors"
+	"io"
+	"net/http"
+	"sync"
+	"time"
+)
+
+type cacheEntry struct {
+	body    []byte
+	header  http.Header
+	expires time.Time
+}
+type politeTransport struct {
+	mu           sync.Mutex
+	cache        map[string]cacheEntry
+	size         int
+	blockedUntil time.Time
+}
+
+var apiTransport = &politeTransport{cache: make(map[string]cacheEntry)}
+
+func (t *politeTransport) RoundTrip(req *http.Request) (*http.Response, error) {
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	key := req.URL.String()
+	for k, entry := range t.cache {
+		if time.Now().After(entry.expires) {
+			delete(t.cache, k)
+			t.size -= len(entry.body)
+		}
+	}
+	if entry, ok := t.cache[key]; ok {
+		return &http.Response{StatusCode: 200, Header: entry.header.Clone(), Body: io.NopCloser(bytes.NewReader(entry.body)), ContentLength: int64(len(entry.body)), Request: req}, nil
+	}
+	if time.Now().Before(t.blockedUntil) {
+		return nil, errors.New("upstream requested a pause; try again later")
+	}
+	response, err := utils.OutboundTransport.RoundTrip(req)
+	if err != nil {
+		return nil, err
+	}
+	defer response.Body.Close()
+	body, err := io.ReadAll(response.Body)
+	if err != nil {
+		return nil, err
+	}
+	var limits struct {
+		Backoff        int  `json:"backoff"`
+		QuotaRemaining *int `json:"quota_remaining"`
+	}
+	if json.Unmarshal(body, &limits) == nil {
+		if limits.Backoff > 0 {
+			t.blockedUntil = time.Now().Add(time.Duration(limits.Backoff) * time.Second)
+		}
+		if limits.QuotaRemaining != nil && *limits.QuotaRemaining == 0 {
+			t.blockedUntil = time.Now().Add(24 * time.Hour)
+		}
+	}
+	if response.StatusCode == 429 {
+		t.blockedUntil = time.Now().Add(5 * time.Minute)
+	}
+	if response.StatusCode == 200 {
+		for t.size+len(body) > 32<<20 {
+			for k, entry := range t.cache {
+				delete(t.cache, k)
+				t.size -= len(entry.body)
+				break
+			}
+		}
+		t.cache[key] = cacheEntry{body: body, header: response.Header.Clone(), expires: time.Now().Add(5 * time.Minute)}
+		t.size += len(body)
+	}
+	response.Body = io.NopCloser(bytes.NewReader(body))
+	response.ContentLength = int64(len(body))
+	return response, nil
+}
diff --git a/src/scraper/api_transport_test.go b/src/scraper/api_transport_test.go
