diff --git a/Dockerfile.utilibre b/Dockerfile.utilibre
new file mode 100644
index 0000000..6be9c1d
--- /dev/null
+++ b/Dockerfile.utilibre
@@ -0,0 +1,13 @@
+FROM golang:1.26-alpine@sha256:8ac98ca534ac3f51e1f420a1dd2c15e74c75cfa0f23f3ad27eb5d7236c349a0c AS build
+WORKDIR /src
+COPY go.mod go.sum ./
+RUN go mod download
+COPY . .
+RUN go test ./... && CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /anonymousoverflow .
+FROM alpine:3.23@sha256:85fe1e81d6758c208f3e1eed4338a1997e19d4be002d4dd32d3100c9a8c010a0
+RUN apk add --no-cache ca-certificates
+WORKDIR /app
+COPY --from=build /anonymousoverflow /app/anonymousoverflow
+USER 65534:65534
+EXPOSE 8080
+CMD ["/app/anonymousoverflow"]
diff --git a/UTILIBRE-SOURCE.txt b/UTILIBRE-SOURCE.txt
new file mode 100644
index 0000000..68323fd
--- /dev/null
+++ b/UTILIBRE-SOURCE.txt
@@ -0,0 +1,14 @@
+AnonymousOverflow: Utilibre deployment, 2026-10-06.
+Base: https://github.com/httpjamesm/AnonymousOverflow
+Revision: 937cfeefd6dcbab92ef572671f16d4d3be6abad3
+License: MPL-2.0; original notices are retained.
+
+Changes: current Go/dependencies, bounded public Stack Exchange/image egress,
+private-address and credential-forwarding defenses, JSON cache and API backoff,
+trusted gateway only, disabled request logging, image MIME checks, source link.
+The native rate limiter is disabled only behind the separately enforced gateway.
+Tests include denied destinations, API caching, quota exhaustion and backoff.
+
+Build: docker build -f Dockerfile.utilibre -t utilibre-anonymousoverflow:937cfee-p1 .
+Deployment configuration: https://github.com/mycelibre/utilibre/tree/main/deployment/community
+This source archive contains no production secrets or user data.
