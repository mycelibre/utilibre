index 0000000..4700998
--- /dev/null
+++ b/src/scraper/api_transport_test.go
@@ -0,0 +1,50 @@
+package scraper
+
+import (
+ "anonymousoverflow/src/utils"
+ "io"
+ "net/http"
+ "strings"
+ "testing"
+ "time"
+)
+
+type testTransport func(*http.Request) (*http.Response, error)
+func (f testTransport) RoundTrip(r *http.Request) (*http.Response, error) { return f(r) }
+
+func TestAPICacheAndBackoff(t *testing.T) {
+ old := utils.OutboundTransport
+ defer func(){utils.OutboundTransport = old}()
+ calls := 0
+ utils.OutboundTransport = testTransport(func(r *http.Request)(*http.Response,error){
+  calls++
+  return &http.Response{StatusCode:200, Header:make(http.Header), Body:io.NopCloser(strings.NewReader(`{"items":[],"backoff":60,"quota_remaining":50}`)),Request:r},nil
+ })
+ transport := &politeTransport{cache:make(map[string]cacheEntry)}
+ req,_ := http.NewRequest("GET","https://api.stackexchange.com/2.3/questions/1",nil)
+ for i:=0;i<2;i++ {r,e:=transport.RoundTrip(req);if e!=nil {t.Fatal(e)};r.Body.Close()}
+ if calls!=1 {t.Fatalf("duplicate request contacted upstream %d times",calls)}
+ req2,_ := http.NewRequest("GET","https://api.stackexchange.com/2.3/questions/2",nil)
+ if _,e:=transport.RoundTrip(req2);e==nil {t.Fatal("backoff was ignored")}
+ if calls!=1 {t.Fatal("backoff still contacted upstream")}
+ transport.blockedUntil=time.Time{}
+ transport.cache[req.URL.String()]=cacheEntry{body:[]byte("old"),expires:time.Now().Add(-time.Minute)}
+ transport.size=3
+ r,e:=transport.RoundTrip(req);if e!=nil {t.Fatal(e)};r.Body.Close()
+ if calls!=2 {t.Fatal("expired cached result was reused")}
+}
+
+func TestAPIQuotaAnd429(t *testing.T) {
+ old := utils.OutboundTransport
+ defer func(){utils.OutboundTransport = old}()
+ for _,test:=range []struct{status int;body string;minimum time.Duration}{
+  {200,`{"items":[],"quota_remaining":0}`,23*time.Hour},
+  {429,`{"error_message":"slow down"}`,4*time.Minute},
+ } {
+  utils.OutboundTransport=testTransport(func(r *http.Request)(*http.Response,error){return &http.Response{StatusCode:test.status,Header:make(http.Header),Body:io.NopCloser(strings.NewReader(test.body)),Request:r},nil})
+  transport:=&politeTransport{cache:make(map[string]cacheEntry)}
+  req,_:=http.NewRequest("GET","https://api.stackexchange.com/2.3/questions/1",nil)
+  r,e:=transport.RoundTrip(req);if e!=nil {t.Fatal(e)};r.Body.Close()
+  if time.Until(transport.blockedUntil)<test.minimum {t.Fatal("upstream pause not respected")}
+ }
+}
diff --git a/src/utils/outbound.go b/src/utils/outbound.go
new file mode 100644
index 0000000..74a9315
--- /dev/null
+++ b/src/utils/outbound.go
@@ -0,0 +1,123 @@
+package utils
+
+// Utilibre deployment hardening: fixed public Stack Exchange/image destinations,
+// bounded response bodies and deadlines. Visitor credentials are never forwarded.
+import (
+	"context"
+	"errors"
+	"io"
+	"net"
+	"net/http"
+	"net/netip"
+	"net/url"
+	"strings"
+	"time"
+)
+
+const responseLimit int64 = 8 << 20
+
+var hosts = map[string]bool{
+	"stackoverflow.com": true, "stackexchange.com": true, "api.stackexchange.com": true,
+	"www.stackoverflow.com": true, "superuser.com": true, "serverfault.com": true,
+	"askubuntu.com": true, "mathoverflow.net": true, "stackapps.com": true,
+	"i.sstatic.net": true, "cdn.sstatic.net": true, "i.stack.imgur.com": true, "i.imgur.com": true,
+}
+
+func allowedHost(host string) bool {
+	return hosts[host] || strings.HasSuffix(host, ".stackexchange.com")
+}
+
+func allowedURL(u *url.URL) bool {
+	return u.Scheme == "https" && u.User == nil && (u.Port() == "" || u.Port() == "443") && allowedHost(u.Hostname())
+}
+
+func publicIP(ip netip.Addr) bool {
+	ip = ip.Unmap()
+	if !ip.IsGlobalUnicast() || ip.IsPrivate() || ip.IsLoopback() || ip.IsLinkLocalUnicast() {
+		return false
+	}
+	for _, cidr := range []string{"0.0.0.0/8", "100.64.0.0/10", "192.0.0.0/24", "192.0.2.0/24", "198.18.0.0/15", "198.51.100.0/24", "203.0.113.0/24", "240.0.0.0/4", "2001:db8::/32"} {
+		if netip.MustParsePrefix(cidr).Contains(ip) {
+			return false
+		}
+	}
+	return true
+}
+
+func publicDial(ctx context.Context, network, address string) (net.Conn, error) {
+	host, port, err := net.SplitHostPort(address)
+	if err != nil || !allowedHost(host) || port != "443" {
+		return nil, errors.New("upstream destination denied")
+	}
+	addresses, err := net.DefaultResolver.LookupNetIP(ctx, "ip", host)
+	if err != nil {
+		return nil, err
+	}
+	for _, ip := range addresses {
+		if !publicIP(ip) {
+			return nil, errors.New("non-public upstream address denied")
+		}
+	}
+	dialer := net.Dialer{Timeout: 8 * time.Second}
+	for _, ip := range addresses {
+		connection, e := dialer.DialContext(ctx, network, net.JoinHostPort(ip.String(), port))
+		if e == nil {
+			return connection, nil
+		}
+	}
+	return nil, errors.New("upstream connection failed")
+}
+
+type boundedBody struct {
+	io.ReadCloser
+	remaining int64
+	cancel    context.CancelFunc
+}
+
+func (b *boundedBody) Read(p []byte) (int, error) {
+	if b.remaining <= 0 {
+		b.Close()
+		return 0, errors.New("upstream response exceeds size limit")
+	}
+	if int64(len(p)) > b.remaining {
+		p = p[:b.remaining]
+	}
+	n, err := b.ReadCloser.Read(p)
+	b.remaining -= int64(n)
+	return n, err
+}
+func (b *boundedBody) Close() error { b.cancel(); return b.ReadCloser.Close() }
+
+type publicTransport struct{ inner http.RoundTripper }
+
+func (t publicTransport) RoundTrip(request *http.Request) (*http.Response, error) {
+	if !allowedURL(request.URL) || (request.Method != "GET" && request.Method != "HEAD") {
+		return nil, errors.New("upstream request denied")
+	}
+	ctx, cancel := context.WithTimeout(request.Context(), 20*time.Second)
+	safe := request.Clone(ctx)
+	safe.Header.Del("Cookie")
+	safe.Header.Del("Authorization")
+	safe.Header.Del("Proxy-Authorization")
+	response, err := t.inner.RoundTrip(safe)
+	if err != nil {
+		cancel()
+		return nil, err
+	}
+	if response.ContentLength > responseLimit {
+		response.Body.Close()
+		cancel()
+		return nil, errors.New("upstream response exceeds size limit")
+	}
+	response.Body = &boundedBody{response.Body, responseLimit, cancel}
+	return response, nil
+}
+
+var OutboundTransport http.RoundTripper
+
+func init() {
+	transport := &http.Transport{DialContext: publicDial, TLSHandshakeTimeout: 8 * time.Second,
+		ResponseHeaderTimeout: 12 * time.Second, MaxResponseHeaderBytes: 64 << 10,
+		MaxIdleConns: 20, MaxIdleConnsPerHost: 4, MaxConnsPerHost: 16, IdleConnTimeout: 30 * time.Second}
+	OutboundTransport = publicTransport{transport}
+}
diff --git a/src/utils/outbound_test.go b/src/utils/outbound_test.go
new file mode 100644
index 0000000..d40f2ce
--- /dev/null
+++ b/src/utils/outbound_test.go
@@ -0,0 +1,30 @@
+package utils
+
+import (
+	"net/netip"
+	"net/url"
+	"testing"
+)
+
+func TestDestinationPolicy(t *testing.T) {
+	for _, raw := range []string{"http://github.com/", "https://github.com:8443/", "https://github.com.evil.invalid/", "https://token@github.com/", "https://127.0.0.1/", "https://example.org/"} {
+		u, _ := url.Parse(raw)
+		if allowedURL(u) {
+			t.Fatalf("accepted %s", raw)
+		}
+	}
+	for _, raw := range []string{"https://api.stackexchange.com/2.3/questions/43743250", "https://i.sstatic.net/example.png"} {
+		u, _ := url.Parse(raw)
+		if !allowedURL(u) {
+			t.Fatalf("rejected %s", raw)
+		}
+	}
+	for _, raw := range []string{"127.0.0.1", "10.10.1.20", "169.254.169.254", "100.64.0.1", "::1", "::ffff:10.10.1.20", "fc00::1", "fe80::1", "192.0.2.1"} {
+		if publicIP(netip.MustParseAddr(raw)) {
+			t.Fatalf("accepted %s", raw)
+		}
+	}
+	if !publicIP(netip.MustParseAddr("140.82.112.3")) {
+		t.Fatal("public GitHub IP rejected")
+	}
+}
