# Context: Pollaris 1.2.3, b6ab5b3309e858a02c042350be82cc7a9c599246.
# Build both targets; production assets are provided by upstream.
FROM composer:2@sha256:af98f42dfff7c68ba8d53c2164fd9fde1087b7d449514baa38c418b1f6bc4bac AS composer
FROM php:8.5-fpm-alpine3.23@sha256:6d75e69d93c446f9f245e81cd0d330c0db9fee45de9cee95facff0826b21378f AS application
RUN apk add --no-cache icu-libs libpq libzip \
 && apk add --no-cache --virtual .build-deps $PHPIZE_DEPS icu-dev postgresql-dev libzip-dev \
 && docker-php-ext-install -j2 intl pdo_pgsql zip \
 && apk del .build-deps
COPY --from=composer /usr/bin/composer /usr/local/bin/composer
WORKDIR /app
COPY . /app
ENV APP_ENV=prod APP_DEBUG=0 COMPOSER_ALLOW_SUPERUSER=1
RUN composer install --no-dev --no-interaction --no-scripts --prefer-dist --optimize-autoloader \
 && composer check-platform-reqs --no-dev
USER 82:82
CMD ["php-fpm", "-F"]

FROM nginxinc/nginx-unprivileged:1.28-alpine@sha256:7377697a821c131a924a7105fafbe7414db4e9fcc77a6f08f776f33f141ec3f8 AS gateway
COPY --from=application /app/public /app/public
USER 101:101
ENTRYPOINT ["nginx", "-g", "daemon off;"]
