@@ -0,0 +1,25 @@
+import type { EngineTiming } from "./search-types";
+
+// Keep provider failures distinct from an ordinary empty search. No queries or
+// provider responses are included; callers render this value as text.
+export const searchAvailability = (
+  timings: EngineTiming[],
+  hasResults: boolean,
+  locale: string,
+): string => {
+  const unavailable = timings.filter((entry) => entry.status && entry.status !== "ok");
+  if (!unavailable.length) return "";
+  const spanish = locale.toLowerCase().startsWith("es");
+  const limited = spanish ? "límite temporal de solicitudes" : "temporarily rate limited";
+  const providers = [...new Set(unavailable.map((entry) =>
+    entry.status === "rate_limited" ? `${entry.name} (${limited})` : entry.name,
+  ))].join(", ");
+  const message = hasResults
+    ? spanish
+      ? "Algunos proveedores no están disponibles: {providers}. Se muestran los resultados de los demás proveedores seleccionados."
+      : "Some providers are unavailable: {providers}. Results from the other selected providers are shown."
+    : spanish
+      ? "Algunos proveedores no están disponibles: {providers}. Los proveedores disponibles no devolvieron resultados. Probá más tarde o revisá los motores seleccionados en Configuración."
+      : "Some providers are unavailable: {providers}. The available providers returned no results. Try later or review the selected engines in Settings.";
+  return message.replace("{providers}", providers);
+};
