diff --git a/Dockerfile.utilibre b/Dockerfile.utilibre
new file mode 100644
index 0000000..e0e4f42
--- /dev/null
+++ b/Dockerfile.utilibre
@@ -0,0 +1,16 @@
+FROM golang:1.26-alpine@sha256:8ac98ca534ac3f51e1f420a1dd2c15e74c75cfa0f23f3ad27eb5d7236c349a0c AS build
+WORKDIR /src
+COPY go.mod go.sum ./
+RUN go mod download
+COPY . .
+RUN go test ./... && CGO_ENABLED=0 go build -trimpath -ldflags="-s -w -X codeberg.org/gothub/gothub/utils.Branch=24bedc8-utilibre-p2" -o /gothub .
+FROM alpine:3.23@sha256:85fe1e81d6758c208f3e1eed4338a1997e19d4be002d4dd32d3100c9a8c010a0
+RUN apk add --no-cache ca-certificates
+WORKDIR /app
+COPY --from=build /gothub /app/gothub
+COPY --from=build /src/views /app/views
+COPY --from=build /src/public /app/public
+USER 65534:65534
+ENV DOCKER=true
+EXPOSE 3000
+CMD ["/app/gothub", "serve"]
diff --git a/UTILIBRE-SOURCE.txt b/UTILIBRE-SOURCE.txt
new file mode 100644
index 0000000..5f8dbac
--- /dev/null
+++ b/UTILIBRE-SOURCE.txt
@@ -0,0 +1,19 @@
+GotHub deployment, 2026-10-06
+Upstream: https://codeberg.org/gothub/gothub
+Revision: 24bedc80bed5fc4f72a8f140c97cb38fc2e67ed2 (default dev branch)
+License: GNU AGPL-3.0; see LICENSE. Original notices retained.
+
+Utilibre modifications: current Go/dependency versions; destination-allowlisted
+HTTPS transport with public-IP-pinned dialing, response limits and deadlines;
+no forwarded user credentials; bounded correctly keyed response cache;
+corrected media alt escaping, release download URL and gist hostname;
+closed HTTP response bodies and handled failed requests; modified-source link;
+read-only-safe static compression and versioned asset URLs (p2).
+This is a public reader, not a Git clone/archive service. Responses over 8 MiB
+are refused. No custom Utilibre return link has been injected into the UI.
+
+Build: docker build -f Dockerfile.utilibre -t utilibre-gothub:24bedc8-p2 .
+Run recipes, public gateway and network policy:
+https://github.com/mycelibre/utilibre/tree/main/deployment/community
+The archive includes the complete patched source, go.mod/go.sum and Dockerfile.
+No runtime credentials or private user content are required to build it.
