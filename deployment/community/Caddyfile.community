# Merge on the existing Caddy VM, preserving its TLS and trusted-proxy setup.
degoog.utilibre.org {
	encode zstd gzip
	reverse_proxy 10.10.1.43:3156 {
		header_up X-Real-IP {client_ip}
		header_up X-Forwarded-For {client_ip}
	}
}

# For proxied DNS, Caddy must trust ONLY Cloudflare networks before {client_ip}
# is used. Never trust visitor-supplied CF-Connecting-IP from arbitrary peers.
# These routes are for this app VM only. Do not expose port 3135 (Kuma admin).
# Rallly uses its restricted gateway and invitation-only Utilibre OIDC login.
# Public HTTPS still requires applying this file on that separate VM.
# Do not expose private evaluation ports 3143 or 3144. LRCLIB replaces Dumb on
# the existing lyrics.utilibre.org route (3142); no edge change is necessary.
# Rimgo (3153) likewise has an upstream media blocker; its block is prepared,
# not proof that the service is ready to launch.

bridge.utilibre.org {
	encode zstd gzip
	reverse_proxy 10.10.1.43:3120 {
		header_up X-Real-IP {client_ip}
		header_up X-Forwarded-For {client_ip}
	}
}
notify.utilibre.org {
	request_body {
		max_size 16KB
	}
	reverse_proxy 10.10.1.43:3121 {
		header_up X-Real-IP {client_ip}
		header_up X-Forwarded-For {client_ip}
		flush_interval -1
	}
}
secret.utilibre.org {
	request_body {
		max_size 16KB
	}
	header Cache-Control no-store
	reverse_proxy 10.10.1.43:3122 {
		header_up X-Real-IP {client_ip}
		header_up X-Forwarded-For {client_ip}
	}
}
drop.utilibre.org {
	request_body {
		max_size 64KB
	}
	reverse_proxy 10.10.1.43:3124 {
		header_up X-Real-IP {client_ip}
		header_up X-Forwarded-For {client_ip}
	}
}
status.utilibre.org {
	encode zstd gzip
	reverse_proxy 10.10.1.43:3125
}

poll.utilibre.org {
	encode zstd gzip
	reverse_proxy 10.10.1.43:3123 {
		header_up X-Real-IP {client_ip}
		header_up X-Forwarded-For {client_ip}
	}
}

