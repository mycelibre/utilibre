new file mode 100644
index 0000000..011e04a
--- /dev/null
+++ b/deployment/translite-gateway.conf
@@ -0,0 +1,75 @@
+worker_processes 1;
+pid /tmp/nginx.pid;
+error_log /dev/null;
+events { worker_connections 128; }
+http {
+  include /etc/nginx/mime.types;
+  access_log off;
+  server_tokens off;
+  client_body_temp_path /tmp/client;
+  fastcgi_temp_path /tmp/fastcgi;
+  proxy_temp_path /tmp/proxy;
+  uwsgi_temp_path /tmp/uwsgi;
+  scgi_temp_path /tmp/scgi;
+  set_real_ip_from 10.10.1.3;
+  real_ip_header X-Forwarded-For;
+  real_ip_recursive on;
+  limit_req_zone $binary_remote_addr zone=translate_client:2m rate=12r/m;
+  limit_req_zone $server_name zone=translate_global:1m rate=40r/m;
+  limit_conn_zone $binary_remote_addr zone=translate_connections:1m;
+  limit_req_status 429;
+  limit_conn_status 429;
+  map "$request_method:$http_sec_fetch_site" $cross_site_write {
+    default 0;
+    "POST:cross-site" 1;
+  }
+  map $http_origin $bad_origin {
+    default 1;
+    "" 0;
+    "https://translate.utilibre.org" 0;
+  }
+  server {
+    listen 8080;
+    root /app/public;
+    client_max_body_size 24k;
+    client_body_buffer_size 24k;
+    client_body_timeout 10s;
+    limit_conn translate_connections 4;
+    if ($request_method !~ ^(GET|HEAD|POST)$) { return 405; }
+    if ($bad_origin) { return 403; }
+    if ($cross_site_write) { return 403; }
+    add_header Cache-Control "no-store" always;
+    add_header Referrer-Policy same-origin always;
+    add_header X-Content-Type-Options nosniff always;
+    add_header X-Frame-Options DENY always;
+    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
+    add_header Content-Security-Policy "default-src 'none'; style-src 'self' 'unsafe-inline'; script-src 'self'; img-src 'self'; connect-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'none'" always;
+    location = /healthz { return 200 "ok\n"; }
+    location /static/ {
+      if ($request_method !~ ^(GET|HEAD)$) { return 405; }
+      try_files $uri =404;
+    }
+    location /utilibre-source/ {
+      if ($request_method !~ ^(GET|HEAD)$) { return 405; }
+      alias /srv/utilibre-source/;
+      autoindex off;
+    }
+    location = /api/tts { return 404; }
+    location ~ ^/(\.git|config|parsers|pages|tests|Dockerfile|composer) { return 404; }
+    location ~ ^/(|settings|settings/set|settings/reset|api|api/translate|api/get_languages|api/additional_data|api/swap|api/toengine/(google|deepl|yandex|ddg|multi)|api/clear_text)$ {
+      limit_req zone=translate_client burst=15 nodelay;
+      limit_req zone=translate_global burst=20 nodelay;
+      include /etc/nginx/fastcgi_params;
+      fastcgi_param SCRIPT_FILENAME /app/public/index.php;
+      fastcgi_param SCRIPT_NAME /index.php;
+      fastcgi_param HTTPS on;
+      fastcgi_param HTTP_PROXY "";
+      fastcgi_param HTTP_AUTHORIZATION "";
+      fastcgi_pass 172.29.89.10:9000;
+      fastcgi_read_timeout 50s;
+      fastcgi_buffering off;
+      fastcgi_max_temp_file_size 0;
+    }
+    location / { return 404; }
+  }
+}
