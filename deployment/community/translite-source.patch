diff --git a/parsers/utilibre-http.php b/parsers/utilibre-http.php
new file mode 100644
index 0000000..26f3411
--- /dev/null
+++ b/parsers/utilibre-http.php
@@ -0,0 +1,55 @@
+<?php
+// Fixed upstreams, public pinned IPv4, verified HTTPS, no redirects or proxy.
+function utilibre_valid_url(string $url): bool {
+    $p = parse_url($url);
+    return $p !== false && ($p['scheme'] ?? '') === 'https'
+        && in_array(strtolower($p['host'] ?? ''), [
+            'translate.googleapis.com', 'translate.google.com', 'www2.deepl.com',
+            'dict.deepl.com', 'translate.yandex.net', 'dictionary.yandex.net', 'duckduckgo.com',
+        ], true)
+        && !isset($p['user']) && !isset($p['pass']) && !isset($p['fragment'])
+        && (!isset($p['port']) || $p['port'] === 443);
+}
+function utilibre_public_ip(string $ip): bool {
+    if (!filter_var($ip, FILTER_VALIDATE_IP, FILTER_FLAG_IPV4 | FILTER_FLAG_NO_PRIV_RANGE | FILTER_FLAG_NO_RES_RANGE)) return false;
+    $n = ip2long($ip);
+    foreach (['100.64.0.0/10', '192.0.0.0/24', '198.18.0.0/15'] as $cidr) {
+        [$base, $bits] = explode('/', $cidr);
+        $mask = -1 << (32 - (int)$bits);
+        if (($n & $mask) === (ip2long($base) & $mask)) return false;
+    }
+    return true;
+}
+function utilibre_fetch(string $url, $postFields = null, $headers = null): array {
+    if (!utilibre_valid_url($url)) throw new UpstreamException('Destination denied');
+    $host = parse_url($url, PHP_URL_HOST);
+    if (apcu_exists('cooldown_' . $host)) throw new UpstreamException('Provider temporarily unavailable; try again later.');
+    $addresses = gethostbynamel($host);
+    if (!$addresses) throw new UpstreamException('Provider resolution failed');
+    foreach ($addresses as $ip) if (!utilibre_public_ip($ip)) throw new UpstreamException('Address denied');
+    $body = '';
+    $ch = curl_init($url);
+    curl_setopt_array($ch, [
+        CURLOPT_RETURNTRANSFER => false, CURLOPT_FOLLOWLOCATION => false,
+        CURLOPT_PROTOCOLS => CURLPROTO_HTTPS, CURLOPT_REDIR_PROTOCOLS => CURLPROTO_HTTPS,
+        CURLOPT_PROXY => '', CURLOPT_IPRESOLVE => CURL_IPRESOLVE_V4,
+        CURLOPT_RESOLVE => ["$host:443:" . $addresses[0]],
+        CURLOPT_CONNECTTIMEOUT => 5, CURLOPT_TIMEOUT => 15, CURLOPT_ENCODING => '',
+        CURLOPT_SSL_VERIFYPEER => true, CURLOPT_SSL_VERIFYHOST => 2,
+        CURLOPT_WRITEFUNCTION => static function ($ch, string $chunk) use (&$body): int {
+            if (strlen($body) + strlen($chunk) > 2 * 1024 * 1024) return 0;
+            $body .= $chunk;
+            return strlen($chunk);
+        },
+    ]);
+    if ($postFields !== null) curl_setopt($ch, CURLOPT_POSTFIELDS, $postFields);
+    if ($headers !== null) curl_setopt($ch, CURLOPT_HTTPHEADER, $headers);
+    $ok = curl_exec($ch);
+    $status = curl_getinfo($ch, CURLINFO_RESPONSE_CODE);
+    $contentType = curl_getinfo($ch, CURLINFO_CONTENT_TYPE);
+    if ($ok === false || $status < 200 || $status >= 300) {
+        apcu_store('cooldown_' . $host, true, $status === 429 ? 120 : 30);
+        throw new UpstreamException('Provider temporarily unavailable' . ($status ? " (HTTP {$status})" : '') . '.');
+    }
+    return ['body' => $body, 'contentType' => $contentType];
+}
