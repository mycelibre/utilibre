+}
+
+export function publicAddress(value) {
+  try {return ipaddr.process(value).range() === 'unicast';} catch {return false;}
+}
+
+export function privateLookup(host, options, done) {
+  if (!hosts.has(host)) return done(new Error('Destination denied'));
+  lookup(host, {family: 4, all: true}, (error, addresses) => {
+    if (error || !addresses?.length || addresses.some(({address}) => !publicAddress(address))) {
+      return done(new Error('Upstream address unavailable'));
+    }
+    if (typeof options === 'object' && options.all) return done(null, addresses);
+    done(null, addresses[0].address, addresses[0].family);
+  });
+}
+
+export const upstreamAgent = new https.Agent({lookup: privateLookup, maxSockets: 4, keepAlive: true});
+
+export function retryDelay(value, now = Date.now()) {
+  const seconds = /^\d+$/.test(String(value)) ? Number(value) : (Date.parse(value) - now) / 1000;
+  return Number.isFinite(seconds) ? Math.max(600, Math.ceil(seconds)) : 600;
+}
+
+// Process-local, bounded by the fixed upstream set. No visitor keys.
+const cooldown = new Map();
+export function remainingCooldown(host, now = Date.now()) {
+  return Math.max(0, Math.ceil(((cooldown.get(host) || 0) - now) / 1000));
+}
+export function observeDenial(host, status, retry, now = Date.now()) {
+  if (!hosts.has(host) || ![403, 406, 429].includes(status)) return 0;
+  const seconds = retryDelay(retry, now);
+  cooldown.set(host, Math.max(cooldown.get(host) || 0, now + seconds * 1000));
+  return seconds;
+}
diff --git a/src/utils/safeHtml.mjs b/src/utils/safeHtml.mjs
new file mode 100644
