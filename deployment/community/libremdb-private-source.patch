--- /dev/null
+++ b/src/utils/safeHtml.mjs
@@ -0,0 +1,14 @@
+import sanitizeHtml from 'sanitize-html';
+
+// Preserve prose formatting, never executable HTML, embedded media or tracking.
+export function safeHtml(value) {
+  if (typeof value !== 'string' || value.length > 1024 * 1024) return '';
+  return sanitizeHtml(value, {
+    allowedTags: ['p', 'br', 'b', 'strong', 'i', 'em', 'ul', 'ol', 'li', 'blockquote', 'span', 'a'],
+    allowedAttributes: {a: ['href']}, allowedSchemes: [], allowProtocolRelative: false,
+    transformTags: {
+      a: (_tag, attrs) => ({tagName: 'a', attribs:
+        /^\/(?![\/\\])[^\\\x00-\x20]*$/.test(attrs.href || '') ? {href: attrs.href} : {}}),
+    },
+  });
+}
diff --git a/test/security.test.mjs b/test/security.test.mjs
new file mode 100644
index 0000000..ede400d
--- /dev/null
+++ b/test/security.test.mjs
@@ -0,0 +1,34 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import {checkedMediaURL, publicAddress, retryDelay, observeDenial, remainingCooldown} from '../src/utils/privateUpstream.mjs';
+import {safeHtml} from '../src/utils/safeHtml.mjs';
+
+test('media URLs require exact public HTTPS destinations', () => {
+  assert.equal(checkedMediaURL('https://m.media-amazon.com/images/M/example.jpg'), 'https://m.media-amazon.com/images/M/example.jpg');
+  for (const value of [undefined, ['https://m.media-amazon.com/a.jpg'], 'http://m.media-amazon.com/a.jpg',
+    'https://m.media-amazon.com.evil.test/a.jpg', 'https://m.media-amazon.com@127.0.0.1/a.jpg',
+    'https://user:password@m.media-amazon.com/a.jpg', 'https://127.0.0.1/a.jpg',
+    'https://m.media-amazon.com:8080/a.jpg', 'https://m.media-amazon.com/a.svg',
+    'https://m.media-amazon.com/a.jpg#fragment', 'https://m.media-amazon.com\\@evil.test/a.jpg']) {
+    assert.throws(() => checkedMediaURL(value));
+  }
+});
+test('private, reserved and mapped addresses are rejected', () => {
+  for (const address of ['127.0.0.1', '10.10.1.3', '169.254.169.254', '100.64.0.1', '192.0.2.1', '::1', '::ffff:127.0.0.1', 'fc00::1', '2001:db8::1', 'nonsense']) assert.equal(publicAddress(address), false, address);
+  assert.equal(publicAddress('1.1.1.1'), true);
+});
+test('untrusted prose cannot embed tracking, scripts, forms or external links', () => {
+  const html = safeHtml('<p>Hello <em>world</em><img src="https://tracker.test/a"><script>alert(1)</script><a href="javascript:alert(1)" onclick="alert(2)">bad</a><a href="//tracker.test/">external</a><a href="/title/tt123">local</a><form action="https://tracker.test/"><input></form></p>');
+  assert.match(html, /<em>world<\/em>/);
+  assert.match(html, /href="\/title\/tt123"/);
+  assert.doesNotMatch(html, /tracker|script|onclick|<img|<form|<input/);
+  assert.equal(safeHtml(null), '');
+});
+test('denial cooldown respects longer waits and separates hosts', () => {
+  assert.equal(retryDelay('0'), 600);
+  assert.equal(retryDelay('900'), 900);
+  assert.equal(retryDelay('Thu, 01 Jan 1970 00:20:00 GMT', 0), 1200);
+  observeDenial('m.media-amazon.com', 429, '1800', 0);
+  assert.equal(remainingCooldown('m.media-amazon.com', 1000), 1799);
+  assert.equal(remainingCooldown('api.graphql.imdb.com', 1000), 0);
+});
