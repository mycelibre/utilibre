new file mode 100644
index 0000000..c74a697
--- /dev/null
+++ b/Dockerfile.utilibre
@@ -0,0 +1,19 @@
+FROM node:24.21.0-bookworm-slim@sha256:d6aa754f16b3197301076f047b5def2f02ea1dbbc2ca920407d46d7ec7f87b20 AS build
+WORKDIR /app
+ENV NEXT_TELEMETRY_DISABLED=1 NODE_OPTIONS=--max-old-space-size=2048
+COPY package.json package-lock.json ./
+RUN npm ci --ignore-scripts --no-audit --no-fund
+COPY . .
+ENV NEXT_PUBLIC_URL=http://127.0.0.1:3144 NEXT_PUBLIC_INSTANCE_MAIN_URL=https://utilibre.org NEXT_PUBLIC_INSTANCE_NAME=Utilibre USE_REDIS=false
+RUN npm run test:security && npm run build -- --webpack
+
+FROM node:24.21.0-bookworm-slim@sha256:d6aa754f16b3197301076f047b5def2f02ea1dbbc2ca920407d46d7ec7f87b20
+WORKDIR /app
+ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 HOSTNAME=0.0.0.0 PORT=3000 USE_REDIS=false
+COPY --from=build --chown=node:node /app/.next/standalone ./
+COPY --from=build --chown=node:node /app/.next/static ./.next/static
+COPY --from=build --chown=node:node /app/public ./public
+COPY --from=build /app/LICENSE ./LICENSE
+USER node
+EXPOSE 3000
+CMD ["node", "server.js"]
diff --git a/UTILIBRE-SOURCE.txt b/UTILIBRE-SOURCE.txt
new file mode 100644
index 0000000..f06d19c
--- /dev/null
+++ b/UTILIBRE-SOURCE.txt
@@ -0,0 +1,36 @@
+LibreMDB private evaluation on Utilibre, 2026-10-06
+Upstream fork: https://github.com/darlopvil/libremdb-fork
+Revision: b233f4e24acfb4afbe55b7c13798832ca8068086
+Original project: https://github.com/zyachel/libremdb
+License: upstream AGPL notices and LICENSE retained.
+
+This is not a public launch. The IMDb GraphQL API explicitly excludes public
+use in its response, and a permitted public operating basis is unresolved.
+Its FOSS software license does not grant rights to IMDb's data.
+
+Compatibility/security patches: Node 24.21.0, Next 16.4.0, updated dependencies,
+modern Link/Image APIs, TypeScript fixes, exact media-host checks with checked
+public DNS answers passed directly to the TLS socket, no automatic redirects,
+fixed server-side request headers, bounded bodies/time/concurrency, host denial
+cooldowns and bounded ten-minute memory-only GraphQL cache with timed deletion.
+Visitor credentials/headers are not forwarded. Untrusted HTML is sanitized;
+same-origin CSP prevents automatic third-party browser connections. Error stacks
+are not rendered. Native operator metadata remains; no custom return link added.
+
+Build with the npm package-lock.json and Dockerfile.utilibre, not the upstream
+Dockerfile/pnpm lockfile. React 18 remains supported but deprecated by Next 16;
+React 19 migration is required before a future Next 17 upgrade.
+
+docker build -f Dockerfile.utilibre -t utilibre-libremdb:b233f4e-p1 .
+
+Use the explicit libremdb-review profile in Utilibre's compose.evaluation.yaml.
+Binding must remain 127.0.0.1:3144, with no public reverse-proxy route.
+UTILIBRE_PRIVATE_EVALUATION=true enables private GraphQL checks; absent/false
+fails closed. No upstream accounts, cookies, API keys or challenge solver.
+
+Tests: npm run test:security; Utilibre deployment/community/check-libremdb-private.mjs.
+Verified sample: search Up, title tt1049413, visible proxied images on desktop
+and mobile, no automatic third-party requests, malformed media URLs rejected.
+Trailers, every movie/person/list and all upstream schema variations are not
+certified by this sample. Media responses are bounded to 16 MiB per request.
+No automatic public launch, public monitoring or instance-list submission.
