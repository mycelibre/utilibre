diff --git a/utils/outbound.go b/utils/outbound.go
new file mode 100644
index 0000000..bb2e4a8
--- /dev/null
+++ b/utils/outbound.go
@@ -0,0 +1,124 @@
+package utils
+
+// Utilibre deployment hardening: fixed public Imgur destinations, bounded
+// response bodies and deadlines, including default HTTP clients.
+import (
+	"context"
+	"errors"
+	"io"
+	"net"
+	"net/http"
+	"net/netip"
+	"net/url"
+	"time"
+)
+
+const responseLimit int64 = 8 << 20
+
+var hosts = map[string]bool{
+	"imgur.com": true, "www.imgur.com": true, "api.imgur.com": true,
+	"i.imgur.com": true, "i.stack.imgur.com": true,
+}
+
+func allowedURL(u *url.URL) bool {
+	return u.Scheme == "https" && u.User == nil && (u.Port() == "" || u.Port() == "443") && hosts[u.Hostname()]
+}
+
+func publicIP(ip netip.Addr) bool {
+	ip = ip.Unmap()
+	if !ip.IsGlobalUnicast() || ip.IsPrivate() || ip.IsLoopback() || ip.IsLinkLocalUnicast() {
+		return false
+	}
+	for _, cidr := range []string{"0.0.0.0/8", "100.64.0.0/10", "192.0.0.0/24", "192.0.2.0/24", "198.18.0.0/15", "198.51.100.0/24", "203.0.113.0/24", "240.0.0.0/4", "2001:db8::/32"} {
+		if netip.MustParsePrefix(cidr).Contains(ip) {
+			return false
+		}
+	}
+	return true
+}
+
+func publicDial(ctx context.Context, network, address string) (net.Conn, error) {
+	host, port, err := net.SplitHostPort(address)
+	if err != nil || !hosts[host] || port != "443" {
+		return nil, errors.New("upstream destination denied")
+	}
+	addresses, err := net.DefaultResolver.LookupNetIP(ctx, "ip", host)
+	if err != nil {
+		return nil, err
+	}
+	for _, ip := range addresses {
+		if !publicIP(ip) {
+			return nil, errors.New("non-public upstream address denied")
+		}
+	}
+	dialer := net.Dialer{Timeout: 8 * time.Second}
+	for _, ip := range addresses {
+		connection, e := dialer.DialContext(ctx, network, net.JoinHostPort(ip.String(), port))
+		if e == nil {
+			return connection, nil
+		}
+	}
+	return nil, errors.New("upstream connection failed")
+}
+
+type boundedBody struct {
+	io.ReadCloser
+	remaining int64
+	cancel    context.CancelFunc
+}
+
+func (b *boundedBody) Read(p []byte) (int, error) {
+	if b.remaining <= 0 {
+		b.Close()
+		return 0, errors.New("upstream response exceeds size limit")
+	}
+	if int64(len(p)) > b.remaining {
+		p = p[:b.remaining]
+	}
+	n, err := b.ReadCloser.Read(p)
+	b.remaining -= int64(n)
+	return n, err
+}
+func (b *boundedBody) Close() error { b.cancel(); return b.ReadCloser.Close() }
+
+type publicTransport struct{ inner http.RoundTripper }
+
+func (t publicTransport) RoundTrip(request *http.Request) (*http.Response, error) {
+	if !allowedURL(request.URL) || (request.Method != "GET" && request.Method != "HEAD") {
+		return nil, errors.New("upstream request denied")
+	}
+	ctx, cancel := context.WithTimeout(request.Context(), 20*time.Second)
+	safe := request.Clone(ctx)
+	safe.Header.Del("Cookie")
+	safe.Header.Del("Authorization")
+	safe.Header.Del("Proxy-Authorization")
+	response, err := t.inner.RoundTrip(safe)
+	if err != nil {
+		cancel()
+		return nil, err
+	}
+	limit := responseLimit
+	if request.URL.Hostname() == "i.imgur.com" || request.URL.Hostname() == "i.stack.imgur.com" {
+		limit = 128 << 20
+	}
+	if response.ContentLength > limit {
+		response.Body.Close()
+		cancel()
+		return nil, errors.New("upstream response exceeds size limit")
+	}
+	response.Body = &boundedBody{response.Body, limit, cancel}
+	return response, nil
+}
+
+func init() {
+	transport := &http.Transport{DialContext: publicDial, TLSHandshakeTimeout: 8 * time.Second,
+		ResponseHeaderTimeout: 12 * time.Second, MaxResponseHeaderBytes: 64 << 10,
+		MaxIdleConns: 20, MaxIdleConnsPerHost: 4, MaxConnsPerHost: 16, IdleConnTimeout: 30 * time.Second}
+	http.DefaultTransport = publicTransport{transport}
+	http.DefaultClient = &http.Client{Timeout: 20 * time.Second, CheckRedirect: func(req *http.Request, via []*http.Request) error {
+		if len(via) >= 4 || !allowedURL(req.URL) {
+			return errors.New("upstream redirect denied")
+		}
+		return nil
+	}}
+}
diff --git a/utils/outbound_test.go b/utils/outbound_test.go
new file mode 100644
index 0000000..4a097df
--- /dev/null
+++ b/utils/outbound_test.go
@@ -0,0 +1,30 @@
+package utils
+
+import (
+	"net/netip"
+	"net/url"
+	"testing"
+)
+
+func TestDestinationPolicy(t *testing.T) {
+	for _, raw := range []string{"http://github.com/", "https://github.com:8443/", "https://github.com.evil.invalid/", "https://token@github.com/", "https://127.0.0.1/", "https://example.org/"} {
+		u, _ := url.Parse(raw)
+		if allowedURL(u) {
+			t.Fatalf("accepted %s", raw)
+		}
+	}
+	for _, raw := range []string{"https://imgur.com/a/j2sOQkJ", "https://i.imgur.com/example.jpg"} {
+		u, _ := url.Parse(raw)
+		if !allowedURL(u) {
+			t.Fatalf("rejected %s", raw)
+		}
+	}
+	for _, raw := range []string{"127.0.0.1", "10.10.1.20", "169.254.169.254", "100.64.0.1", "::1", "::ffff:10.10.1.20", "fc00::1", "fe80::1", "192.0.2.1"} {
+		if publicIP(netip.MustParseAddr(raw)) {
+			t.Fatalf("accepted %s", raw)
+		}
+	}
+	if !publicIP(netip.MustParseAddr("140.82.112.3")) {
+		t.Fatal("public GitHub IP rejected")
+	}
+}
