-}
\ No newline at end of file
+type boundedCache struct {
+	inner *cache.Cache
+	lock  sync.Mutex
+}
+
+func (c *boundedCache) Get(key string) (interface{}, bool) { return c.inner.Get(key) }
+func (c *boundedCache) Set(key string, value interface{}, duration time.Duration) {
+	encoded, err := json.Marshal(value)
+	if err != nil || len(encoded) > 256<<10 {
+		return
+	}
+	c.lock.Lock()
+	defer c.lock.Unlock()
+	if c.inner.ItemCount() >= 128 {
+		c.inner.Flush()
+	}
+	c.inner.Set(key, value, duration)
+}
+
+func NewClient(clientId string) *Client {
+	client := Client{
+		ClientID: clientId,
+		Cache:    &boundedCache{inner: cache.New(15*time.Minute, 15*time.Minute)},
+	}
+
+	return &client
+}
