diff --git a/extractor/twitch/parser_utilibre_test.go b/extractor/twitch/parser_utilibre_test.go
new file mode 100644
index 0000000..2a0e29c
--- /dev/null
+++ b/extractor/twitch/parser_utilibre_test.go
@@ -0,0 +1,19 @@
+package twitch
+
+import (
+	"encoding/base64"
+	"strings"
+	"testing"
+)
+
+func TestProxyURLUsesURLSafeBase64(t *testing.T) {
+	t.Setenv("URL", "https://twitch.example")
+	upstream := "https://video.ttvnw.net/example???token=+++///&more=true"
+	for _, target := range []string{StreamSegmentProxyUrl(upstream), StreamSubProxyUrl(upstream, false)} {
+		encoded := strings.SplitN(target, "/proxy/stream/", 2)[1]
+		encoded = strings.SplitN(encoded, "/", 2)[1]
+		if strings.ContainsAny(encoded, "/+") { t.Fatal("path-unsafe base64") }
+		decoded, err := base64.URLEncoding.DecodeString(encoded)
+		if err != nil || string(decoded) != upstream { t.Fatal("proxy URL does not round-trip") }
+	}
+}
