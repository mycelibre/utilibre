+++ b/outbound_test.go
@@ -0,0 +1,27 @@
+package main
+
+import (
+	"net/netip"
+	"net/url"
+	"testing"
+)
+
+func TestOutboundPolicy(t *testing.T) {
+	for _, raw := range []string{"https://127.0.0.1/", "http://gql.twitch.tv/gql", "https://gql.twitch.tv.evil.invalid/", "https://user@gql.twitch.tv/", "https://example.org/", "https://gql.twitch.tv:8443/"} {
+		u, _ := url.Parse(raw)
+		if allowedURL(u) {
+			t.Fatalf("accepted %s", raw)
+		}
+	}
+	for _, raw := range []string{"https://gql.twitch.tv/gql", "https://usher.ttvnw.net/api/channel/hls/test.m3u8", "https://static-cdn.jtvnw.net/example.png", "https://video-weaver.test.hls.ttvnw.net/segment.ts"} {
+		u, _ := url.Parse(raw)
+		if !allowedURL(u) {
+			t.Fatalf("rejected %s", raw)
+		}
+	}
+	for _, raw := range []string{"10.10.1.20", "127.0.0.1", "169.254.169.254", "100.64.0.1", "::1", "fc00::1", "::ffff:192.168.0.1"} {
+		if publicIP(netip.MustParseAddr(raw)) {
+			t.Fatalf("accepted %s", raw)
+		}
+	}
+}
