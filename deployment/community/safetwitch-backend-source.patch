 func ProxyUrl(url string) string {
+	// A missing upstream thumbnail is not a fetchable URL. Preserve its layout
+	// without sending the browser to a nonexistent /proxy/img/ endpoint.
+	if url == "" {
+		return "data:image/gif;base64,R0lGODlhAQABAAD/ACwAAAAAAQABAAACADs="
+	}
 	encodedUrl := b64.URLEncoding.EncodeToString([]byte(url))
 	backendUrl := os.Getenv("URL")
 
