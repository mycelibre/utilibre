diff --git a/handlers/utilibre_failure_test.go b/handlers/utilibre_failure_test.go
new file mode 100644
index 0000000..753dc20
--- /dev/null
+++ b/handlers/utilibre_failure_test.go
@@ -0,0 +1,78 @@
+package handlers
+
+import (
+	"github.com/gorilla/mux"
+	"github.com/rramiachraf/dumb/utils"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+	"time"
+)
+
+type utilibreDiscard struct{}
+
+func (utilibreDiscard) Write(p []byte) (int, error) { return len(p), nil }
+func (utilibreDiscard) Close() error                { return nil }
+
+type utilibreTransport func(*http.Request) (*http.Response, error)
+
+func (f utilibreTransport) RoundTrip(r *http.Request) (*http.Response, error) { return f(r) }
+func TestUtilibreFailureNeverCached(t *testing.T) {
+	for _, status := range []int{http.StatusForbidden, http.StatusOK} {
+		t.Run(http.StatusText(status), func(t *testing.T) {
+			original := http.DefaultTransport
+			defer func() { http.DefaultTransport = original }()
+			calls := 0
+			http.DefaultTransport = utilibreTransport(func(r *http.Request) (*http.Response, error) {
+				calls++
+				code := status
+				body := "<html>Fictional refusal, no lyrics</html>"
+				if calls > 1 {
+					code = 200
+					body = `<div data-lyrics-container="true">Fictional test stanza</div>`
+				}
+				return &http.Response{StatusCode: code, Header: http.Header{"Content-Type": []string{"text/html"}}, Body: io.NopCloser(strings.NewReader(body)), Request: r}, nil
+			})
+			name := "utilibre-fictional-" + http.StatusText(status)
+			handler := lyrics(utils.NewLogger(utilibreDiscard{}))
+			request := func() *httptest.ResponseRecorder {
+				r := mux.SetURLVars(httptest.NewRequest("GET", "/fictional-lyrics", nil), map[string]string{"artist-song": name})
+				w := httptest.NewRecorder()
+				handler.ServeHTTP(w, r)
+				return w
+			}
+			first := request()
+			if first.Code != 502 || first.Header().Get("Cache-Control") != "no-store" {
+				t.Fatalf("refusal falsely succeeded: %d", first.Code)
+			}
+			second := request()
+			if second.Code != 200 || !strings.Contains(second.Body.String(), "Fictional test stanza") {
+				t.Fatal("Refusal was cached or fixture could not recover")
+			}
+			third := request()
+			if third.Code != 200 || calls != 2 {
+				t.Fatalf("Successful native caching was removed: %d calls", calls)
+			}
+		})
+	}
+}
+func TestUtilibreSearchRefusalStatus(t *testing.T) {
+	original := http.DefaultTransport
+	defer func() { http.DefaultTransport = original }()
+	http.DefaultTransport = utilibreTransport(func(r *http.Request) (*http.Response, error) {
+		return &http.Response{StatusCode: 403, Header: http.Header{"Content-Type": []string{"text/html"}}, Body: io.NopCloser(strings.NewReader("fictional refusal")), Request: r}, nil
+	})
+	w := httptest.NewRecorder()
+	search(utils.NewLogger(utilibreDiscard{})).ServeHTTP(w, httptest.NewRequest("GET", "/search?q=fictional", nil))
+	if w.Code != 502 || w.Header().Get("Cache-Control") != "no-store" {
+		t.Fatal("Search refusal must not be cacheable success")
+	}
+}
+func TestUtilibreBoundedNativeCache(t *testing.T) {
+	c := boundedCacheConfig()
+	if c.LifeWindow != 24*time.Hour || c.HardMaxCacheSize != 32 || c.Shards != 16 {
+		t.Fatal("Native expiry or cache bounds changed")
+	}
+}
