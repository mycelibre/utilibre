--- /dev/null
+++ b/data/utilibre_render_test.go
@@ -0,0 +1,29 @@
+package data
+
+import (
+	"github.com/PuerkitoBio/goquery"
+	"strings"
+	"testing"
+)
+
+func TestUtilibreLocalPlaceholder(t *testing.T) {
+	if got := ExtractImageURL("https://assets.genius.com/images/default_cover_image.png"); got != "/static/default_cover_image.svg" {
+		t.Fatal(got)
+	}
+	if got := ExtractImageURL("https://images.genius.com/fictional.png"); got != "/images/fictional.png" {
+		t.Fatal(got)
+	}
+}
+func TestUtilibreRemoveEmptyStyledSpans(t *testing.T) {
+	doc, err := goquery.NewDocumentFromReader(strings.NewReader(`<div data-lyrics-container="true">Fictional line<span tabindex="0" style="position:absolute"></span><span>Kept text</span></div>`))
+	if err != nil {
+		t.Fatal(err)
+	}
+	var song Song
+	if err = song.parseLyrics(doc); err != nil {
+		t.Fatal(err)
+	}
+	if strings.Contains(song.Lyrics, "style=") || !strings.Contains(song.Lyrics, "Kept text") {
+		t.Fatal("Empty style removal changed useful text or left an empty tab stop")
+	}
+}
diff --git a/handlers/cache.go b/handlers/cache.go
index 9ceab9e..3103ff5 100644
--- a/handlers/cache.go
+++ b/handlers/cache.go
@@ -16 +16,11 @@ type cachable interface {
-var c, _ = bigcache.New(context.Background(), bigcache.DefaultConfig(time.Hour*24))
+// Preserve native 24-hour public-content expiry, with bounded memory.
+var c, _ = bigcache.New(context.Background(), boundedCacheConfig())
+
+func boundedCacheConfig() bigcache.Config {
+	config := bigcache.DefaultConfig(time.Hour * 24)
+	config.Shards = 16
+	config.MaxEntriesInWindow = 1024
+	config.MaxEntrySize = 4096
+	config.HardMaxCacheSize = 32
+	return config
+}
