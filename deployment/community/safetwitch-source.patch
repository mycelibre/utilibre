diff --git a/Dockerfile.utilibre b/Dockerfile.utilibre
new file mode 100644
index 0000000..b1492f7
--- /dev/null
+++ b/Dockerfile.utilibre
@@ -0,0 +1,18 @@
+# Context: SafeTwitch caeb85a77be3b18a6916d2caa626d09e94d1f8b2 plus published patch.
+FROM node:24.14.0-alpine3.23@sha256:7fddd9ddeae8196abf4a3ef2de34e11f7b1a722119f91f28ddf1e99dcafdf114 AS build
+WORKDIR /src
+COPY package.json package-lock.json ./
+RUN npm ci --ignore-scripts --no-audit
+COPY . .
+ENV SAFETWITCH_BACKEND_DOMAIN=twitch.utilibre.org \
+    SAFETWITCH_INSTANCE_DOMAIN=twitch.utilibre.org \
+    SAFETWITCH_HTTPS=true \
+    SAFETWITCH_DEFAULT_LOCALE=en-US \
+    SAFETWITCH_FALLBACK_LOCALE=en-US \
+    SAFETWITCH_DEFAULT_THEME=dark \
+    SAFETWITCH_CHAT_ENABLED=false
+RUN npm run build
+FROM nginxinc/nginx-unprivileged:1.28-alpine@sha256:7377697a821c131a924a7105fafbe7414db4e9fcc77a6f08f776f33f141ec3f8
+COPY --from=build /src/dist /app
+USER 101:101
+ENTRYPOINT ["nginx", "-g", "daemon off;"]
diff --git a/UTILIBRE-SOURCE.txt b/UTILIBRE-SOURCE.txt
new file mode 100644
index 0000000..0c46f46
--- /dev/null
+++ b/UTILIBRE-SOURCE.txt
@@ -0,0 +1,20 @@
+Utilibre SafeTwitch frontend, 2026-10-06
+Upstream: https://codeberg.org/SafeTwitch/safetwitch
+Revision: caeb85a77be3b18a6916d2caa626d09e94d1f8b2 (2.4.5)
+Translations: https://codeberg.org/SafeTwitch/safetwitch-translations
+Translation revision: 830be6ece56dbffaadbbad4d435feababc030584 (included)
+License: AGPL-3.0; upstream and translation licenses/notices preserved.
+
+Changes: current locked dependencies, static Node 24 build, disabled production
+devtools, URL-protocol validation for profile links, disabled live-chat component,
+instance-specific EN/ES privacy text and corresponding-source links, undefined
+route/array guards required by current TypeScript. No custom Utilibre return UI.
+Build: docker build -f Dockerfile.utilibre -t utilibre-safetwitch:caeb85a-p1 .
+The public domain/native locale settings are in that Dockerfile.
+Deploy with the matching gateway/compose/firewall from:
+https://github.com/mycelibre/utilibre/tree/main/deployment/community
+
+The remaining npm audit findings concern braces and dependent build-time glob
+tools processing this fixed source tree. They are not installed in the static
+nginx runtime or shipped as browser modules. Do not use this build toolchain to
+compile untrusted visitor-supplied projects. This is not an independent audit.
