# Disabled public option; reviewed 2026-10-07 for a standard Hetzner auction uplink.
# No credential here. Requires the REAL NAT IPv4 and renewed TLS files separately.
UTILIBRE_TURN_BIND_IP=10.10.1.43
UTILIBRE_TURN_HOST=turn.utilibre.org
UTILIBRE_TURN_CAPACITY_APPROVED=yes
# Allocations are not people. Coturn counts input/output separately, in bytes/s.
