# Bounded public profile; activated independently of Galene on 2026-10-11.
# No credential here. Requires the REAL NAT IPv4 and renewed TLS files separately.
UTILIBRE_TURN_BIND_IP=10.10.1.43
UTILIBRE_TURN_HOST=turn.utilibre.org
UTILIBRE_TURN_CAPACITY_APPROVED=yes
# Allocations are not people. Coturn counts input/output separately, in bytes/s.
UTILIBRE_TURN_TOTAL_QUOTA=8
UTILIBRE_TURN_MAX_BPS=125000
UTILIBRE_TURN_TOTAL_BPS=1000000
# Eight max-bps reservations fit this aggregate budget. Allocations are not users.
# Listeners 3479 TCP/UDP, 5350 TCP TLS; relay 49700–49731 UDP.
# UTILIBRE_TURN_PUBLIC_IP is intentionally absent: never guess a NAT address.
