[Unit]
Description=Run Family Chess native game and expired-session cleanup
After=docker.service
[Service]
Type=oneshot
UMask=0077
Nice=10
CPUQuota=100%
MemoryMax=128M
ExecStart=/usr/bin/docker compose -f /home/ubuntu/freetools/deployment/family-chess/compose.yaml exec -T app python manage.py cleanup_games
ExecStart=/usr/bin/docker compose -f /home/ubuntu/freetools/deployment/family-chess/compose.yaml exec -T app python manage.py clearsessions
