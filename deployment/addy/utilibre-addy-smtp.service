[Unit]
Description=Utilibre addy private SMTP with gateway-only ingress
After=docker.service utilibre-addy-firewall.service
Requires=docker.service utilibre-addy-firewall.service
PartOf=docker.service
StartLimitIntervalSec=120
StartLimitBurst=5
[Service]
Type=simple
WorkingDirectory=/home/ubuntu/freetools/deployment/addy
ExecStartPre=/home/ubuntu/freetools/deployment/addy/start-smtp.sh
ExecStart=/usr/bin/docker compose up --no-recreate --no-deps --abort-on-container-exit --no-attach app app
ExecStop=/usr/bin/docker compose stop --timeout 15 app
ExecStopPost=/home/ubuntu/freetools/deployment/addy/firewall.sh
Restart=always
RestartSec=10
TimeoutStopSec=30
[Install]
WantedBy=multi-user.target
