# User-authorized existing Proxmox Mail Gateway, verified 2026-10-09.
# Fixed native hostname lookup maps this certificate name to10.10.1.20.
POSTFIX_RELAYHOST=[mx.mailgt.dev]:26
POSTFIX_SMTP_TLS=secure
POSTFIX_RELAYHOST_AUTH_ENABLE=false
POSTFIX_RELAYHOST_SSL_ENCRYPTION=false
# Native local sender authentication; no message classification or local signing.
RSPAMD_ENABLE=true
RSPAMD_NO_LOCAL_ADDRS=true
RSPAMD_GREYLIST_ENABLE=false
