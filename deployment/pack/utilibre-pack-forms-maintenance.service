[Unit]
Description=Native LiberaForms expiry and purge maintenance
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
WorkingDirectory=/home/ubuntu/freetools
ExecStart=/root/.nvm/versions/node/v24.14.0/bin/node deployment/pack/maintain-forms.mjs
UMask=0077
Nice=10
TimeoutStartSec=5min
StandardOutput=null
StandardError=null
