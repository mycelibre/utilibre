FROM golang:1.26.9-alpine@sha256:3082400e369fa24d5fc60bca20edab3f6d604e0c5a690ec66b295eff4dd87ade AS builder
ENV GOTOOLCHAIN=local GOTELEMETRY=off GOFLAGS=-mod=readonly
WORKDIR /src
COPY . .
ENV GOMAXPROCS=2 CGO_ENABLED=0
RUN go build -p 2 -trimpath -ldflags='-s -w' -o /out/galene . && go test -p 2 ./group ./token ./ice
FROM alpine:3.24@sha256:294b683cb724975bec92580e1e685676bd4b50bda910ddb8c51d4cabeaec77e6
WORKDIR /app
COPY --from=builder /out/galene /app/galene
COPY static /app/static
COPY LICENCE /app/LICENCE
# Native preference only: one video layer fits this four-person room's relay
# budget. Fail on upstream drift; remove after default-auto relay tests pass.
RUN test "$(grep -Fc '<option value="auto" selected>auto</option>' static/galene.html)" = 1 \
 && test "$(grep -Fc '<option value="off">off</option>' static/galene.html)" = 1 \
 && sed -i 's/<option value="auto" selected>auto<\/option>/<option value="auto">auto<\/option>/; s/<option value="off">off<\/option>/<option value="off" selected>off<\/option>/' static/galene.html
USER 4003:4003
ENTRYPOINT ["/app/galene"]
