[Unit]
Description=Utilibre private reading with mandatory bounded egress
After=docker.service network-online.target
Requires=docker.service
PartOf=docker.service
StartLimitIntervalSec=120
StartLimitBurst=5
[Service]
Type=simple
WorkingDirectory=/home/ubuntu/freetools/deployment/pack/wallabag
ExecStartPre=/bin/sh /home/ubuntu/freetools/deployment/pack/wallabag/firewall.sh
ExecStart=/usr/bin/docker compose -f compose.yaml -f compose.edge.yaml up --no-recreate --abort-on-container-exit
ExecStop=/usr/bin/docker compose -f compose.yaml -f compose.edge.yaml stop --timeout 15
Restart=always
RestartSec=10
TimeoutStopSec=30
StandardOutput=null
StandardError=null
[Install]
WantedBy=multi-user.target
