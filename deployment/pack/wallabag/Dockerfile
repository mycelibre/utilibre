# Build context is generated by build.mjs, never the live source/data directory.
FROM alpine:3.24@sha256:294b683cb724975bec92580e1e685676bd4b50bda910ddb8c51d4cabeaec77e6 AS app
RUN apk add --no-cache ca-certificates icu-data-full \
    php84 php84-bcmath php84-ctype php84-curl php84-dom php84-fileinfo \
    php84-fpm php84-gd php84-gettext php84-iconv php84-intl php84-mbstring \
    php84-opcache php84-openssl php84-pdo_sqlite php84-phar php84-session \
    php84-simplexml php84-sockets php84-sodium php84-tidy php84-tokenizer \
    php84-xml php84-xmlreader php84-xmlwriter php84-zip php84-zlib \
    && ln -s /usr/bin/php84 /usr/bin/php
WORKDIR /app
COPY app app
COPY bin/console bin/console
COPY src src
COPY templates templates
COPY vendor vendor
COPY migrations migrations
COPY translations translations
COPY web web
COPY .env composer.json composer.lock COPYING.md CREDITS.md ./
COPY review/php-fpm.conf /etc/php84/php-fpm.conf
COPY review/custom.css web/custom.css
RUN mkdir -p data/db var/cache var/sessions var/logs \
    && chown -R 4007:4007 data var
USER 4007:4007
ENTRYPOINT ["php-fpm84", "-F", "-y", "/etc/php84/php-fpm.conf"]

FROM nginxinc/nginx-unprivileged:1.28-alpine@sha256:7377697a821c131a924a7105fafbe7414db4e9fcc77a6f08f776f33f141ec3f8 AS web
COPY --from=app /app/web /srv/wallabag
COPY review/nginx.conf /etc/nginx/nginx.conf
USER 101:101
ENTRYPOINT ["nginx", "-g", "daemon off;"]
