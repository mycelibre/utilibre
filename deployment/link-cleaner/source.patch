+// A fragment may carry a document-access key; the optional redacted report must hide it.
+test("redacted audit hides fragment secrets while cleaned output preserves them", () => {
+  const result = cleanUrl("https://example.invalid/doc?utm_source=fixture#private-fixture-key");
