diff --git a/unfurl/tests/unit/test_utilibre.py b/unfurl/tests/unit/test_utilibre.py
new file mode 100644
index 0000000..9addaf1
--- /dev/null
+++ b/unfurl/tests/unit/test_utilibre.py
@@ -0,0 +1,41 @@
+import os
+import unittest
+import requests
+from unittest.mock import patch
+from unfurl.core import Unfurl
+from unfurl.tests.http_mocks import FakeResponse, patch_requests_get
+
+class HeadersOnly(unittest.TestCase):
+    def setUp(self):
+        head = patch('requests.head', side_effect=lambda *a, **kw: requests.get(*a, **kw))
+        head.start()
+        self.addCleanup(head.stop)
+
+    def run_url(self, value):
+        u = Unfurl(remote_lookups=True)
+        u.add_to_queue(data_type="url", key=None, value=value)
+        u.parse_queue()
+        return u
+
+    @patch.dict(os.environ, {"UNFURL_HEADER_ONLY":"true"})
+    def test_relative_redirect_and_no_body_or_hash_enrichment(self):
+        response = FakeResponse(302, {"Location":"/final"})
+        with patch_requests_get({"/start":response}) as calls:
+            u = self.run_url("https://example.invalid/start")
+        self.assertIn("https://example.invalid/final", calls)
+        self.assertTrue(response.closed)
+        self.assertLessEqual(len(calls), 10)
+        self.assertEqual(u.node_limit, 100)
+        with patch_requests_get({}) as calls:
+            self.run_url("5d41402abc4b2a76b9719d911017c592")
+        self.assertEqual(calls, [])
+
+    @patch.dict(os.environ, {"UNFURL_HEADER_ONLY":"true"})
+    def test_credentials_ports_and_cycle_bound(self):
+        for value in ("https://name:secret@example.invalid/", "http://example.invalid:8080/"):
+            with patch_requests_get({}) as calls:
+                self.run_url(value)
+            self.assertEqual(calls, [])
+        with patch_requests_get({"example.invalid":FakeResponse(302,{"Location":"https://example.invalid/start"})}) as calls:
+            self.run_url("https://example.invalid/start")
+        self.assertEqual(len(calls), 1)
