# DNS-only. Deliberately no encode, cache, visitor headers or access logger.
speed.utilibre.org {
	# Keep separate TCP connections for LibreSpeed's parallel transfer streams.
	# HTTPS and Caddy's normal TLS versions/ciphers remain unchanged.
	tls {
		alpn http/1.1
	}
	# Clear cached HTTP/3 advertisements for this hostname only.
	header Alt-Svc clear
	reverse_proxy 10.10.1.43:3225 {
		header_up -X-Forwarded-For
		header_up -X-Real-IP
		header_up -Forwarded
		header_up -CF-Connecting-IP
		transport http {
			dial_timeout 5s
			response_header_timeout 30s
		}
		flush_interval -1
	}
}
