FROM golang:1.27-alpine@sha256:8a5910f31396cd4d89662f56c68b3ae31d374308270a1c3bd96672ee5ed43414 AS build
WORKDIR /src
COPY . .
RUN CGO_ENABLED=0 GOEXPERIMENT=jsonv2 GOMAXPROCS=2 go build -p 2 -ldflags "-s -w" -o /wakapi main.go
FROM ghcr.io/muety/wakapi:2.18.1@sha256:e761af46c49ea381ceccbb6643ebc5ca5a644efc4ca5bf5b56ed01ca16808c25
COPY --from=build /wakapi /app/wakapi
