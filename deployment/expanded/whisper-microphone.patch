+
+const buffer=(...channels)=>({numberOfChannels:channels.length,length:channels[0].length,getChannelData:i=>new Float32Array(channels[i])});
+test('opposite-phase stereo is audible input, not digital silence',()=>{
+  assert.deepEqual([...monoForTranscription(buffer([0.2,-0.2],[-0.2,0.2]))],[Math.fround(0.2),Math.fround(-0.2)]);
+});
+test('near cancellation retains the stronger channel and leaves inputs intact',()=>{
+  const b=buffer([0.2,-0.2],[-0.199,0.199]);
+  assert.equal(monoForTranscription(b)[0],Math.fround(0.2));
+  assert.equal(b.getChannelData(1)[0],Math.fround(-0.199));
+});
+test('normal stereo is mixed without clipping or losing either channel',()=>{
+  assert.deepEqual([...monoForTranscription(buffer([1,0],[0,1]))],[0.5,0.5]);
+  assert.deepEqual([...monoForTranscription(buffer([1,-1],[1,-1]))],[1,-1]);
+});
+test('channels beyond the first two are retained; mono and silence stay valid',()=>{
+  assert(monoForTranscription(buffer([0,0],[0,0],[0.3,-0.3]))[0]>0);
