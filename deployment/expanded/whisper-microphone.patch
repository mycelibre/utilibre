+// Adapt decoded channels to the upstream model's mono input. Preserve a normal
+// mix, but do not turn audible opposite-phase channels into digital silence.
+export function monoForTranscription(buffer: AudioBuffer): Float32Array {
+    const channels = Array.from({ length: buffer.numberOfChannels }, (_, i) =>
+        buffer.getChannelData(i),
+    );
+    if (channels.length === 1) return channels[0];
+    const mixed = new Float32Array(buffer.length);
+    let strongest = 0;
+    let strongestEnergy = 0;
+    for (const [index, channel] of channels.entries()) {
+        let energy = 0;
+        for (let i = 0; i < mixed.length; i++) {
+            mixed[i] += channel[i] / channels.length;
+            energy += channel[i] * channel[i];
+        }
+        if (energy > strongestEnergy) {
+            strongest = index;
+            strongestEnergy = energy;
+        }
+    }
+    let mixedEnergy = 0;
+    for (const value of mixed) mixedEnergy += value * value;
+    // A 100x energy loss indicates severe cancellation, not a silent source.
+    return mixedEnergy < strongestEnergy * 0.01
+        ? channels[strongest].slice()
+        : mixed;
+}
