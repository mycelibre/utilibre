diff --git a/src/utils/LocalAudio.ts b/src/utils/LocalAudio.ts
new file mode 100644
index 0000000..358e799
--- /dev/null
+++ b/src/utils/LocalAudio.ts
@@ -0,0 +1,17 @@
+// The original application decodes on the user's device. Keep that boundary
+// while handling unreadable files and releasing each temporary AudioContext.
+export const MAX_AUDIO_BYTES = 128 * 1024 * 1024;
+export const AUDIO_ERROR = 'This browser could not read the audio. Choose a supported audio file or try a shorter recording. / Este navegador no pudo leer el audio. Elegí un archivo de audio compatible o probá con una grabación más corta.';
+
+export async function decodeLocalAudio(blob: Blob, sampleRate: number): Promise<AudioBuffer> {
+    if (!blob.size) throw new Error(AUDIO_ERROR);
+    if (blob.size > MAX_AUDIO_BYTES) {
+        throw new Error('Choose a file under 128 MiB. / Elegí un archivo de menos de 128 MiB.');
+    }
+    const context = new AudioContext({ sampleRate });
+    try {
+        return await context.decodeAudioData(await blob.arrayBuffer());
+    } finally {
+        await context.close().catch(() => {});
+    }
+}
