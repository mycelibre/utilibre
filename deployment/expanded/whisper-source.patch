diff --git a/tests/local-audio.test.mjs b/tests/local-audio.test.mjs
new file mode 100644
index 0000000..3cd55b2
--- /dev/null
+++ b/tests/local-audio.test.mjs
@@ -0,0 +1,28 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import {decodeLocalAudio, MAX_AUDIO_BYTES} from '../src/utils/LocalAudio.ts';
+
+test('empty and oversized files are rejected before opening an audio context', async () => {
+  globalThis.AudioContext = class { constructor() { throw Error('Context must not be created'); } };
+  await assert.rejects(decodeLocalAudio({size:0}, 16000), /could not read/);
+  await assert.rejects(decodeLocalAudio({size:MAX_AUDIO_BYTES+1}, 16000), /128 MiB/);
+});
+test('decode failure releases its audio context', async () => {
+  let closed = 0;
+  globalThis.AudioContext = class {
+    async decodeAudioData() { throw Error('Synthetic invalid audio'); }
+    async close() { closed++; }
+  };
+  await assert.rejects(decodeLocalAudio(new Blob(['invalid']), 16000), /Synthetic/);
+  assert.equal(closed, 1);
+});
+test('successful decoding also releases the temporary audio context', async () => {
+  let closed = 0;
+  const decoded = {duration:1};
+  globalThis.AudioContext = class {
+    async decodeAudioData() { return decoded; }
+    async close() { closed++; }
+  };
+  assert.equal(await decodeLocalAudio(new Blob(['synthetic']), 16000), decoded);
+  assert.equal(closed, 1);
+});
