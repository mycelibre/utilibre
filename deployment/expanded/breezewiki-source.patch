+"""Ordinary verified HTTPS transport; no browser impersonation or challenge solver.
+
+Loopback-only adapter for BreezeWiki's Racket client. Restricts every destination,
+pins public DNS answers, bounds workers/response size/time, and forwards no visitor
+identity. TLS certificates are always verified. Upstream denials remain denials.
+"""
+import concurrent.futures
+from collections import OrderedDict
+from email.utils import parsedate_to_datetime
+import http.client
+import http.server
+import ipaddress
+import re
+import signal
+import socket
+import ssl
+import subprocess
+import threading
+import time
+import urllib.parse
+
+CONTEXT = ssl.create_default_context()
+MAX_BODY = 12 * 1024 * 1024
+COOLDOWNS = OrderedDict()
+COOLDOWN_LOCK = threading.Lock()
+FETCH_LOCKS = [threading.Lock() for _ in range(64)]
+
+def retry_delay(value):
+    """Honor upstream Retry-After, with a ten-minute minimum after rejection."""
+    try:
+        seconds = int(value)
+    except (TypeError, ValueError):
+        try:
+            seconds = int(parsedate_to_datetime(value).timestamp() - time.time())
+        except (TypeError, ValueError, OverflowError):
+            seconds = 0
+    return max(600, seconds)
+
+def checked_url(value):
+    if len(value) > 8192 or any(ord(c) < 32 for c in value):
+        raise ValueError("Invalid URL")
+    url = urllib.parse.urlsplit(value)
+    host = url.hostname or ""
+    allowed = re.fullmatch(r"[a-z0-9-]+\.fandom\.com", host) or host == "static.wikia.nocookie.net"
+    if not allowed or url.scheme != "https" or url.port not in (None, 443) or url.username or url.password or url.fragment:
+        raise ValueError("Destination denied")
+    return url
+
+def _fetch(value, theme=""):
+    deadline = time.monotonic() + 20
+    for hop in range(4):
+        url = checked_url(value)
+        addresses = socket.getaddrinfo(url.hostname, 443, socket.AF_INET, socket.SOCK_STREAM)
+        if not addresses or any(not ipaddress.ip_address(a[4][0]).is_global for a in addresses):
+            raise ValueError("Address denied")
+        if url.hostname == "static.wikia.nocookie.net":
+            # Use curl itself with its genuine default user agent, not a forged
+            # browser identity. No cookies, proxies, redirect following or retry.
+            result = subprocess.run([
+                "curl", "--silent", "--show-error", "--noproxy", "*",
+                "--proto", "=https", "--max-time", "20", "--connect-timeout", "5",
+                "--max-filesize", str(MAX_BODY), "--resolve",
+                f"{url.hostname}:443:{addresses[0][4][0]}",
+                "--dump-header", "-", "--output", "-", "--url", value,
+            ], capture_output=True, timeout=22, check=True)
+            head, separator, body = result.stdout.partition(b"\r\n\r\n")
+            if not separator or len(head) > 65536 or len(body) > MAX_BODY:
+                raise ValueError("Invalid CDN response")
+            lines = head.decode("latin1").split("\r\n")
+            status = int(lines[0].split()[1])
+            headers = dict(line.split(":", 1) for line in lines[1:] if ":" in line)
+            headers = {key.lower(): item.strip() for key,item in headers.items()}
+            if status in (301,302,303,307,308):
+                if hop == 3 or not headers.get("location"): raise ValueError("Redirect denied")
+                value = urllib.parse.urljoin(value,headers["location"])
+                checked_url(value)
+                continue
+            return status, headers.get("content-type", "application/octet-stream"), body, headers.get("retry-after")
+        connection = http.client.HTTPSConnection(url.hostname, timeout=10, context=CONTEXT)
+        raw = socket.create_connection(addresses[0][4], timeout=5)
+        try:
+            connection.sock = CONTEXT.wrap_socket(raw, server_hostname=url.hostname)
+            headers = {"User-Agent": "BreezeWiki/1.0 (https://wiki.utilibre.org)", "Accept-Encoding": "identity", "Connection": "close"}
+            if theme in ("theme=dark", "theme=light"): headers["Cookie"] = theme
+            path = urllib.parse.urlunsplit(("", "", url.path or "/", url.query, ""))
+            connection.request("GET", path, headers=headers)
+            response = connection.getresponse()
+            if response.status in (301,302,303,307,308):
+                location = response.getheader("Location")
+                if hop == 3 or not location: raise ValueError("Redirect denied")
+                value = urllib.parse.urljoin(value, location)
+                checked_url(value)
+                continue
+            declared = response.getheader("Content-Length")
+            if declared and int(declared) > MAX_BODY: raise ValueError("Response too large")
+            body = bytearray()
+            while True:
+                if time.monotonic() > deadline: raise TimeoutError("Upstream deadline")
+                chunk = response.read(65536)
+                if not chunk: break
+                body.extend(chunk)
+                if len(body) > MAX_BODY: raise ValueError("Response too large")
+            return response.status, response.getheader("Content-Type", "application/octet-stream"), bytes(body), response.getheader("Retry-After")
+        finally:
+            connection.close()
+            raw.close()
+    raise ValueError("Redirect limit")
+
+def fetch(value, theme=""):
+    host = checked_url(value).hostname
+    # Serialize requests for the same upstream host. An image-heavy page must
+    # not issue dozens of challenges after the first image has been refused.
+    with FETCH_LOCKS[hash(host) % len(FETCH_LOCKS)]:
+        with COOLDOWN_LOCK:
+            until, status = COOLDOWNS.get(host, (0, 503))
+        remaining = int(until - time.monotonic()) + 1
+        if remaining > 0:
+            return status, "text/plain; charset=utf-8", b"Upstream access temporarily unavailable. Please retry later.", str(remaining)
+        status, kind, body, retry = _fetch(value, theme)
+        if status in (403, 406, 429):
+            delay = retry_delay(retry)
+            with COOLDOWN_LOCK:
+                COOLDOWNS[host] = (time.monotonic() + delay, status)
+                COOLDOWNS.move_to_end(host)
+                while len(COOLDOWNS) > 256:
+                    COOLDOWNS.popitem(last=False)
+            # Never serve an upstream challenge document on Utilibre's origin.
+            return status, "text/plain; charset=utf-8", b"Upstream access temporarily unavailable. Please retry later.", str(delay)
+        if host == "static.wikia.nocookie.net" and status == 200:
+            mime = kind.split(";", 1)[0].strip().lower()
+            if not (mime.startswith(("image/", "audio/", "video/")) or mime == "text/css"):
+                return 502, "text/plain; charset=utf-8", b"Upstream returned an unexpected media type.", None
+        return status, kind, body, retry
+
+class Handler(http.server.BaseHTTPRequestHandler):
+    def log_message(self, *_): pass
+    def do_GET(self):
+        try:
+            request = urllib.parse.urlsplit(self.path)
+            values = urllib.parse.parse_qs(request.query, strict_parsing=True)
+            if request.path != "/fetch" or set(values) != {"url"} or len(values["url"]) != 1:
+                raise ValueError("Invalid request")
+            status, kind, body, retry = fetch(values["url"][0], self.headers.get("Cookie", ""))
+        except ValueError:
+            status, kind, body, retry = 400, "text/plain", b"Invalid upstream request", None
+        except Exception:
+            status, kind, body, retry = 502, "text/plain", b"Upstream request failed", None
+        try:
+            self.send_response(status)
+            self.send_header("Content-Type", kind)
+            self.send_header("Content-Length", str(len(body)))
+            self.send_header("X-Content-Type-Options", "nosniff")
+            if status >= 400: self.send_header("Cache-Control", "no-store")
+            if retry and retry.isdecimal(): self.send_header("Retry-After", retry)
+            self.send_header("Connection", "close")
+            self.end_headers()
+            self.wfile.write(body)
+        except (BrokenPipeError, ConnectionResetError): pass
+
+class Server(http.server.HTTPServer):
+    request_queue_size = 16
+    def __init__(self):
+        super().__init__(("127.0.0.1",10417), Handler)
+        self.pool = concurrent.futures.ThreadPoolExecutor(max_workers=4)
+        self.slots = threading.BoundedSemaphore(16)
+    def process_request(self, request, address):
+        if not self.slots.acquire(blocking=False):
+            self.shutdown_request(request)
+            return
+        def work():
+            try:
+                request.settimeout(25)
+                self.finish_request(request, address)
+            finally:
+                self.shutdown_request(request)
+                self.slots.release()
+        self.pool.submit(work)
+
+if __name__ == "__main__":
+    server = Server()
+    threading.Thread(target=server.serve_forever, daemon=True).start()
+    app = subprocess.Popen(["racket", "dist.rkt"])
+    def stop(*_): app.terminate()
+    signal.signal(signal.SIGTERM, stop)
+    signal.signal(signal.SIGINT, stop)
+    try: raise SystemExit(app.wait())
+    finally:
+        server.shutdown()
+        server.server_close()
+        server.pool.shutdown(wait=False, cancel_futures=True)
