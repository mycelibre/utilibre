+import concurrent.futures
+import importlib.util
+import unittest
+from unittest.mock import patch
+
+spec = importlib.util.spec_from_file_location("transport", "utilibre-transport.py")
+transport = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(transport)
+IMAGE = "https://static.wikia.nocookie.net/example/images/a/b/image.png"
+
+class TransportTests(unittest.TestCase):
+    def setUp(self):
+        transport.COOLDOWNS.clear()
+
+    def test_denials_are_not_proxied_or_repeated(self):
+        with patch.object(transport, "_fetch", return_value=(403, "text/html", b"<script>challenge</script>", None)) as upstream:
+            first = transport.fetch(IMAGE)
+            second = transport.fetch(IMAGE + "?other-image=1")
+        self.assertEqual(upstream.call_count, 1)
+        self.assertEqual(first[0], 403)
+        self.assertEqual(second[0], 403)
+        self.assertNotIn(b"<script>", first[2])
+        self.assertGreaterEqual(int(second[3]), 599)
+
+    def test_concurrent_image_requests_share_cooldown(self):
+        with patch.object(transport, "_fetch", return_value=(429, "text/plain", b"blocked", "900")) as upstream:
+            with concurrent.futures.ThreadPoolExecutor(max_workers=8) as pool:
+                results = list(pool.map(transport.fetch, [IMAGE] * 12))
+        self.assertEqual(upstream.call_count, 1)
+        self.assertTrue(all(result[0] == 429 for result in results))
+        self.assertTrue(all(int(result[3]) >= 899 for result in results))
+
+    def test_image_denial_does_not_block_articles(self):
+        with patch.object(transport, "_fetch", side_effect=[(403, "text/html", b"challenge", None), (200, "text/html", b"article", None)]) as upstream:
+            transport.fetch(IMAGE)
+            result = transport.fetch("https://minecraft.fandom.com/wiki/Minecraft")
+        self.assertEqual(upstream.call_count, 2)
+        self.assertEqual(result[2], b"article")
+
+    def test_media_type_validation(self):
+        with patch.object(transport, "_fetch", return_value=(200, "text/html", b"<script>challenge</script>", None)):
+            self.assertEqual(transport.fetch(IMAGE)[0], 502)
+        with patch.object(transport, "_fetch", return_value=(200, "image/png", b"PNG", None)):
+            self.assertEqual(transport.fetch(IMAGE)[2], b"PNG")
+
+    def test_retry_after(self):
+        self.assertEqual(transport.retry_delay("900"), 900)
+        self.assertEqual(transport.retry_delay("30"), 600)
+        self.assertEqual(transport.retry_delay(None), 600)
+        self.assertEqual(transport.retry_delay("junk"), 600)
+        with patch.object(transport.time, "time", return_value=0):
+            self.assertEqual(transport.retry_delay("Thu, 01 Jan 1970 00:20:00 GMT"), 1200)
+
+    def test_destinations_remain_restricted(self):
+        for value in ["http://static.wikia.nocookie.net/a", "https://127.0.0.1/a", "https://evil.test/a", "https://user:pass@minecraft.fandom.com/", "https://minecraft.fandom.com:444/"]:
+            with self.assertRaises(ValueError): transport.fetch(value)
+
+if __name__ == "__main__": unittest.main()
