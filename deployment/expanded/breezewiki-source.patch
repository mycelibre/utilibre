diff --git a/test_proxy_response.py b/test_proxy_response.py
new file mode 100644
index 0000000..7178b96
--- /dev/null
+++ b/test_proxy_response.py
@@ -0,0 +1,47 @@
+"""Offline integration check of Racket's media response, not just its compiler."""
+import http.server
+import os
+import subprocess
+import threading
+import time
+import urllib.error
+import urllib.request
+
+class RejectedMedia(http.server.BaseHTTPRequestHandler):
+    def log_message(self, *_): pass
+    def do_GET(self):
+        self.send_response(403)
+        self.send_header("Content-Type", "text/plain")
+        self.send_header("Retry-After", "600")
+        self.end_headers()
+        self.wfile.write(b"Upstream unavailable")
+
+adapter = http.server.HTTPServer(("127.0.0.1", 10417), RejectedMedia)
+threading.Thread(target=adapter.serve_forever, daemon=True).start()
+app = subprocess.Popen(["racket", "dist.rkt"], stdout=subprocess.DEVNULL,
+                       env={**os.environ, "bw_bind_host": "127.0.0.1", "bw_log_outgoing": "false"})
+try:
+    ready = False
+    for _ in range(100):
+        if app.poll() is not None: raise RuntimeError("Racket server exited")
+        try:
+            with urllib.request.urlopen("http://127.0.0.1:10416/", timeout=1): ready = True
+            break
+        except (urllib.error.URLError, TimeoutError): time.sleep(0.1)
+    if not ready: raise RuntimeError("Racket server did not start")
+    try:
+        urllib.request.urlopen("http://127.0.0.1:10416/proxy?dest=https%3A%2F%2Fstatic.wikia.nocookie.net%2Ftest.png", timeout=5)
+        raise AssertionError("Upstream denial was converted to success")
+    except urllib.error.HTTPError as response:
+        assert response.code == 403, response.read()
+        assert response.headers["Retry-After"] == "600"
+        assert response.headers["Cache-Control"] == "no-store"
+        assert "sandbox" in response.headers["Content-Security-Policy"]
+        assert response.read() == b"Upstream unavailable"
+    print("Racket media response integration passed without upstream requests.")
+finally:
+    app.terminate()
+    try: app.wait(timeout=5)
+    except subprocess.TimeoutExpired: app.kill(); app.wait()
+    adapter.shutdown()
+    adapter.server_close()
