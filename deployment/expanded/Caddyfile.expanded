# Import on the separate Caddy VM. Keep existing global and Cloudflare trust
# settings. DNS must point these hosts to the same HTTPS edge.
# These static applications execute visitor code/audio in the browser.
python.utilibre.org {
	encode zstd gzip
	header >Cross-Origin-Embedder-Policy credentialless
	header >Cross-Origin-Opener-Policy same-origin
	reverse_proxy 10.10.1.43:3133
}

# Historical host now serves only a 410 withdrawal notice from3137.
transcribe.utilibre.org {
	encode zstd gzip
	header >Cross-Origin-Embedder-Policy credentialless
	header >Cross-Origin-Opener-Policy same-origin
	reverse_proxy 10.10.1.43:3137
}

# Replace any old Wakapi block; port 3109 belongs to IT Tools.
