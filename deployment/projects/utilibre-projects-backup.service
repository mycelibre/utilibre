[Unit]
Description=Consistent Utilibre Projects PostgreSQL and upload backup
After=docker.service utilibre-projects.service
Requires=docker.service
[Service]
Type=oneshot
UMask=0077
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
ExecStart=/usr/bin/python3 /home/ubuntu/freetools/deployment/projects/backup.py
