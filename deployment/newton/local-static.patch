 // Used for QR code integrity checking today; reusable inside MQTT payloads later.
 
 const NewtonIntegrity = {
+    // IDs enter native HTML event attributes: reject executable syntax before import.
+    safeImportIdentifiers(value, depth = 0) {
+        if (depth > 32) return false;
+        if (!value || typeof value !== 'object') return true;
+        return Object.entries(value).every(([key, item]) => {
+            if ((key === 'id' || key.endsWith('Id')) && item != null) {
+                if (typeof item === 'number') { if (!Number.isFinite(item)) return false; }
+                else if (typeof item !== 'string' || !/^[A-Za-z0-9_.:-]{1,128}$/.test(item)) return false;
+            }
+            return this.safeImportIdentifiers(item, depth + 1);
+        });
+    },
     _table: null,
 
     _makeTable() {
