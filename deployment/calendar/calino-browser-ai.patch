diff --git a/src/lib/icsExport.ts b/src/lib/icsExport.ts
index 4059532..d940efe 100644
--- a/src/lib/icsExport.ts
+++ b/src/lib/icsExport.ts
@@ -43,6 +43,13 @@ export function buildVCalendar(events: CalendarEvent[]): string {
   for (const event of events) {
     if (event.timezone) ensureZoneRegistered(event.timezone)
   }
+  // UTC has no VTIMEZONE component. A TZID=UTC parameter makes ical.js
+  // try to insert its null component; UTC values already serialize with Z.
+  for (const item of comp.getAllSubcomponents()) {
+    for (const property of item.getAllProperties()) {
+      if (property.getParameter('tzid') === 'UTC') property.removeParameter('tzid')
+    }
+  }
   ICAL.helpers.updateTimezones(comp)
 
   return foldICalLines(comp.toString())
