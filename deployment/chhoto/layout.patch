diff --git a/frontend/static/styles.css b/frontend/static/styles.css
index aa239d9..88a101c 100644
--- a/frontend/static/styles.css
+++ b/frontend/static/styles.css
@@ -555,3 +555,28 @@ summary,
 
 /* Visitor counters are disabled in the backend. */
 [name="hitsColumn"], #info-table tr:has(#info-hits) { display: none; }
+
+/* Keep the instance notes below the form, including at narrow widths. */
+.container {
+  max-width: 64rem;
+  margin: 2rem auto;
+  padding: 0 1rem;
+}
+div[name="links-div"] {
+  position: static;
+  max-width: 64rem;
+  margin: 2rem auto;
+  padding: 1rem 1rem 0;
+  border-top: 1px solid var(--border);
+  line-height: 1.5;
+}
+div[name="links-div"] p { margin: 0 0 0.75rem; }
+@media (max-width: 768px) {
+  .container { max-width: none; margin: 1rem auto; }
+}
+
+/* Keep the native login dialog inside narrow viewports. */
+@media (max-width: 768px) {
+  #login-dialog { min-width: 0; max-width: calc(100vw - 2rem); box-sizing: border-box; }
+  #login-dialog input { max-width: 100%; box-sizing: border-box; }
+}
