+def pilot_article(url):
+    if url not in {PILOT_ORIGIN + path for path in PILOT_PATHS}:
+        raise UserFacingError("Only the owned fictional fixture is allowed.")
+    deadline = time.monotonic() + 8
+    with requests.Session() as session:
+        session.trust_env = False
+        with session.get(url, headers={"User-Agent": "Utilibre-13ft-offline-test"},
+                         allow_redirects=False, stream=True, timeout=(2, 2)) as response:
