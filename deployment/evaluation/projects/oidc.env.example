# Prepared only; not loaded by the isolated compose recipe.
# The existing authentik client must be provisioned before enabling this.
BASE_URL=https://projects.utilibre.org
OIDC_ISSUER=https://auth.utilibre.org/application/o/projects/
OIDC_CLIENT_ID=utilibre-projects
# Read the generated value from /data/private/projects-oidc.json privately.
OIDC_CLIENT_SECRET=
OIDC_SCOPES=openid email profile
OIDC_CLAIMS_SOURCE=id_token
OIDC_FULLNAME_ATTRIBUTES=name
OIDC_USERNAME_ATTRIBUTE=preferred_username
OIDC_EMAIL_ATTRIBUTE=email
OIDC_ID_TOKEN_SIGNED_RESPONSE_ALG=RS256
OIDC_USE_DEFAULT_RESPONSE_MODE=true
OIDC_ENFORCED=true
OIDC_IGNORE_ROLES=true
ALLOW_ALL_TO_CREATE_PROJECTS=false
THEME={}
WEBHOOKS=[]
SERVICE_NAME=Projects · Utilibre
LOG_FILE=/dev/null
