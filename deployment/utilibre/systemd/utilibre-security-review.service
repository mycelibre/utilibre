[Unit]
Description=Local vulnerability review of Utilibre running images, OS and code locks
After=docker.service network-online.target
Requires=docker.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/home/ubuntu/freetools
Environment=PATH=/root/.nvm/versions/node/v24.14.0/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=TRIVY_DISABLE_TELEMETRY=true
Environment=TRIVY_SKIP_VERSION_CHECK=true
ExecStart=/usr/bin/flock -n /run/utilibre-security-review.lock /usr/bin/env node deployment/maintenance/security-review.mjs
# Keep the conservative ledger current even when coverage is incomplete and
# the scanner deliberately exits nonzero. The scanner failure remains visible.
ExecStopPost=/usr/bin/env node deployment/maintenance/build-queue.mjs
StateDirectory=utilibre-maintenance
StateDirectoryMode=0700
CacheDirectory=utilibre-security
CacheDirectoryMode=0700
UMask=0077
TimeoutStartSec=3h
MemoryMax=2G
CPUQuota=75%
Nice=15
IOSchedulingClass=idle
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/utilibre-maintenance /var/cache/utilibre-security /run
PrivateTmp=true
NoNewPrivileges=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
