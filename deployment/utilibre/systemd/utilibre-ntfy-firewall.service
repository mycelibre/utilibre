[Unit]
Description=Restrict Utilibre ntfy to the edge proxy
Documentation=https://docs.docker.com/engine/network/packet-filtering-firewalls/
Requires=docker.service
After=docker.service
PartOf=docker.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/utilibre-ntfy-firewall apply
ExecReload=/usr/local/sbin/utilibre-ntfy-firewall apply
ExecStop=/usr/local/sbin/utilibre-ntfy-firewall remove
RemainAfterExit=yes

[Install]
WantedBy=docker.service
