[Unit]
Description=Utilibre online community backup and isolated restore verification
Requires=docker.service
After=docker.service network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/home/ubuntu/freetools
Environment=PATH=/root/.nvm/versions/node/v24.14.0/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/usr/bin/flock -n /run/utilibre-community-backup.lock /usr/bin/env node deployment/community/scheduled-backup.mjs
UMask=0077
TimeoutStartSec=10min
Nice=10
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/opt/utilibre/community-backups /run
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
