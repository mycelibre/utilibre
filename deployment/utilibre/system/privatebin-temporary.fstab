# VM144 scsi2, 10 GiB. Host backup exclusion is owner-confirmed (11 Oct 2026).
# Restore: use the replacement disk's UUID; never format an existing data disk.
UUID=6976f8a1-99ca-44f5-9ac8-53c7c0f30d35 /opt/utilibre/temporary ext4 defaults,nodev,nosuid,noexec,nofail,x-systemd.device-timeout=10s,x-systemd.before=docker.service 0 2
