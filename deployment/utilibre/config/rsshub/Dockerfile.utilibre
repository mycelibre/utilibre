ARG RSSHUB_BASE_IMAGE=ghcr.io/diygod/rsshub@sha256:0e0ee34e7288664ada039a816835ee28cc86767412d2c23f64e37a7320908f6c
FROM ${RSSHUB_BASE_IMAGE}

COPY patch-runtime.mjs /usr/local/share/utilibre/patch-runtime.mjs
COPY rsshub-public-origin.patch /usr/local/share/utilibre/rsshub-public-origin.patch

RUN node /usr/local/share/utilibre/patch-runtime.mjs

LABEL org.opencontainers.image.source="https://github.com/mycelibre/utilibre" \
      org.opencontainers.image.description="RSSHub with Utilibre's public feed-origin correction"
