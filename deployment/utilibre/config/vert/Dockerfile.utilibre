FROM docker.io/oven/bun@sha256:e10577f0db68676a7024391c6e5cb4b879ebd17188ab750cf10024a6d700e5c4 AS builder

WORKDIR /app

ARG PUB_ENV
ARG PUB_HOSTNAME
ARG PUB_PLAUSIBLE_URL
ARG PUB_VERTD_URL
ARG PUB_DISABLE_ALL_EXTERNAL_REQUESTS
ARG PUB_DISABLE_FAILURE_BLOCKS=false
ARG PUB_DONATION_URL
ARG PUB_STRIPE_KEY

ENV PUB_ENV=${PUB_ENV} \
    PUB_HOSTNAME=${PUB_HOSTNAME} \
    PUB_PLAUSIBLE_URL=${PUB_PLAUSIBLE_URL} \
    PUB_VERTD_URL=${PUB_VERTD_URL} \
    PUB_DISABLE_ALL_EXTERNAL_REQUESTS=${PUB_DISABLE_ALL_EXTERNAL_REQUESTS} \
    PUB_DISABLE_FAILURE_BLOCKS=${PUB_DISABLE_FAILURE_BLOCKS} \
    PUB_DONATION_URL=${PUB_DONATION_URL} \
    PUB_STRIPE_KEY=${PUB_STRIPE_KEY}

COPY package.json bun.lock ./
# The application VM's virtual CPU does not expose AVX. Bun's Node-compatibility
# runner crashes while executing optional native postinstall probes on this CPU,
# even though the lockfile already selects the correct prebuilt Linux binaries.
# Ignore lifecycle scripts during this static production build; Vite does not
# require the watcher postinstall and @swc's platform package is lock-pinned.
RUN bun install --frozen-lockfile --ignore-scripts
COPY . ./
RUN bun run build

FROM docker.io/library/nginx:stable-alpine@sha256:97d490c12ba55b4946b01546d1c3ed324e8d41ab1c9fcb2a616aa470620e5b46

LABEL org.opencontainers.image.source="https://github.com/VERT-sh/VERT" \
      org.opencontainers.image.revision="e0ffd34310f9c988b16e22334b13e18de030b0ae" \
      org.opencontainers.image.licenses="AGPL-3.0-only"

EXPOSE 80
COPY nginx/default.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/build /usr/share/nginx/html
