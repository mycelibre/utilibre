APP_BIND_IP=REPLACE_WITH_PRIVATE_IPV4
# Exact IPv4 source address of the Caddy edge. Required before enabling the
# ntfy firewall unit; never use a subnet or leave it empty in production.
EDGE_PROXY_IP=
# Exact private address of the unauthenticated SMTP relay used by Healthchecks.
# Keep the address in the untracked deployment .env, not in the public repository.
SMTP_RELAY_IP=
TZ=America/Guatemala
DONATION_URL=

NTFY_PORT=2586
# Random owner-only topic; generated locally by init-secrets.sh.
NTFY_ADMIN_TOPIC=
BENTOPDF_PORT=3101
VERT_PORT=3102
OMNITOOLS_PORT=3103
HEALTHCHECKS_PORT=3104
PAIRDROP_PORT=3105
FRESHRSS_PORT=3106
RSSHUB_PORT=3107
RSSHUB_PUBLIC_URL=https://feeds.utilibre.org/
PRIVATEBIN_PORT=3108
WAKAPI_PORT=3109
CRABFIT_FRONTEND_PORT=3110
CRABFIT_API_PORT=3111

# Generate all values below locally with scripts/init-secrets.sh. Never commit them.
POSTGRES_ADMIN_PASSWORD=REPLACE_WITH_SECRET
HEALTHCHECKS_DB_PASSWORD=REPLACE_WITH_SECRET
FRESHRSS_DB_PASSWORD=REPLACE_WITH_SECRET
WAKAPI_DB_PASSWORD=REPLACE_WITH_SECRET
CRABFIT_DB_PASSWORD=REPLACE_WITH_SECRET
HEALTHCHECKS_SECRET_KEY=REPLACE_WITH_SECRET
HEALTHCHECKS_ADMIN_EMAIL=REPLACE_WITH_OWNER_EMAIL
HEALTHCHECKS_ADMIN_PASSWORD=REPLACE_WITH_SECRET
# Optional secret path such as /ping/<uuid>; created after Healthchecks bootstrap.
BACKUP_HEALTHCHECK_PATH=
FRESHRSS_ADMIN_USERNAME=REPLACE_WITH_USERNAME
FRESHRSS_ADMIN_PASSWORD=REPLACE_WITH_SECRET
FRESHRSS_API_PASSWORD=REPLACE_WITH_SECRET
WAKAPI_ADMIN_USERNAME=REPLACE_WITH_USERNAME
WAKAPI_ADMIN_PASSWORD=REPLACE_WITH_SECRET
WAKAPI_PASSWORD_SALT=REPLACE_WITH_SECRET
WAKAPI_ALLOW_SIGNUP=false
CRABFIT_CRON_KEY=REPLACE_WITH_SECRET
