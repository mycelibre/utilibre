#!/bin/sh
set -eu

iptables=/usr/sbin/iptables
chain=DOCKER-USER
rule_comment=utilibre-ntfy-edge-only
env_file=${UTILIBRE_NTFY_FIREWALL_ENV_FILE:-/opt/utilibre/.env}
action=${1:-apply}

fail() {
  echo "utilibre-ntfy-firewall: $*" >&2
  exit 1
}

read_setting() {
  setting=$1
  /usr/bin/awk -v setting="$setting" '
    index($0, setting "=") == 1 {
      count++
      value = substr($0, length(setting) + 2)
    }
    END {
      if (count != 1 || value == "") exit 1
      print value
    }
  ' "$env_file"
}

valid_ipv4() {
  case "$1" in
    ''|*[!0-9.]*) return 1 ;;
  esac
  printf '%s\n' "$1" | /usr/bin/awk -F. '
    NF != 4 { exit 1 }
    {
      for (i = 1; i <= 4; i++) {
        if ($i !~ /^[0-9]+$/ || length($i) > 3 ||
            (length($i) > 1 && substr($i, 1, 1) == "0") || $i + 0 > 255) exit 1
      }
    }
  '
}

case "$action" in
  apply|remove|status) ;;
  *)
    echo "Usage: $0 {apply|remove|status}" >&2
    exit 2
    ;;
esac

[ "$(/usr/bin/id -u)" -eq 0 ] || fail "must run as root"
[ -x "$iptables" ] || fail "cannot execute $iptables"

load_and_validate_settings() {
  [ -f "$env_file" ] && [ -r "$env_file" ] || fail "cannot read regular file $env_file"
  [ "$(/usr/bin/stat -c %u "$env_file")" -eq 0 ] || fail "$env_file must be owned by root"
  env_mode=$(/usr/bin/stat -c %a "$env_file")
  [ "$env_mode" = "600" ] || [ "$env_mode" = "400" ] || fail "$env_file must have mode 0600 or 0400"

  app_ip=$(read_setting APP_BIND_IP) || fail "APP_BIND_IP must occur exactly once and be non-empty in $env_file"
  edge_ip=$(read_setting EDGE_PROXY_IP) || fail "EDGE_PROXY_IP must occur exactly once and be non-empty in $env_file"
  app_port=$(read_setting NTFY_PORT) || fail "NTFY_PORT must occur exactly once and be non-empty in $env_file"

  valid_ipv4 "$app_ip" || fail "APP_BIND_IP must be one exact IPv4 address"
  valid_ipv4 "$edge_ip" || fail "EDGE_PROXY_IP must be one exact IPv4 address"
  [ "$app_ip" != "0.0.0.0" ] || fail "APP_BIND_IP must not be 0.0.0.0"
  [ "$edge_ip" != "0.0.0.0" ] || fail "EDGE_PROXY_IP must not be 0.0.0.0"
  [ "$app_ip" != "$edge_ip" ] || fail "APP_BIND_IP and EDGE_PROXY_IP must differ"
  case "$app_port" in
    ''|*[!0-9]*) fail "NTFY_PORT must be an integer from 1 through 65535" ;;
  esac
  [ "$app_port" -ge 1 ] && [ "$app_port" -le 65535 ] || fail "NTFY_PORT must be an integer from 1 through 65535"
}

require_chain() {
  "$iptables" -w 10 -n -L "$chain" >/dev/null 2>&1 || \
    fail "$chain is unavailable; Docker must be running"
}

first_tagged_rule_number() {
  tagged_listing=$("$iptables" -w 10 -n --line-numbers -L "$chain") || return 1
  printf '%s\n' "$tagged_listing" | /usr/bin/awk -v comment="$rule_comment" '
    {
      for (i = 2; i <= NF - 2; i++) {
        if ($i == "/*" && $(i + 1) == comment && $(i + 2) == "*/") {
          print $1
          exit
        }
      }
    }
  '
}

tagged_rule_count() {
  tagged_listing=$("$iptables" -w 10 -n --line-numbers -L "$chain") || return 1
  printf '%s\n' "$tagged_listing" | /usr/bin/awk -v comment="$rule_comment" '
    {
      for (i = 2; i <= NF - 2; i++) {
        if ($i == "/*" && $(i + 1) == comment && $(i + 2) == "*/") {
          count++
          break
        }
      }
    }
    END { print count + 0 }
  '
}

last_tagged_rule_number() {
  tagged_listing=$("$iptables" -w 10 -n --line-numbers -L "$chain") || return 1
  printf '%s\n' "$tagged_listing" | /usr/bin/awk -v comment="$rule_comment" '
    {
      for (i = 2; i <= NF - 2; i++) {
        if ($i == "/*" && $(i + 1) == comment && $(i + 2) == "*/") {
          rule_number = $1
          break
        }
      }
    }
    END {
      if (rule_number != "") print rule_number
    }
  '
}

rule_exists() {
  "$iptables" -w 10 -C "$chain" \
    -p tcp \
    -m conntrack --ctdir ORIGINAL \
    --ctorigdst "$app_ip" --ctorigdstport "$app_port" \
    ! -s "$edge_ip" \
    -m comment --comment "$rule_comment" \
    -j DROP >/dev/null 2>&1
}

apply_rule() {
  "$iptables" -w 10 -I "$chain" 1 \
    -p tcp \
    -m conntrack --ctdir ORIGINAL \
    --ctorigdst "$app_ip" --ctorigdstport "$app_port" \
    ! -s "$edge_ip" \
    -m comment --comment "$rule_comment" \
    -j DROP || fail "could not install the desired $rule_comment rule"
  remove_older_tagged_rules
}

remove_older_tagged_rules() {
  while :; do
    installed_tagged_rules=$(tagged_rule_count) || \
      fail "could not inspect $chain for $rule_comment rules"
    case "$installed_tagged_rules" in
      ''|*[!0-9]*) fail "received an invalid tagged-rule count from $chain" ;;
    esac
    [ "$installed_tagged_rules" -ge 1 ] || \
      fail "the newly installed $rule_comment rule is not visible in $chain"
    [ "$installed_tagged_rules" -gt 1 ] || break

    tagged_rule_number=$(last_tagged_rule_number) || \
      fail "could not inspect $chain for older $rule_comment rules"
    case "$tagged_rule_number" in
      ''|*[!0-9]*) fail "received an invalid $chain rule number" ;;
    esac
    "$iptables" -w 10 -D "$chain" "$tagged_rule_number" || \
      fail "could not remove older tagged rule $tagged_rule_number from $chain"
  done

  rule_exists || fail "the desired $rule_comment rule is not installed"
}

remove_tagged_rules() {
  while :; do
    tagged_rule_number=$(first_tagged_rule_number) || \
      fail "could not inspect $chain for $rule_comment rules"
    [ -n "$tagged_rule_number" ] || break
    case "$tagged_rule_number" in
      *[!0-9]*) fail "received an invalid $chain rule number" ;;
    esac
    "$iptables" -w 10 -D "$chain" "$tagged_rule_number" || \
      fail "could not remove tagged rule $tagged_rule_number from $chain"
  done
}

case "$action" in
  apply)
    load_and_validate_settings
    require_chain
    apply_rule
    ;;
  remove)
    require_chain
    remove_tagged_rules
    ;;
  status)
    load_and_validate_settings
    require_chain
    installed_tagged_rules=$(tagged_rule_count) || \
      fail "could not inspect $chain for $rule_comment rules"
    if rule_exists && [ "$installed_tagged_rules" -eq 1 ]; then
      echo "ntfy edge-only firewall rule is installed"
    else
      echo "ntfy edge-only firewall rule is not installed" >&2
      exit 1
    fi
    ;;
esac
