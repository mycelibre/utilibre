#!/bin/sh
set -eu

iptables=/usr/sbin/iptables
ip_cmd=/usr/sbin/ip
chain_a=UTILIBRE-EDGE-A
chain_b=UTILIBRE-EDGE-B
jump_comment=utilibre-edge-ingress
rule_comment=utilibre-edge-port
env_file=${UTILIBRE_EDGE_FIREWALL_ENV_FILE:-/home/ubuntu/freetools/.env}
action=${1:-status}

fail() {
	echo "utilibre-edge-firewall: $*" >&2
	exit 1
}

read_setting() {
	setting=$1
	/usr/bin/awk -v setting="$setting" '
		index($0, setting "=") == 1 {
			count++
			value = substr($0, length(setting) + 2)
		}
		END {
			if (count != 1 || value == "") exit 1
			print value
		}
	' "$env_file"
}

valid_private_ipv4() {
	printf '%s\n' "$1" | /usr/bin/awk -F. '
		NF != 4 { exit 1 }
		{
			for (i = 1; i <= 4; i++) {
				if ($i !~ /^[0-9]+$/ || length($i) > 3 ||
					(length($i) > 1 && substr($i, 1, 1) == "0") || $i + 0 > 255) exit 1
			}
			if ($1 == 10) exit 0
			if ($1 == 172 && $2 >= 16 && $2 <= 31) exit 0
			if ($1 == 192 && $2 == 168) exit 0
			exit 1
		}
	'
}

valid_port() {
	printf '%s\n' "$1" | /usr/bin/awk '
		!/^[0-9]+$/ || length($0) > 5 || (length($0) > 1 && substr($0, 1, 1) == "0") { exit 1 }
		$0 + 0 < 1 || $0 + 0 > 65535 { exit 1 }
	'
}

load_and_validate_settings() {
	[ -f "$env_file" ] && [ -r "$env_file" ] && [ ! -L "$env_file" ] || \
		fail "cannot read a regular, non-symlink environment file"
	[ "$(/usr/bin/stat -c %u "$env_file")" -eq 0 ] || fail "environment file must be owned by root"
	env_mode=$(/usr/bin/stat -c %a "$env_file")
	[ "$env_mode" = 600 ] || [ "$env_mode" = 400 ] || fail "environment file must have mode 0600 or 0400"

	app_ip=$(read_setting PRIVATE_BIND_IP) || fail "PRIVATE_BIND_IP must occur exactly once and be non-empty"
	edge_ip=$(read_setting EDGE_PROXY_IP) || fail "EDGE_PROXY_IP must occur exactly once and be non-empty"
	portal_port=$(read_setting PORTAL_PORT) || fail "PORTAL_PORT must occur exactly once and be non-empty"
	searxng_port=$(read_setting SEARXNG_PORT) || fail "SEARXNG_PORT must occur exactly once and be non-empty"
	redlib_port=$(read_setting REDLIB_PORT) || fail "REDLIB_PORT must occur exactly once and be non-empty"
	freshrss_port=$(read_setting FRESHRSS_PORT) || fail "FRESHRSS_PORT must occur exactly once and be non-empty"
	privatebin_port=$(read_setting PRIVATEBIN_PORT) || fail "PRIVATEBIN_PORT must occur exactly once and be non-empty"

	valid_private_ipv4 "$app_ip" || fail "PRIVATE_BIND_IP must be one RFC1918 IPv4 address"
	valid_private_ipv4 "$edge_ip" || fail "EDGE_PROXY_IP must be one RFC1918 IPv4 address"
	[ "$app_ip" != "$edge_ip" ] || fail "PRIVATE_BIND_IP and EDGE_PROXY_IP must differ"

	ports="$portal_port $searxng_port $redlib_port $freshrss_port $privatebin_port"
	for port in $ports; do
		valid_port "$port" || fail "every retained service port must be an integer from 1 through 65535 without leading zeroes"
	done
	unique_port_count=$(printf '%s\n' $ports | /usr/bin/sort -u | /usr/bin/wc -l)
	[ "$unique_port_count" -eq 5 ] || fail "the five retained service ports must be distinct"

	private_interface=$(
		"$ip_cmd" -o -4 addr show | /usr/bin/awk -v expected="$app_ip" '
			{
				split($4, address, "/")
				if (address[1] == expected) {
					count++
					interface = $2
				}
			}
			END {
				if (count != 1) exit 1
				print interface
			}
		'
	) || fail "PRIVATE_BIND_IP must be assigned to exactly one local IPv4 interface"
	case "$private_interface" in
		lo|''|*[!A-Za-z0-9_.:-]*) fail "could not derive a safe private ingress interface" ;;
	esac

	route=$({ "$ip_cmd" -4 route get "$edge_ip" from "$app_ip"; } 2>/dev/null) || \
		fail "EDGE_PROXY_IP is not reachable from PRIVATE_BIND_IP"
	printf '%s\n' "$route" | /usr/bin/awk -v expected_dev="$private_interface" -v expected_src="$app_ip" '
		{
			for (i = 1; i <= NF; i++) {
				if ($i == "dev" && $(i + 1) == expected_dev) found_dev = 1
				if (($i == "src" || $i == "from") && $(i + 1) == expected_src) found_src = 1
			}
		}
		END { if (!found_dev || !found_src) exit 1 }
	' || fail "EDGE_PROXY_IP must route through the private ingress interface using PRIVATE_BIND_IP"
}

require_runtime() {
	[ "$(/usr/bin/id -u)" -eq 0 ] || fail "must run as root"
	[ -x "$iptables" ] || fail "cannot execute iptables"
	[ -x "$ip_cmd" ] || fail "cannot execute ip"
	"$iptables" -w 10 -n -L DOCKER-USER >/dev/null 2>&1 || \
		fail "DOCKER-USER is unavailable; Docker must be running"
}

chain_exists() {
	"$iptables" -w 10 -n -L "$1" >/dev/null 2>&1
}

chain_rule_count() {
	"$iptables" -w 10 -S "$1" | /usr/bin/awk -v chain="$1" '$1 == "-A" && $2 == chain { count++ } END { print count + 0 }'
}

chain_reference_count() {
	"$iptables" -w 10 -S | /usr/bin/awk -v target="$1" '
		$1 == "-A" {
			for (i = 1; i < NF; i++) if ($i == "-j" && $(i + 1) == target) count++
		}
		END { print count + 0 }
	'
}

chain_is_owned() {
	chain=$1
	"$iptables" -w 10 -S "$chain" | /usr/bin/awk -v chain="$chain" -v comment="$rule_comment" '
		$1 == "-A" && $2 == chain {
			count++
			matched = 0
			for (i = 1; i < NF; i++) if ($i == "--comment" && $(i + 1) == comment) matched = 1
			if (!matched) bad = 1
		}
		END { if (count > 0 && !bad) exit 0; exit 1 }
	'
}

tagged_jump_rows() {
	"$iptables" -w 10 -n --line-numbers -L DOCKER-USER | /usr/bin/awk \
		-v comment="$jump_comment" -v chain_a="$chain_a" -v chain_b="$chain_b" '
		$1 ~ /^[0-9]+$/ {
			matched = 0
			for (i = 1; i <= NF - 2; i++) {
				if ($i == "/*" && $(i + 1) == comment && $(i + 2) == "*/") matched = 1
			}
			if (matched) {
				if ($2 != chain_a && $2 != chain_b) bad = 1
				print $1, $2
			}
		}
		END { if (bad) exit 1 }
	'
}

tagged_jump_count() {
	rows=$(tagged_jump_rows) || fail "found an invalid rule using the reserved firewall comment"
	if [ -n "$rows" ]; then
		printf '%s\n' "$rows" | /usr/bin/awk 'END { print NR }'
	else
		printf '0\n'
	fi
}

active_chain() {
	rows=$(tagged_jump_rows) || return 1
	[ -n "$rows" ] || return 1
	printf '%s\n' "$rows" | /usr/bin/awk 'NR == 1 { print $2 }'
}

jump_exists() {
	target=$1
	"$iptables" -w 10 -C DOCKER-USER \
		-i "$private_interface" -p tcp \
		-m conntrack --ctdir ORIGINAL --ctorigdst "$app_ip" \
		-m comment --comment "$jump_comment" -j "$target" >/dev/null 2>&1
}

chain_matches() {
	target=$1
	[ "$(chain_rule_count "$target")" -eq 11 ] || return 1
	for port in $ports; do
		"$iptables" -w 10 -C "$target" \
			-i "$private_interface" -p tcp -s "$edge_ip" \
			-m conntrack --ctdir ORIGINAL --ctorigdst "$app_ip" --ctorigdstport "$port" \
			-m comment --comment "$rule_comment" -j RETURN >/dev/null 2>&1 || return 1
		"$iptables" -w 10 -C "$target" \
			-i "$private_interface" -p tcp \
			-m conntrack --ctdir ORIGINAL --ctorigdst "$app_ip" --ctorigdstport "$port" \
			-m comment --comment "$rule_comment" -j DROP >/dev/null 2>&1 || return 1
	done
	"$iptables" -w 10 -C "$target" \
		-m comment --comment "$rule_comment" -j RETURN >/dev/null 2>&1
}

desired_policy_is_installed() {
	[ "$(tagged_jump_count)" -eq 1 ] || return 1
	target=$(active_chain) || return 1
	jump_exists "$target" || return 1
	chain_matches "$target"
}

clean_unreferenced_chain() {
	target=$1
	chain_exists "$target" || return 0
	[ "$(chain_reference_count "$target")" -eq 0 ] || fail "managed chain still has an unexpected reference"
	if [ "$(chain_rule_count "$target")" -gt 0 ]; then
		chain_is_owned "$target" || fail "refusing to alter a managed chain containing unrecognized rules"
	fi
	"$iptables" -w 10 -F "$target" || fail "could not empty an unreferenced managed chain"
	"$iptables" -w 10 -X "$target" || fail "could not remove an unreferenced managed chain"
}

populate_chain() {
	target=$1
	"$iptables" -w 10 -N "$target" || fail "could not create the staging firewall chain"
	for port in $ports; do
		"$iptables" -w 10 -A "$target" \
			-i "$private_interface" -p tcp -s "$edge_ip" \
			-m conntrack --ctdir ORIGINAL --ctorigdst "$app_ip" --ctorigdstport "$port" \
			-m comment --comment "$rule_comment" -j RETURN || return 1
		"$iptables" -w 10 -A "$target" \
			-i "$private_interface" -p tcp \
			-m conntrack --ctdir ORIGINAL --ctorigdst "$app_ip" --ctorigdstport "$port" \
			-m comment --comment "$rule_comment" -j DROP || return 1
	done
	"$iptables" -w 10 -A "$target" \
		-m comment --comment "$rule_comment" -j RETURN || return 1
	chain_matches "$target"
}

remove_older_tagged_jumps() {
	while [ "$(tagged_jump_count)" -gt 1 ]; do
		last_rule=$(tagged_jump_rows | /usr/bin/awk 'END { print $1 }')
		case "$last_rule" in
			''|*[!0-9]*) fail "received an invalid DOCKER-USER rule number" ;;
		esac
		"$iptables" -w 10 -D DOCKER-USER "$last_rule" || fail "could not remove an older managed jump"
	done
}

remove_all_tagged_jumps() {
	while [ "$(tagged_jump_count)" -gt 0 ]; do
		last_rule=$(tagged_jump_rows | /usr/bin/awk 'END { print $1 }')
		case "$last_rule" in
			''|*[!0-9]*) fail "received an invalid DOCKER-USER rule number" ;;
		esac
		"$iptables" -w 10 -D DOCKER-USER "$last_rule" || fail "could not remove a managed jump"
	done
}

apply_policy() {
	if desired_policy_is_installed; then
		echo "Utilibre edge-ingress firewall policy is installed"
		return 0
	fi

	jump_count=$(tagged_jump_count)
	[ "$jump_count" -le 1 ] || fail "multiple managed jumps exist; run remove before retrying"
	old_target=''
	if [ "$jump_count" -eq 1 ]; then
		old_target=$(active_chain) || fail "could not identify the active managed chain"
	fi
	case "$old_target" in
		"$chain_a") new_target=$chain_b ;;
		"$chain_b") new_target=$chain_a ;;
		'') new_target=$chain_a ;;
		*) fail "active managed chain is invalid" ;;
	esac

	clean_unreferenced_chain "$new_target"
	if ! populate_chain "$new_target"; then
		clean_unreferenced_chain "$new_target"
		fail "could not construct and verify the staging firewall policy"
	fi

	if ! "$iptables" -w 10 -I DOCKER-USER 1 \
		-i "$private_interface" -p tcp \
		-m conntrack --ctdir ORIGINAL --ctorigdst "$app_ip" \
		-m comment --comment "$jump_comment" -j "$new_target"; then
		clean_unreferenced_chain "$new_target"
		fail "could not activate the staging firewall policy"
	fi

	remove_older_tagged_jumps
	desired_policy_is_installed || fail "the activated firewall policy did not verify"
	if [ -n "$old_target" ]; then
		clean_unreferenced_chain "$old_target"
	fi
	echo "Utilibre edge-ingress firewall policy is installed"
}

remove_policy() {
	tagged_jump_rows >/dev/null || fail "found an invalid rule using the reserved firewall comment"
	remove_all_tagged_jumps
	clean_unreferenced_chain "$chain_a"
	clean_unreferenced_chain "$chain_b"
	echo "Utilibre edge-ingress firewall policy is removed"
}

case "$action" in
	apply|remove|status|validate) ;;
	*)
		echo "Usage: $0 {apply|remove|status|validate}" >&2
		exit 2
		;;
esac

require_runtime

case "$action" in
	apply)
		load_and_validate_settings
		apply_policy
		;;
	remove)
		remove_policy
		;;
	status)
		load_and_validate_settings
		desired_policy_is_installed || fail "edge-ingress firewall policy is not installed or does not match configuration"
		echo "Utilibre edge-ingress firewall policy is installed"
		;;
	validate)
		load_and_validate_settings
		jump_count=$(tagged_jump_count)
		[ "$jump_count" -le 1 ] || fail "multiple managed jumps exist"
		echo "Utilibre edge-ingress firewall configuration is valid"
		;;
esac
