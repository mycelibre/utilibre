# Utilibre application routes retained after the 2026-09-03 service prune.
#
# This is a reference fragment for the separately managed Caddy edge VM. It is
# not applied automatically. Remove every retired Utilibre site block from the
# real edge, then format, validate, and reload Caddy without disturbing the
# portal or unrelated sites.

(utilibre_app_proxy) {
	encode zstd gzip
	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
}

(utilibre_proxy_headers) {
	header_up Host {host}
	header_up X-Forwarded-Host {host}
	header_up X-Forwarded-Proto {scheme}
	header_up X-Forwarded-For {client_ip}
	header_up X-Real-IP {client_ip}
}

search.utilibre.org {
	request_body {
		max_size 64KB
	}

	header {
		-Server
		Referrer-Policy "no-referrer"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		X-Robots-Tag "noindex, nofollow"
	}

	@private_diagnostics path /config /stats /stats/* /metrics /metrics/*
	respond @private_diagnostics 404

	@search_non_post {
		path /search
		not method POST
	}
	respond @search_non_post 405

	reverse_proxy http://{$UTILIBRE_APP_IP}:8888 {
		import utilibre_proxy_headers
		transport http {
			dial_timeout 5s
			response_header_timeout 20s
			read_timeout 60s
			write_timeout 60s
		}
	}
}

redlib.utilibre.org {
	request_body {
		max_size 64KB
	}

	header {
		-Server
		Referrer-Policy "no-referrer"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()"
		X-Robots-Tag "noindex, nofollow, noarchive"
	}

	reverse_proxy http://{$UTILIBRE_APP_IP}:3002 {
		import utilibre_proxy_headers
		header_up -X-Original-URI
		header_up -X-Forwarded-Uri
		header_down -Strict-Transport-Security
		header_down -Alt-Svc
		header_down -Via
		header_down -Reddit-Io-Info
		header_down -Reddit-Stats
		header_down -X-Imo-Features
		header_down -X-Reddit-Ct
		health_uri /info
		health_status 2xx
		health_interval 30s
		health_timeout 5s
		health_headers {
			CF-Connecting-IP 127.0.0.1
		}
		transport http {
			dial_timeout 5s
			response_header_timeout 30s
			read_timeout 1h
			write_timeout 1h
		}
	}
}

rss.utilibre.org {
	import utilibre_app_proxy
	header Cache-Control "private, no-store"

	reverse_proxy http://{$UTILIBRE_APP_IP}:3106 {
		import utilibre_proxy_headers
		transport http {
			dial_timeout 5s
			response_header_timeout 60s
		}
	}
}

paste.utilibre.org {
	import utilibre_app_proxy
	header Cache-Control "no-store"

	reverse_proxy http://{$UTILIBRE_APP_IP}:3108 {
		import utilibre_proxy_headers
		transport http {
			dial_timeout 5s
			response_header_timeout 30s
		}
	}
}
