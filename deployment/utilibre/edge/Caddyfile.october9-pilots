# New native backends, 9 October 2026. Merge these HTTPS site blocks into the
# separate Caddy edge. Existing utilibre_* snippets and CrowdSec are reused.
# Load one block per hostname. Preserve unrelated routes and TURN challenges.
# Public activation remains dependent on loading/reloading this edge config
# and then checking public HTTPS, native login/gameplay and live connections.
# All upstreams bind on10.10.1.43 and permit the existing edge10.10.1.3.
# Static additions use tools:3103 and need no extra site blocks.

chess.utilibre.org {
    import utilibre_no_transform
    import utilibre_security_contact
    crowdsec
    encode zstd gzip
    reverse_proxy http://10.10.1.43:3214 {
        import utilibre_proxy_headers
        transport http {
            dial_timeout 5s
            response_header_timeout 60s
        }
        flush_interval -1
    }
}

