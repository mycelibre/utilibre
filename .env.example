# Copy to .env, replace every REPLACE_* value used by enabled services, and
# keep .env private. Unused optional hostname placeholders may remain.
COMPOSE_PROJECT_NAME=public-utility
COMPOSE_PROFILES=privacy-frontends
PORTAL_IMAGE=public-utility-portal:0.1.0
REDLIB_IMAGE=public-utility-redlib:0.36.0-a4d36e9-p1
TZ=America/Guatemala

# Keep this at 0 for an edge-proxied/public deployment. The private-preview
# initializer sets it to 1 only for direct HTTP access on PRIVATE_BIND_IP.
PRIVATE_PREVIEW=0
# Optional portal-only production overrides. These let the portal trust the
# edge and emit public Cobalt tunnel links without changing an already-running
# Cobalt or SearXNG container during a staged cutover.
PORTAL_PRIVATE_PREVIEW=0
PORTAL_EDGE_PROXY_IP=
PORTAL_PUBLIC_ORIGIN=
PORTAL_COBALT_BROWSER_URL=
PORTAL_COBALT_RESULT_SOURCE_URL=

PROJECT_NAME=REPLACE_WITH_PROJECT_NAME
PROJECT_TAGLINE=
PROJECT_TAGLINE_EN=
PROJECT_TAGLINE_ES=
# Exact public repository/revision or source archive for the deployed tree.
SOURCE_CODE_URL=
# Optional external donation destination; the portal hides it when empty.
SUPPORT_URL=
# Real public contact or abuse-reporting page. Do not substitute a generic
# homepage that provides no way to contact the operator.
CONTACT_URL=https://github.com/mycelibre/utilibre/issues

# The application VM address reachable only from the edge VM. EDGE_PROXY_IP may
# be empty only while PRIVATE_PREVIEW=1; it is mandatory for public launch.
PRIVATE_BIND_IP=REPLACE_WITH_PRIVATE_BIND_IP
EDGE_PROXY_IP=REPLACE_WITH_EDGE_PROXY_IP

PORTAL_PORT=8080
COBALT_PORT=9000
SEARXNG_PORT=8888
REDLIB_PORT=3002
INVIDIOUS_PORT=3003
RIMGO_PORT=3001
NTFY_PORT=2586
BENTOPDF_PORT=3101
VERT_PORT=3102
OMNITOOLS_PORT=3103
HEALTHCHECKS_PORT=3104
PAIRDROP_PORT=3105
FRESHRSS_PORT=3106
RSSHUB_PORT=3107
PRIVATEBIN_PORT=3108
WAKAPI_PORT=3109

PUBLIC_PORTAL_HOST=REPLACE_WITH_PUBLIC_PORTAL_HOST
PUBLIC_MEDIA_HOST=REPLACE_WITH_PUBLIC_MEDIA_HOST
PUBLIC_SEARCH_HOST=REPLACE_WITH_PUBLIC_SEARCH_HOST
PUBLIC_REDDIT_HOST=REPLACE_WITH_PUBLIC_REDDIT_HOST
PUBLIC_YOUTUBE_HOST=REPLACE_WITH_PUBLIC_YOUTUBE_HOST
PUBLIC_IMGUR_HOST=REPLACE_WITH_PUBLIC_IMGUR_HOST
PUBLIC_NTFY_HOST=REPLACE_WITH_PUBLIC_NTFY_HOST
PUBLIC_PDF_HOST=REPLACE_WITH_PUBLIC_PDF_HOST
PUBLIC_CONVERT_HOST=REPLACE_WITH_PUBLIC_CONVERT_HOST
PUBLIC_TOOLS_HOST=REPLACE_WITH_PUBLIC_TOOLS_HOST
PUBLIC_MONITOR_HOST=REPLACE_WITH_PUBLIC_MONITOR_HOST
PUBLIC_SEND_HOST=REPLACE_WITH_PUBLIC_SEND_HOST
PUBLIC_RSS_HOST=REPLACE_WITH_PUBLIC_RSS_HOST
PUBLIC_FEEDS_HOST=REPLACE_WITH_PUBLIC_FEEDS_HOST
PUBLIC_PASTE_HOST=REPLACE_WITH_PUBLIC_PASTE_HOST
PUBLIC_WAKAPI_HOST=REPLACE_WITH_PUBLIC_WAKAPI_HOST

PUBLIC_PORTAL_ORIGIN=https://REPLACE_WITH_PUBLIC_PORTAL_HOST
COBALT_PUBLIC_API_URL=https://REPLACE_WITH_PUBLIC_MEDIA_HOST/
PUBLIC_SEARCH_URL=https://REPLACE_WITH_PUBLIC_SEARCH_HOST/
PUBLIC_REDDIT_URL=https://REPLACE_WITH_PUBLIC_REDDIT_HOST/
ANUBIS_PUBLIC_HOST=REPLACE_WITH_PUBLIC_REDDIT_HOST
PUBLIC_YOUTUBE_URL=
PUBLIC_IMGUR_URL=
PUBLIC_NTFY_URL=https://REPLACE_WITH_PUBLIC_NTFY_HOST/
PUBLIC_PDF_URL=https://REPLACE_WITH_PUBLIC_PDF_HOST/
PUBLIC_CONVERT_URL=https://REPLACE_WITH_PUBLIC_CONVERT_HOST/
PUBLIC_TOOLS_URL=https://REPLACE_WITH_PUBLIC_TOOLS_HOST/
PUBLIC_MONITOR_URL=https://REPLACE_WITH_PUBLIC_MONITOR_HOST/
PUBLIC_SEND_URL=https://REPLACE_WITH_PUBLIC_SEND_HOST/
PUBLIC_RSS_URL=https://REPLACE_WITH_PUBLIC_RSS_HOST/
PUBLIC_FEEDS_URL=https://REPLACE_WITH_PUBLIC_FEEDS_HOST/
PUBLIC_PASTE_URL=https://REPLACE_WITH_PUBLIC_PASTE_HOST/
PUBLIC_WAKAPI_URL=https://REPLACE_WITH_PUBLIC_WAKAPI_HOST/

# Reserved for a future, separately reviewed Invidious deployment. They are
# unused by this milestone's Compose file and must not be populated yet.
INVIDIOUS_DB_USER=
INVIDIOUS_DB_PASSWORD=
INVIDIOUS_DB_NAME=

# Portal catalog launch set. Redlib also requires the
# privacy-frontends Compose profile; remove both the catalog ID and profile to
# disable it cleanly. The ten additional IDs link to the separately managed
# utilibre-services stack; they do not add those containers to this Compose
# project. The optional rimgo 1.4.2 profile is for
# private evaluation only: keep it disabled and PUBLIC_IMGUR_URL empty until an
# official release fixes the reviewed open redirect and the new pin is reviewed.
ENABLED_SERVICES=cobalt,searxng,redlib,ntfy,bentopdf,vert,omnitools,healthchecks,pairdrop,freshrss,rsshub,privatebin,wakapi
DEFAULT_LANGUAGE=en

# Generate with: openssl rand -hex 32
SEARXNG_SECRET=REPLACE_WITH_RANDOM_SECRET

# Generate matching files with: node scripts/init-secrets.mjs
COBALT_ALLOWED_HOSTS=dailymotion.com,dai.ly
COBALT_DISABLED_SERVICES=bilibili,bluesky,facebook,instagram,loom,ok,pinterest,reddit,rutube,snapchat,soundcloud,streamable,tiktok,tumblr,twitch,twitter,vimeo,vk,youtube
COBALT_DURATION_LIMIT_SECONDS=1800
COBALT_TUNNEL_LIFESPAN_SECONDS=90
COBALT_RATELIMIT_WINDOW_SECONDS=60
COBALT_RATELIMIT_MAX=30
COBALT_TUNNEL_RATELIMIT_WINDOW_SECONDS=60
COBALT_TUNNEL_RATELIMIT_MAX=120
COBALT_PROCESSING_PRIORITY=10
MEDIA_RATE_WINDOW_SECONDS=600
MEDIA_RATE_LIMIT=10
MEDIA_MAX_CONCURRENT=2
MEDIA_REQUEST_TIMEOUT_SECONDS=45
STATUS_CACHE_SECONDS=15

# Conservative starting limits; adjust only after measuring.
PORTAL_CPU_LIMIT=0.50
PORTAL_MEMORY_LIMIT=256M
COBALT_CPU_LIMIT=1.50
COBALT_MEMORY_LIMIT=1536M
COBALT_MEMORY_RESERVATION=256M
COBALT_PIDS_LIMIT=256
SEARXNG_CPU_LIMIT=1.00
SEARXNG_MEMORY_LIMIT=768M
VALKEY_CPU_LIMIT=0.25
VALKEY_MEMORY_LIMIT=128M
VALKEY_MAXMEMORY=96mb
VALKEY_DATA_TMPFS_SIZE=128m
REDLIB_CPU_LIMIT=0.50
REDLIB_MEMORY_LIMIT=256M
REDLIB_MEMORY_RESERVATION=32M
REDLIB_PIDS_LIMIT=128
REDLIB_TMPFS_SIZE=32m
REDLIB_SFW_ONLY=off
REDLIB_BANNER=
# Anubis protects only Redlib. Cloudflare overwrites CF-Connecting-IP on the
# proxied public hostname; the edge must remain inaccessible except through
# trusted Cloudflare networks. Use X-Real-IP only when Caddy is configured to
# derive and overwrite it from trusted proxies.
ANUBIS_REAL_IP_HEADER=CF-Connecting-IP
ANUBIS_COOKIE_EXPIRATION=24h
ANUBIS_COOKIE_SECURE=true
ANUBIS_COOKIE_PARTITIONED=true
ANUBIS_CPU_LIMIT=0.25
ANUBIS_MEMORY_LIMIT=128M
ANUBIS_MEMORY_RESERVATION=32M
ANUBIS_PIDS_LIMIT=128
RIMGO_CPU_LIMIT=0.50
RIMGO_MEMORY_LIMIT=256M

DOCKER_LOG_MAX_SIZE=10m
DOCKER_LOG_MAX_FILES=3
