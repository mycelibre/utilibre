# Copy this file to .env, replace every REPLACE_* value, and keep .env mode
# 0600. New tools remain hidden until their public routes pass verification.
COMPOSE_PROJECT_NAME=public-utility
COMPOSE_PROFILES=privacy-frontends
PORTAL_IMAGE=public-utility-portal:0.1.0
REDLIB_IMAGE=public-utility-redlib:0.36.0-a4d36e9-p1
TZ=America/Guatemala

PUBLIC_WHITEBOARD_HOST=
PUBLIC_WHITEBOARD_URL=
PUBLIC_COLLAB_HOST=
PUBLIC_COLLAB_URL=
WBO_PORT=3169
EXCALIDRAW_PORT=3164
PUBLIC_SVG_HOST=
PUBLIC_SVG_URL=
SVGEDIT_PORT=3165
PUBLIC_CYBERCHEF_HOST=
PUBLIC_CYBERCHEF_URL=
CYBERCHEF_PORT=3166
PUBLIC_SCRUB_HOST=
PUBLIC_SCRUB_URL=
IMAGE_SCRUBBER_PORT=3167
PUBLIC_MINDMAP_HOST=
PUBLIC_MINDMAP_URL=
MARKMAP_PORT=3168
PUBLIC_MAPS_HOST=
PUBLIC_MAPS_URL=
MAPSHAPER_PORT=3170
PUBLIC_CALC_HOST=
PUBLIC_CALC_URL=
NUMBAT_PORT=3171
PUBLIC_PLAN_HOST=
PUBLIC_PLAN_URL=
PUBLIC_PAD_HOST=
PUBLIC_PAD_URL=
PUBLIC_FORMS_HOST=
PUBLIC_FORMS_URL=
PUBLIC_MEET_HOST=
PUBLIC_MEET_URL=
SUPER_PRODUCTIVITY_PORT=3172
# Set to 1 only for direct HTTP access on PRIVATE_BIND_IP during a private
# preview. Production traffic arrives through the separate edge VM.
PRIVATE_PREVIEW=0
PORTAL_PRIVATE_PREVIEW=0
PORTAL_EDGE_PROXY_IP=
PORTAL_PUBLIC_ORIGIN=

PROJECT_NAME=REPLACE_WITH_PROJECT_NAME
PROJECT_TAGLINE=
PROJECT_TAGLINE_EN=
PROJECT_TAGLINE_ES=
SOURCE_CODE_URL=https://github.com/mycelibre/utilibre
# Operator-provided public Liberapay URL. Never infer a donation recipient.
# All donation UI and routes stay hidden when empty.
SUPPORT_URL=
CONTACT_URL=https://github.com/mycelibre/utilibre/issues

PRIVATE_BIND_IP=REPLACE_WITH_PRIVATE_BIND_IP
EDGE_PROXY_IP=REPLACE_WITH_EDGE_PROXY_IP

PORTAL_PORT=8080
SEARXNG_PORT=8888
# Optional immutable override, maintained by scripts/searxng-maintain.py.
# Leave empty to use the reviewed default pin in compose.yaml.
SEARXNG_IMAGE=
REDLIB_PORT=3002
FRESHRSS_PORT=3106
PRIVATEBIN_PORT=3108

PUBLIC_PORTAL_HOST=REPLACE_WITH_PUBLIC_PORTAL_HOST
PUBLIC_SEARCH_HOST=REPLACE_WITH_PUBLIC_SEARCH_HOST
PUBLIC_REDDIT_HOST=REPLACE_WITH_PUBLIC_REDDIT_HOST
PUBLIC_RSS_HOST=REPLACE_WITH_PUBLIC_RSS_HOST
PUBLIC_PASTE_HOST=REPLACE_WITH_PUBLIC_PASTE_HOST

PUBLIC_PORTAL_ORIGIN=https://REPLACE_WITH_PUBLIC_PORTAL_HOST
PUBLIC_SEARCH_URL=https://REPLACE_WITH_PUBLIC_SEARCH_HOST/
PUBLIC_REDDIT_URL=https://REPLACE_WITH_PUBLIC_REDDIT_HOST/
PUBLIC_RSS_URL=https://REPLACE_WITH_PUBLIC_RSS_HOST/
PUBLIC_PASTE_URL=https://REPLACE_WITH_PUBLIC_PASTE_HOST/
PUBLIC_PDF_URL=
PUBLIC_CONVERT_URL=
PUBLIC_TOOLS_URL=
PUBLIC_DEVELOPER_TOOLS_URL=
PUBLIC_ENCRYPT_URL=
PUBLIC_DRAW_URL=
PUBLIC_QR_URL=
PUBLIC_BRIDGE_URL=
PUBLIC_NOTIFY_URL=
PUBLIC_SECRET_URL=
PUBLIC_DROP_URL=
PUBLIC_STATUS_URL=
PUBLIC_PYTHON_URL=
PUBLIC_TRANSCRIBE_URL=
PUBLIC_WAKAPI_URL=
PUBLIC_WAKAPI_HOST=
WAKAPI_PORT=3136
PUBLIC_RESUME_URL=
PUBLIC_RESUME_HOST=
RESUME_PORT=3130
PUBLIC_DESIGN_URL=
PUBLIC_DESIGN_HOST=
PENPOT_PORT=3131
PUBLIC_BUDGET_URL=
PUBLIC_BUDGET_HOST=
ACTUAL_PORT=3132
PUBLIC_POLL_URL=
PUBLIC_POLL_HOST=
RALLLY_PORT=3123
PUBLIC_TUMBLR_URL=
PUBLIC_TUMBLR_HOST=
PRIVIBLUR_PORT=3139
PUBLIC_TENOR_URL=
PUBLIC_TENOR_HOST=
MEZZO_PORT=3140
PUBLIC_FMD_URL=
PUBLIC_FMD_HOST=
FMD_PORT=3141
PUBLIC_PYTHON_HOST=
JUPYTERLITE_PORT=3133
PUBLIC_TRANSCRIBE_HOST=
WHISPER_PORT=3137
# Listed entries remain visible with an unavailable explanation, without enabling access.
LISTED_SERVICES=
# Pollaris: enable only after the separate Caddy route and workflow checks pass.
PUBLIC_POLLARIS_HOST=
PUBLIC_POLLARIS_URL=
POLLARIS_PORT=3149
PUBLIC_BINTERNET_HOST=
PUBLIC_BINTERNET_URL=
BINTERNET_PORT=3150
PUBLIC_GOTHUB_HOST=
PUBLIC_GOTHUB_URL=
GOTHUB_PORT=3148
PUBLIC_TRANSLATE_HOST=
PUBLIC_TRANSLATE_URL=
TRANSLITE_PORT=3152
PUBLIC_BOOKS_HOST=
PUBLIC_BOOKS_URL=
BIBLIOREADS_PORT=3151
PUBLIC_QRTOOLS_HOST=
PUBLIC_QRTOOLS_URL=
QR_OFFLINE_PORT=3155
PUBLIC_ZIP_HOST=
PUBLIC_ZIP_URL=
ZIP_MANAGER_PORT=3160
PUBLIC_CHARTS_HOST=
PUBLIC_CHARTS_URL=
RAWGRAPHS_PORT=3161
PUBLIC_AUDIO_HOST=
PUBLIC_AUDIO_URL=
AUDIOMASS_PORT=3162
PUBLIC_PAINT_HOST=
PUBLIC_PAINT_URL=
MINIPAINT_PORT=3163
PUBLIC_DEGOOG_HOST=
PUBLIC_DEGOOG_URL=
DEGOOG_GATEWAY_PORT=3156
# Native Mumble client link: mumble://mumble.utilibre.org:64738/ (no password).
PUBLIC_MUMBLE_URL=
PUBLIC_INSTAGRAM_HOST=
PUBLIC_INSTAGRAM_URL=
KITTYGRAM_PORT=3154
PUBLIC_FOURGET_HOST=
PUBLIC_FOURGET_URL=
FOURGET_PORT=3145
PUBLIC_OVERFLOW_HOST=
PUBLIC_OVERFLOW_URL=
OVERFLOW_PORT=3147
PUBLIC_TWITCH_HOST=
PUBLIC_TWITCH_URL=
PUBLIC_LYRICS_HOST=
PUBLIC_LYRICS_URL=
LRCLIB_PORT=3142
SAFETWITCH_PORT=3146
ANUBIS_PUBLIC_HOST=REPLACE_WITH_PUBLIC_REDDIT_HOST

# Redlib also requires COMPOSE_PROFILES=privacy-frontends. FreshRSS and
# PrivateBin run in deployment/utilibre; RSSHub remains internal to FreshRSS.
ENABLED_SERVICES=searxng,redlib,freshrss,privatebin
DEFAULT_LANGUAGE=en

# Generate with: openssl rand -hex 32
SEARXNG_SECRET=REPLACE_WITH_RANDOM_SECRET
STATUS_CACHE_SECONDS=15

# Conservative starting limits; adjust only after measuring.
PORTAL_CPU_LIMIT=0.50
PORTAL_MEMORY_LIMIT=256M
SEARXNG_CPU_LIMIT=1.00
SEARXNG_MEMORY_LIMIT=768M
VALKEY_CPU_LIMIT=0.25
VALKEY_MEMORY_LIMIT=128M
VALKEY_MAXMEMORY=96mb
VALKEY_DATA_TMPFS_SIZE=128m
REDLIB_CPU_LIMIT=0.50
REDLIB_MEMORY_LIMIT=256M
REDLIB_MEMORY_RESERVATION=32M
REDLIB_PIDS_LIMIT=128
REDLIB_TMPFS_SIZE=32m
REDLIB_SFW_ONLY=off
REDLIB_BANNER=

# Anubis protects only Redlib. Cloudflare overwrites CF-Connecting-IP on the
# proxied public hostname; the edge must remain inaccessible except through
# trusted Cloudflare networks.
ANUBIS_REAL_IP_HEADER=CF-Connecting-IP
ANUBIS_COOKIE_EXPIRATION=24h
ANUBIS_COOKIE_SECURE=true
ANUBIS_COOKIE_PARTITIONED=true
ANUBIS_CPU_LIMIT=0.25
ANUBIS_MEMORY_LIMIT=128M
ANUBIS_MEMORY_RESERVATION=32M
ANUBIS_PIDS_LIMIT=128

DOCKER_LOG_MAX_SIZE=10m
DOCKER_LOG_MAX_FILES=3
