# Copy this file to .env, replace every REPLACE_* value, and keep .env mode
# 0600. Only the four deliberately hosted public services appear here.
COMPOSE_PROJECT_NAME=public-utility
COMPOSE_PROFILES=privacy-frontends
PORTAL_IMAGE=public-utility-portal:0.1.0
REDLIB_IMAGE=public-utility-redlib:0.36.0-a4d36e9-p1
TZ=America/Guatemala

# Set to 1 only for direct HTTP access on PRIVATE_BIND_IP during a private
# preview. Production traffic arrives through the separate edge VM.
PRIVATE_PREVIEW=0
PORTAL_PRIVATE_PREVIEW=0
PORTAL_EDGE_PROXY_IP=
PORTAL_PUBLIC_ORIGIN=

PROJECT_NAME=REPLACE_WITH_PROJECT_NAME
PROJECT_TAGLINE=
PROJECT_TAGLINE_EN=
PROJECT_TAGLINE_ES=
SOURCE_CODE_URL=https://github.com/mycelibre/utilibre
# Optional donation destination. All donation UI and routes stay hidden when empty.
SUPPORT_URL=
CONTACT_URL=https://github.com/mycelibre/utilibre/issues

PRIVATE_BIND_IP=REPLACE_WITH_PRIVATE_BIND_IP
EDGE_PROXY_IP=REPLACE_WITH_EDGE_PROXY_IP

PORTAL_PORT=8080
SEARXNG_PORT=8888
REDLIB_PORT=3002
FRESHRSS_PORT=3106
PRIVATEBIN_PORT=3108

PUBLIC_PORTAL_HOST=REPLACE_WITH_PUBLIC_PORTAL_HOST
PUBLIC_SEARCH_HOST=REPLACE_WITH_PUBLIC_SEARCH_HOST
PUBLIC_REDDIT_HOST=REPLACE_WITH_PUBLIC_REDDIT_HOST
PUBLIC_RSS_HOST=REPLACE_WITH_PUBLIC_RSS_HOST
PUBLIC_PASTE_HOST=REPLACE_WITH_PUBLIC_PASTE_HOST

PUBLIC_PORTAL_ORIGIN=https://REPLACE_WITH_PUBLIC_PORTAL_HOST
PUBLIC_SEARCH_URL=https://REPLACE_WITH_PUBLIC_SEARCH_HOST/
PUBLIC_REDDIT_URL=https://REPLACE_WITH_PUBLIC_REDDIT_HOST/
PUBLIC_RSS_URL=https://REPLACE_WITH_PUBLIC_RSS_HOST/
PUBLIC_PASTE_URL=https://REPLACE_WITH_PUBLIC_PASTE_HOST/
ANUBIS_PUBLIC_HOST=REPLACE_WITH_PUBLIC_REDDIT_HOST

# Redlib also requires COMPOSE_PROFILES=privacy-frontends. FreshRSS and
# PrivateBin run in deployment/utilibre; RSSHub remains internal to FreshRSS.
ENABLED_SERVICES=searxng,redlib,freshrss,privatebin
DEFAULT_LANGUAGE=en

# Generate with: openssl rand -hex 32
SEARXNG_SECRET=REPLACE_WITH_RANDOM_SECRET
STATUS_CACHE_SECONDS=15

# Conservative starting limits; adjust only after measuring.
PORTAL_CPU_LIMIT=0.50
PORTAL_MEMORY_LIMIT=256M
SEARXNG_CPU_LIMIT=1.00
SEARXNG_MEMORY_LIMIT=768M
VALKEY_CPU_LIMIT=0.25
VALKEY_MEMORY_LIMIT=128M
VALKEY_MAXMEMORY=96mb
VALKEY_DATA_TMPFS_SIZE=128m
REDLIB_CPU_LIMIT=0.50
REDLIB_MEMORY_LIMIT=256M
REDLIB_MEMORY_RESERVATION=32M
REDLIB_PIDS_LIMIT=128
REDLIB_TMPFS_SIZE=32m
REDLIB_SFW_ONLY=off
REDLIB_BANNER=

# Anubis protects only Redlib. Cloudflare overwrites CF-Connecting-IP on the
# proxied public hostname; the edge must remain inaccessible except through
# trusted Cloudflare networks.
ANUBIS_REAL_IP_HEADER=CF-Connecting-IP
ANUBIS_COOKIE_EXPIRATION=24h
ANUBIS_COOKIE_SECURE=true
ANUBIS_COOKIE_PARTITIONED=true
ANUBIS_CPU_LIMIT=0.25
ANUBIS_MEMORY_LIMIT=128M
ANUBIS_MEMORY_RESERVATION=32M
ANUBIS_PIDS_LIMIT=128

DOCKER_LOG_MAX_SIZE=10m
DOCKER_LOG_MAX_FILES=3
