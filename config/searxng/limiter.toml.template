[botdetection]
ipv4_prefix = 32
ipv6_prefix = 48
trusted_proxies = [
  '127.0.0.0/8',
  '::1',
  '__EDGE_PROXY_IP__',
]

[botdetection.ip_limit]
filter_link_local = false
link_token = true

[botdetection.ip_lists]
block_ip = []
pass_ip = []
# Permit the official check.searx.space monitors through the application
# limiter. Client addresses must still come from the exact trusted edge.
pass_searxng_org = true
