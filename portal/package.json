{
  "name": "public-utility-portal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "predev": "node scripts/copy-vendor.mjs",
    "dev": "vite --host 0.0.0.0",
    "prebuild": "npm run test:foss-policy && node scripts/copy-vendor.mjs",
    "build": "vite build",
    "start": "node server/server.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build",
    "test": "npm run test:searx-pagination && npm run test:searx-redaction && vitest run",
    "test:searx-pagination": "python3 ../scripts/test-searx-pagination-config.py",
    "test:searx-redaction": "python3 ../scripts/test-searx-redaction.py",
    "test:foss-policy": "node scripts/check-foss-policy.ts",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@fontsource-variable/atkinson-hyperlegible-next": "5.3.0",
    "@fontsource-variable/newsreader": "5.3.0",
    "@playwright/test": "1.62.1",
    "@types/node": "26.4.0",
    "eslint": "10.9.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
